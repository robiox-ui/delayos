# proton-delayos: DelayOS's Proton (Steam Play compatibility tool).
# Sources: Proton-CachyOS (https://github.com/CachyOS/proton-cachyos = Valve Proton + CachyOS/GE
# patches), built by packages/proton-delayos/build-proton.sh in Valve's Proton SDK container.
# makepkg only packages the result:
#
#   tools/repo-build.sh proton                  build from source (hours), then package
#   tools/repo-build.sh proton --proton-repack  package CachyOS's released Steam-Linux-Runtime build
#                                               under our name (minutes; NOT our own build: stopgap
#                                               until the source build has run)
#
#   DELAYOS_PROTON_TARBALL=/path/proton-delayos-<ver>.tar   result of build-proton.sh
#   DELAYOS_PROTON_REPACK=1                                 download and repackage the CachyOS build
#
# delay-steam-compat prefers this tool (internal name "proton-delayos") when it is installed.
pkgname=proton-delayos
_srctag=11.0-20261015
pkgver=${_srctag//-/.}
pkgrel=1
pkgdesc='DelayOS Proton: Steam Play compatibility tool (Proton-CachyOS sources, Steam Linux Runtime build)'
url='https://github.com/robiox-ui/delayos'
arch=('x86_64')
options=('!strip' '!debug' 'emptydirs')
license=('BSD-3-Clause' 'LGPL-2.1-or-later' 'Zlib' 'MIT' 'MPL-2.0' 'LicenseRef-custom')
depends=('bash' 'coreutils' 'curl' 'dbus' 'desktop-file-utils' 'diffutils' 'freetype2' 'gdk-pixbuf2' 'glibc'
         'hicolor-icon-theme' 'libxcrypt' 'libxcrypt-compat' 'libxkbcommon-x11' 'lsof' 'nss' 'python'
         'rtkit' 'ttf-font' 'usbutils' 'vulkan-driver' 'vulkan-icd-loader' 'xdg-user-dirs' 'xz'
         'lib32-glibc' 'lib32-gcc-libs' 'lib32-fontconfig' 'lib32-libgl' 'lib32-libx11'
         'lib32-libxcrypt' 'lib32-libxcrypt-compat' 'lib32-nss' 'lib32-pipewire' 'lib32-systemd'
         'lib32-vulkan-driver' 'lib32-vulkan-icd-loader')
makedepends=('rsync')
optdepends=('steam: the Steam client' 'umu-launcher: run Proton outside Steam' 'NTSYNC-MODULE: ntsync (linux-delayos has it)')
provides=('proton')
backup=("usr/share/steam/compatibilitytools.d/$pkgname/user_settings.py")
_cachy="proton-cachyos-${_srctag}-slr-x86_64"
if [[ ${DELAYOS_PROTON_REPACK:-0} == 1 ]]; then
    pkgdesc='DelayOS Proton: Steam Play compatibility tool (repackaged Proton-CachyOS release, Steam Linux Runtime build)'
    source=("https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-${_srctag}-slr/${_cachy}.tar.xz")
    # the same file and checksum CachyOS's own proton-cachyos-slr package pins
    b2sums=('11f639f5b48f06e8664f3bfe8f766cc166a66f2f9f612b62b52f7a0b88e58fe08a2acf34d7615916c39077da5c328381feff67bed1193b1ddb7b4979c6340f05')
fi

prepare() {
    cd "$srcdir"
    if [[ ${DELAYOS_PROTON_REPACK:-0} == 1 ]]; then
        rm -rf "$pkgname"; mv "$_cachy" "$pkgname"
    else
        [[ -r ${DELAYOS_PROTON_TARBALL:-} ]] || { error "Set DELAYOS_PROTON_TARBALL (build-proton.sh) or DELAYOS_PROTON_REPACK=1"; return 1; }
        rm -rf "$pkgname"; bsdtar -xf "$DELAYOS_PROTON_TARBALL"
    fi
    [[ -f $pkgname/proton && -f $pkgname/version ]] || { error "This is not a Proton redist tree"; return 1; }
}

build() {
    cd "$srcdir/$pkgname"
    local how='DelayOS build'
    [[ ${DELAYOS_PROTON_REPACK:-0} == 1 ]] && how='CachyOS build'
    # Steam lists the tool by display_name; delay-steam-compat selects it by the internal name
    cat > compatibilitytool.vdf <<VDF
"compatibilitytools"
{
  "compat_tools"
  {
    "$pkgname"
    {
      "install_path" "."
      "display_name" "Proton DelayOS ${_srctag} ($how)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
VDF
}

package() {
    local d="$pkgdir/usr/share/steam/compatibilitytools.d/$pkgname"
    install -d "$d"
    rsync -a --delete "$srcdir/$pkgname/" "$d/"
    local f
    for f in LICENSE LICENSE.OFL PATENTS.AV1; do
        [[ -f $d/$f ]] && install -Dm644 "$d/$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
    done
}
