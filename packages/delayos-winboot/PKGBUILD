# DelayOS content package: the files are listed in files.list and come from profile/airootfs
# (tools/content-pkgs.sh). Build: tools/repo-build.sh content   (docs/packaging.md)
pkgname=delayos-winboot
pkgdesc='DelayOS Windows 전환: dual-boot switch and the hidden Windows for anti-cheat games'
. "${DELAYOS_REPO_ROOT:-$(realpath "${startdir:-$PWD}/../..")}/packages/delayos-common.sh"
depends=('delayos-shell' 'python' 'pyside6' 'efibootmgr' 'polkit')
optdepends=('wimlib: prepare the hidden Windows' 'ntfs-3g: write the Windows partitions'
            'delayos-sb-general: boot DelayOS with Secure Boot on' 'mokutil: enroll the DelayOS general CA')
backup=($(delayos_backup))

package() {
    delayos_package
}
