@echo off
rem DelayOS hidden Windows: WinPE part. Generated by delay-winsetup (code page 949, CRLF).
rem   %1 = drive letter of the DelayOS staging partition
rem Applies the Windows image to the ONE volume that carries the DelayOS marker file with this
rem installation's random id, and writes the Windows boot files to the EFI system partition that
rem carries the same id. No other disk or partition is formatted or written.
setlocal enableextensions
chcp 949 >nul
set STG=%~1
set NONCE=@NONCE@
set INDEX=@INDEX@
set WIMFILE=@WIMFILE@
set LOG=%STG%:\delayos\winpe.log
set ESP=
set TGT=
rem ---- messages: Korean, or English when this Windows PE has no Korean font (a custom medium;
rem      Korean text would show as empty boxes). @KOFONT@ is set by delay-winsetup from the boot image.
set KO=@KOFONT@
if not defined KO goto msg_en
set M1=DelayOS - Windows 게임 지원을 준비하고 있습니다
set M2=약 20~40분이 걸립니다. 컴퓨터를 끄지 마세요.
set M3=끝나면 자동으로 다시 시작되어 DelayOS로 돌아갑니다.
set M4=[1/3] Windows 파티션을 준비하는 중...
set M5=[2/3] Windows를 설치하는 중... (가장 오래 걸립니다)
set M6=[3/3] 마무리하는 중...
set M7=완료했습니다. 다시 시작합니다...
set M8=Windows 게임 지원을 준비하지 못했습니다
set M9=DelayOS는 그대로입니다. 다시 시작하면 DelayOS가 켜지고, 거기에서 다시 시도하거나 제거할 수 있습니다.
goto msg_done
:msg_en
set M1=DelayOS - preparing Windows game support
set M2=This takes about 20 to 40 minutes. Do not turn the computer off.
set M3=When it is done the computer restarts by itself and returns to DelayOS.
set M4=[1/3] Preparing the Windows partition...
set M5=[2/3] Installing Windows... (this is the longest step)
set M6=[3/3] Finishing...
set M7=Done. Restarting...
set M8=Windows game support could not be prepared
set M9=DelayOS is unchanged. After the restart DelayOS starts; retry or remove it from there.
:msg_done
title DelayOS
color 07
cls
echo.
echo   %M1%
echo   ------------------------------------------------------------
echo   %M2%
echo   %M3%
echo.
echo [%date% %time%] WinPE start, staging %STG%: > %LOG%
call :checktag %STG%:\delayos\staging.tag
if errorlevel 1 (set ERR=E01 staging-id& goto fail)

rem ---- EFI system partition (must carry our id)
mountvol S: /S >nul 2>&1
call :checktag S:\EFI\DelayOS\winsetup\esp.tag
if not errorlevel 1 set ESP=S
if not defined ESP mountvol S: /D >nul 2>&1
if not defined ESP call :scan_esp
if not defined ESP (set ERR=E02 esp-not-found& goto fail)
echo [%time%] ESP found >> %LOG%
if exist S:\EFI\DelayOS\winsetup\pe-pending del /f /q S:\EFI\DelayOS\winsetup\pe-pending

rem ---- Windows partition (must carry our id)
for %%d in (C D E F G H I J K L M N O P Q R T U V W Y Z) do if not defined TGT call :trytgt %%d
if not defined TGT (set ERR=E03 target-not-found& goto fail)
if /i "%TGT%"=="%STG%" (set ERR=E03 target-is-staging& goto fail)
echo [%time%] target %TGT%: >> %LOG%

echo   %M4%
format %TGT%: /FS:NTFS /Q /Y /V:DelayOS-Win >> %LOG% 2>&1
if errorlevel 1 (set ERR=E04 format& goto fail)

echo   %M5%
dism /Apply-Image /ImageFile:%STG%:\sources\%WIMFILE% @SWM@ /Index:%INDEX% /ApplyDir:%TGT%:\
if errorlevel 1 (set ERR=E05 dism-apply& goto fail)
echo [%time%] image applied >> %LOG%

echo   %M6%
if not exist %TGT%:\Windows\System32\config\SYSTEM (set ERR=E05 not-a-windows-image& goto fail)
rem ---- A custom image can carry its own answer files, and Windows reads some of them BEFORE
rem      \Windows\Panther\unattend.xml (search order: registry, Panther\Unattend, Panther, ...,
rem      System32\Sysprep, root of the drive). The DelayOS answer file must be the one that is used
rem      (account, auto-logon, helper): the others are kept next to the original as *.iso-bak.
for %%f in (Windows\Panther\Unattend\Unattend.xml Windows\Panther\Unattend\Autounattend.xml Windows\Panther\Unattend.xml Windows\Panther\Autounattend.xml Windows\System32\Sysprep\Unattend.xml Windows\System32\Sysprep\Panther\Unattend.xml Unattend.xml Autounattend.xml) do call :setaside %%f
if exist X:\Windows\System32\reg.exe call :regunattend
if not exist %TGT%:\Windows\Panther mkdir %TGT%:\Windows\Panther
copy /y %STG%:\delayos\unattend.xml %TGT%:\Windows\Panther\unattend.xml >nul
if errorlevel 1 (set ERR=E06 unattend& goto fail)
xcopy %STG%:\delayos\payload %TGT%:\ProgramData\DelayOS\winsetup\ /E /I /Y /Q >nul
if errorlevel 1 (set ERR=E06 payload& goto fail)
bcdboot %TGT%:\Windows /s S: /f UEFI /l ko-KR >> %LOG% 2>&1
if errorlevel 1 (
  echo [%time%] bcdboot with ko-KR failed, trying the image's own language >> %LOG%
  bcdboot %TGT%:\Windows /s S: /f UEFI >> %LOG% 2>&1
)
if errorlevel 1 (set ERR=E07 bcdboot& goto fail)
bcdedit /store S:\EFI\Microsoft\Boot\BCD /set {bootmgr} timeout 0 >nul 2>&1
echo [%time%] OK >> %LOG%
echo ok > S:\EFI\DelayOS\winsetup\pe-done
copy /y %LOG% S:\EFI\DelayOS\winsetup\winpe.log >nul
echo.
echo   %M7%
ping -n 4 127.0.0.1 >nul
exit /b 0

:fail
echo [%time%] FAIL %ERR% >> %LOG%
if defined ESP copy /y %LOG% S:\EFI\DelayOS\winsetup\winpe.log >nul
if defined ESP echo %ERR% > S:\EFI\DelayOS\winsetup\failed
echo.
echo   %M8% (%ERR%).
echo   %M9%
ping -n 20 127.0.0.1 >nul
exit /b 1

rem ---- fallback: give each partition the letter S for a moment and look for our id
:scan_esp
for /l %%D in (0,1,7) do for /l %%P in (1,1,16) do if not defined ESP call :try_part %%D %%P
exit /b 0

:try_part
(echo select disk %1& echo select partition %2& echo assign letter=S) > X:\dp.txt
diskpart /s X:\dp.txt >nul 2>&1
if errorlevel 1 exit /b 0
call :checktag S:\EFI\DelayOS\winsetup\esp.tag
if not errorlevel 1 set ESP=S
if defined ESP exit /b 0
(echo select disk %1& echo select partition %2& echo remove letter=S) > X:\dp.txt
diskpart /s X:\dp.txt >nul 2>&1
exit /b 0

rem ---- %1 = marker file: errorlevel 0 only if its first line is this installation's id
rem      (plain cmd on purpose: findstr does not exist in the Windows Setup boot image)
:checktag
set TAGVAL=
if not exist %1 exit /b 1
set /p TAGVAL=<%1
if "%TAGVAL%"=="%NONCE%" exit /b 0
exit /b 1

:trytgt
call :checktag %1:\DelayOS-WinTarget.tag
if not errorlevel 1 set TGT=%1
exit /b 0

rem ---- %1 = answer file of the image (path below the Windows drive): keep it as *.iso-bak
:setaside
if not exist %TGT%:\%1 exit /b 0
echo [%time%] answer file of the image set aside: %1 >> %LOG%
move /y %TGT%:\%1 %TGT%:\%1.iso-bak >nul 2>&1
exit /b 0

rem ---- an image can also name an answer file in its registry (first place Windows looks): remove
:regunattend
reg load HKLM\DELAYOSSYS %TGT%:\Windows\System32\config\SYSTEM >nul 2>&1
if errorlevel 1 exit /b 0
reg query HKLM\DELAYOSSYS\Setup /v UnattendFile >nul 2>&1
if errorlevel 1 goto regdone
echo [%time%] the image names an answer file in its registry (Setup\UnattendFile): removed >> %LOG%
reg delete HKLM\DELAYOSSYS\Setup /v UnattendFile /f >nul 2>&1
:regdone
reg unload HKLM\DELAYOSSYS >nul 2>&1
exit /b 0
