@echo off
rem DelayOS hidden Windows: WinPE part. Generated by delay-winsetup (code page 949, CRLF).
rem   %1 = drive letter of the DelayOS staging partition
rem Applies the Windows image to the ONE volume that carries the DelayOS marker file with this
rem installation's random id, and writes the Windows boot files to the EFI system partition that
rem carries the same id. No other disk or partition is formatted or written.
setlocal enableextensions
chcp 949 >nul
set STG=%~1
set NONCE=@NONCE@
set INDEX=@INDEX@
set WIMFILE=@WIMFILE@
set LOG=%STG%:\delayos\winpe.log
set ESP=
set TGT=
title DelayOS
color 07
cls
echo.
echo   DelayOS - Windows 게임 지원을 준비하고 있습니다
echo   ------------------------------------------------------------
echo   약 20~40분이 걸립니다. 컴퓨터를 끄지 마세요.
echo   끝나면 자동으로 다시 시작되어 DelayOS로 돌아갑니다.
echo.
echo [%date% %time%] WinPE start, staging %STG%: > %LOG%
findstr /c:"%NONCE%" %STG%:\delayos\staging.tag >nul 2>&1
if errorlevel 1 (set ERR=E01 staging-id& goto fail)

rem ---- EFI system partition (must carry our id)
mountvol S: /S >nul 2>&1
if exist S:\EFI\DelayOS\winsetup\esp.tag findstr /c:"%NONCE%" S:\EFI\DelayOS\winsetup\esp.tag >nul 2>&1 && set ESP=S
if not defined ESP mountvol S: /D >nul 2>&1
if not defined ESP call :scan_esp
if not defined ESP (set ERR=E02 esp-not-found& goto fail)
echo [%time%] ESP found >> %LOG%
if exist S:\EFI\DelayOS\winsetup\pe-pending del /f /q S:\EFI\DelayOS\winsetup\pe-pending

rem ---- Windows partition (must carry our id)
for %%d in (C D E F G H I J K L M N O P Q R T U V W Y Z) do if not defined TGT if exist %%d:\DelayOS-WinTarget.tag findstr /c:"%NONCE%" %%d:\DelayOS-WinTarget.tag >nul 2>&1 && set TGT=%%d
if not defined TGT (set ERR=E03 target-not-found& goto fail)
if /i "%TGT%"=="%STG%" (set ERR=E03 target-is-staging& goto fail)
echo [%time%] target %TGT%: >> %LOG%

echo   [1/3] Windows 파티션을 준비하는 중...
format %TGT%: /FS:NTFS /Q /Y /V:DelayOS-Win >> %LOG% 2>&1
if errorlevel 1 (set ERR=E04 format& goto fail)

echo   [2/3] Windows를 설치하는 중... (가장 오래 걸립니다)
dism /Apply-Image /ImageFile:%STG%:\sources\%WIMFILE% @SWM@ /Index:%INDEX% /ApplyDir:%TGT%:\
if errorlevel 1 (set ERR=E05 dism-apply& goto fail)
echo [%time%] image applied >> %LOG%

echo   [3/3] 마무리하는 중...
if not exist %TGT%:\Windows\Panther mkdir %TGT%:\Windows\Panther
copy /y %STG%:\delayos\unattend.xml %TGT%:\Windows\Panther\unattend.xml >nul
if errorlevel 1 (set ERR=E06 unattend& goto fail)
xcopy %STG%:\delayos\payload %TGT%:\ProgramData\DelayOS\winsetup\ /E /I /Y /Q >nul
if errorlevel 1 (set ERR=E06 payload& goto fail)
bcdboot %TGT%:\Windows /s S: /f UEFI /l ko-KR /addlast >> %LOG% 2>&1
if errorlevel 1 (set ERR=E07 bcdboot& goto fail)
bcdedit /store S:\EFI\Microsoft\Boot\BCD /set {bootmgr} timeout 0 >nul 2>&1
echo [%time%] OK >> %LOG%
echo ok > S:\EFI\DelayOS\winsetup\pe-done
copy /y %LOG% S:\EFI\DelayOS\winsetup\winpe.log >nul
echo.
echo   완료했습니다. 다시 시작합니다...
ping -n 4 127.0.0.1 >nul
exit /b 0

:fail
echo [%time%] FAIL %ERR% >> %LOG%
if defined ESP copy /y %LOG% S:\EFI\DelayOS\winsetup\winpe.log >nul
if defined ESP echo %ERR% > S:\EFI\DelayOS\winsetup\failed
echo.
echo   Windows 게임 지원을 준비하지 못했습니다 (%ERR%).
echo   DelayOS는 그대로입니다. 다시 시작하면 DelayOS가 켜지고, 거기에서 다시 시도하거나 제거할 수 있습니다.
ping -n 20 127.0.0.1 >nul
exit /b 1

rem ---- fallback: give each partition the letter S for a moment and look for our id
:scan_esp
for /l %%D in (0,1,7) do for /l %%P in (1,1,16) do if not defined ESP call :try_part %%D %%P
exit /b 0

:try_part
(echo select disk %1& echo select partition %2& echo assign letter=S) > X:\dp.txt
diskpart /s X:\dp.txt >nul 2>&1
if errorlevel 1 exit /b 0
if exist S:\EFI\DelayOS\winsetup\esp.tag findstr /c:"%NONCE%" S:\EFI\DelayOS\winsetup\esp.tag >nul 2>&1 && set ESP=S
if defined ESP exit /b 0
(echo select disk %1& echo select partition %2& echo remove letter=S) > X:\dp.txt
diskpart /s X:\dp.txt >nul 2>&1
exit /b 0
