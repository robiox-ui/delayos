[Icon Theme]
Name=DelayOS
Comment=DelayOS 아이콘 테마
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=delayos-files
DisplayDepth=32
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

Directories=scalable/apps,scalable/places,scalable/mimetypes,scalable/devices,scalable/categories,symbolic/actions,symbolic/status,symbolic/devices,symbolic/places,symbolic/apps

