[Icon Theme]
Name=TemuOS
Comment=TEMUOS 아이콘 테마
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=temuos-files
DisplayDepth=32
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

Directories=scalable/apps,scalable/places,scalable/categories,symbolic/actions,symbolic/status

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[scalable/categories]
Size=28
MinSize=8
MaxSize=512
Context=Categories
Type=Scalable

[symbolic/actions]
Size=24
MinSize=8
MaxSize=512
Context=Actions
Type=Scalable

[symbolic/status]
Size=24
MinSize=8
MaxSize=512
Context=Status
Type=Scalable
