<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DelayOS</vendor>
  <action id="org.delayos.syshelper">
    <description>Install, remove and update software</description>
    <description xml:lang="ko">소프트웨어 설치, 제거 및 업데이트</description>
    <message>Authentication is required to change the installed software</message>
    <message xml:lang="ko">설치된 소프트웨어를 변경하려면 인증이 필요합니다</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/delayos/delay-sys-helper</annotate>
  </action>
</policyconfig>
