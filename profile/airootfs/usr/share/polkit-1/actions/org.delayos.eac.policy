<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- DelayOS: pkexec /usr/local/bin/delay-eac setup|boot (anti-cheat mode, EAC Linux v2) -->
<policyconfig>
  <vendor>DelayOS</vendor>
  <action id="org.delayos.eac">
    <description>Set up the anti-cheat mode (Easy Anti-Cheat Linux v2)</description>
    <description xml:lang="ko">안티치트 모드(Easy Anti-Cheat Linux v2) 설정</description>
    <message>Authentication is required to change the boot setup for the anti-cheat mode</message>
    <message xml:lang="ko">안티치트 모드를 위해 부팅 설정을 바꾸려면 인증이 필요합니다</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/delay-eac</annotate>
  </action>
</policyconfig>
