<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DelayOS</vendor>
  <action id="org.delayos.recovery.info">
    <description>Read the state of system snapshots and the recovery partition</description>
    <description xml:lang="ko">시스템 스냅샷과 복구 파티션 상태 읽기</description>
    <message>Authentication is required to read the recovery state</message>
    <message xml:lang="ko">복구 상태를 읽으려면 인증이 필요합니다</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/delayos/delay-recovery-info</annotate>
  </action>
</policyconfig>
