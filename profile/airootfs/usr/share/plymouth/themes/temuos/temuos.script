# TEMUOS Plymouth theme (ui-spec §1)
# #0B0B10 + crimson glow, logo 132 px (at 1080p) centred at y = 45 %, 3-dot accent pulse below.
# LUKS: password field 280x40 with bullets; Korean prompt is a pre-rendered image.

Window.SetBackgroundTopColor(0.043, 0.043, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.063);

W = Window.GetWidth();
H = Window.GetHeight();
s = H / 1080;
if (s < 0.5) s = 0.5;

bg_image = Image("background.png");
bg = Sprite(bg_image.Scale(W, H));
bg.SetZ(-100);

ls = Math.Int(132 * s);
logo_image = Image("logo.png").Scale(ls, ls);
logo = Sprite(logo_image);
logo.SetX(Math.Int(W / 2 - ls / 2));
logo.SetY(Math.Int(H * 0.45 - ls / 2));

# 3-dot pulse
ds = Math.Int(10 * s); if (ds < 6) ds = 6;
gap = Math.Int(18 * s);
dot_image = Image("dot.png").Scale(ds, ds);
dots_y = Math.Int(H * 0.45 + ls / 2 + 56 * s);
for (i = 0; i < 3; i++) {
    dot[i] = Sprite(dot_image);
    dot[i].SetX(Math.Int(W / 2 - ds / 2 + (i - 1) * gap));
    dot[i].SetY(dots_y);
    dot[i].SetOpacity(0.3);
}

t = 0;
fun refresh_cb() {
    global.t = global.t + 1;
    for (i = 0; i < 3; i++) {
        p = Math.Sin((global.t / 50 * 3.14159 * 1.6) - i * 0.9);
        if (p < 0) p = 0;
        dot[i].SetOpacity(0.25 + 0.75 * p);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

# ---- password (LUKS) ---------------------------------------------------------------
fw = Math.Int(280 * s); fh = Math.Int(40 * s);
field_image = Image("field.png").Scale(fw, fh);
field = Sprite(field_image);
field.SetX(Math.Int(W / 2 - fw / 2));
field.SetY(dots_y - Math.Int(8 * s));
field.SetZ(10);
field.SetOpacity(0);

lk = Math.Int(18 * s);
lock = Sprite(Image("lock.png").Scale(lk, lk));
lock.SetX(Math.Int(W / 2 - fw / 2 + 12 * s));
lock.SetY(Math.Int(field.GetY() + fh / 2 - lk / 2));
lock.SetZ(11);
lock.SetOpacity(0);

pr_image = Image("prompt.png");
pw = Math.Int(pr_image.GetWidth() * s / 2); ph = Math.Int(pr_image.GetHeight() * s / 2);
prompt = Sprite(pr_image.Scale(pw, ph));
prompt.SetX(Math.Int(W / 2 - pw / 2));
prompt.SetY(Math.Int(field.GetY() - ph - 10 * s));
prompt.SetOpacity(0);

bs = Math.Int(8 * s); if (bs < 5) bs = 5;
bullet_image = Image("bullet.png").Scale(bs, bs);

fun idle_cb() {}

fun display_password_cb(prompt_text, n) {
    for (i = 0; i < 3; i++) dot[i].SetOpacity(0);
    Plymouth.SetRefreshFunction(idle_cb);
    field.SetOpacity(1); lock.SetOpacity(1); prompt.SetOpacity(1);
    for (i = 0; global.bullet[i]; i++) global.bullet[i].SetOpacity(0);
    maxb = Math.Int((fw - 52 * s) / (bs + 5 * s));
    if (n > maxb) n = maxb;
    for (i = 0; i < n; i++) {
        if (!global.bullet[i]) global.bullet[i] = Sprite(bullet_image);
        global.bullet[i].SetX(Math.Int(W / 2 - fw / 2 + 40 * s + i * (bs + 5 * s)));
        global.bullet[i].SetY(Math.Int(field.GetY() + fh / 2 - bs / 2));
        global.bullet[i].SetZ(12);
        global.bullet[i].SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    field.SetOpacity(0); lock.SetOpacity(0); prompt.SetOpacity(0);
    for (i = 0; global.bullet[i]; i++) global.bullet[i].SetOpacity(0);
    Plymouth.SetRefreshFunction(refresh_cb);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

# no boot messages / progress text on screen
fun message_cb(text) {}
Plymouth.SetMessageFunction(message_cb);

fun quit_cb() {
    logo.SetOpacity(0);
    for (i = 0; i < 3; i++) dot[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_cb);