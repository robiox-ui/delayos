[Desktop Entry]
Type=Application
Name=Open with TEMUOS_LINUX app engines
Name[ko]=TEMUOS_LINUX 앱 엔진으로 열기
Comment=Run Windows, Android, Debian, Fedora and Mac apps
Exec=/usr/local/bin/temu-open %f
Icon=temuos-logo
NoDisplay=true
Terminal=false
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/x-ms-shortcut;application/x-bat;application/vnd.android.package-archive;application/vnd.debian.binary-package;application/x-rpm;application/x-apple-diskimage;application/x-appimage;application/vnd.appimage;
