[Desktop Entry]
Type=Application
Name=작업 관리자
GenericName=시스템 모니터
Comment=실행 중인 앱과 프로세스, 성능, 시작 앱을 관리해요
Exec=delay-taskmanager
Icon=delayos-taskmanager
Terminal=false
Categories=System;Monitor;
Keywords=task manager;process;monitor;작업;관리자;프로세스;성능;
StartupWMClass=org.delayos.TaskManager
StartupNotify=true
X-KDE-Shortcuts=Ctrl+Shift+Esc
