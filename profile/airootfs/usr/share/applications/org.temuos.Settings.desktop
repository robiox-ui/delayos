[Desktop Entry]
Type=Application
Name=Settings
Name[ko]=설정
GenericName=System Settings
GenericName[ko]=시스템 설정
Comment=Change your display, network, look, apps and more
Comment[ko]=디스플레이, 네트워크, 모양, 앱 등을 변경합니다
Icon=temuos-settings
Exec=temu-settings %u
Terminal=false
StartupNotify=true
StartupWMClass=org.temuos.Settings
Categories=Settings;System;Qt;
Keywords=settings;preferences;control;display;wifi;bluetooth;wallpaper;theme;설정;제어판;
Keywords[ko]=설정;제어판;디스플레이;와이파이;블루투스;배경;테마;
MimeType=x-scheme-handler/temu-settings;
Actions=Personalisation;Display;Network;Update;

[Desktop Action Personalisation]
Name=Personalise
Name[ko]=개인 설정
Exec=temu-settings personalisation

[Desktop Action Display]
Name=Display
Name[ko]=디스플레이
Exec=temu-settings display

[Desktop Action Network]
Name=Network
Name[ko]=네트워크 및 인터넷
Exec=temu-settings network

[Desktop Action Update]
Name=Update & drivers
Name[ko]=업데이트 및 드라이버
Exec=temu-settings update
