[Desktop Entry]
Type=Application
Name=DelayOS Store
Name[ko]=DelayOS Store
GenericName=App Store
GenericName[ko]=앱 스토어
Comment=Find, install and update apps from Flathub and the official repositories
Comment[ko]=Flathub와 공식 저장소의 앱을 찾아 설치하고 업데이트합니다
Icon=delayos-store
Exec=delay-store %U
Terminal=false
StartupNotify=true
StartupWMClass=org.delayos.Store
Categories=System;PackageManager;Qt;
Keywords=store;apps;install;flathub;software;스토어;앱;설치;
MimeType=x-scheme-handler/appstream;
Actions=Installed;

[Desktop Action Installed]
Name=Installed apps
Name[ko]=설치된 앱
Exec=delay-store --installed
