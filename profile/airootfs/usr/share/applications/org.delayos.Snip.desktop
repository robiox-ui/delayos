[Desktop Entry]
Type=Application
Name=캡처 도구
GenericName=화면 캡처
Comment=화면의 일부나 창, 전체 화면을 캡처하고 표시해요
Exec=delay-snip --app
Icon=delayos-snip
Terminal=false
Categories=Utility;Graphics;
Keywords=snip;screenshot;capture;캡처;스크린샷;화면;
StartupWMClass=org.delayos.Snip
StartupNotify=false
Actions=NewSnip;FullScreen;

[Desktop Action NewSnip]
Name=새 캡처
Exec=delay-snip
X-KDE-Shortcuts=Meta+Shift+S,Print

[Desktop Action FullScreen]
Name=전체 화면 캡처
Exec=delay-snip --full
