#!/bin/bash
# delay-sys-helper: the only privileged entry point of the DelayOS system apps (Settings, Store, Drivers, Welcome).
# Run through pkexec (polkit action org.delayos.syshelper). Arguments are validated; nothing is passed to a shell.
#   install PKG...      pacman -S --needed (falls back to -Syu --needed when the sync DB is missing/stale);
#                       also installs the Korean language pack of PKG where it is a separate package
#   flatpak-lang        flatpak config (system): languages = ko;en, so installs pull the Korean locale
#   remove PKG...       pacman -Rns
#   upgrade             pacman -Syu
#   clean-cache         paccache -rk1 (or pacman -Sc)
#   android-init        waydroid init -s GAPPS -f + enable waydroid-container
#   enable-service UNIT systemctl enable --now (whitelisted units only)
#   cpu-opt enable|disable|kernel-install|kernel-remove   delay-cpu-opt (CPU-optimized packages)
#   gpu-setup           delay-gpu-setup (drivers that match the GPUs)
#   recovery SUB ...    snapshots (delay-snapshot) and restart into the recovery environment (delay-recovery-ctl)
set -u
export LC_ALL=C
cmd="${1:-}"; shift || true

valid_pkgs() {
  [[ $# -gt 0 ]] || { echo "no packages" >&2; exit 2; }
  for p in "$@"; do [[ "$p" =~ ^[a-z0-9@._+-]+$ ]] || { echo "invalid package: $p" >&2; exit 2; }; done
}

PACMAN=(pacman --noconfirm --noprogressbar --color never)
wait_lock() { for _ in $(seq 60); do [[ -e /var/lib/pacman/db.lck ]] || return 0; echo "waiting for another package manager"; sleep 2; done; }

# DelayOS is a Korean system: packages whose translations are split out get their Korean pack too
# (names checked against the official repositories; apps not listed ship Korean inside the package).
ko_packs() {
  local p
  for p in "$@"; do
    case "$p" in
      firefox|firefox-developer-edition|thunderbird) echo "$p-i18n-ko" ;;
      libreoffice-fresh|libreoffice-still) echo "$p-ko" ;;
    esac
  done
}

case "$cmd" in
  install)
    valid_pkgs "$@"; wait_lock
    mapfile -t ko < <(ko_packs "$@")
    if [[ -z "$(ls -A /var/lib/pacman/sync 2>/dev/null)" ]]; then
      "${PACMAN[@]}" -Syu --needed "$@"; rc=$?
    else
      "${PACMAN[@]}" -S --needed "$@"; rc=$?
      if [[ $rc -ne 0 ]]; then
        echo ":: retrying with a full sync"
        "${PACMAN[@]}" -Syu --needed "$@"; rc=$?
      fi
    fi
    if [[ $rc -eq 0 && ${#ko[@]} -gt 0 ]]; then
      "${PACMAN[@]}" -S --needed "${ko[@]}" || echo ":: Korean language pack not installed: ${ko[*]}"
    fi
    exit $rc
    ;;
  remove)
    valid_pkgs "$@"; wait_lock
    # the Korean pack depends on its app: remove it together or pacman refuses
    mapfile -t ko < <(ko_packs "$@" | while read -r k; do pacman -Qq "$k" 2>/dev/null; done)
    exec "${PACMAN[@]}" -Rns "$@" "${ko[@]}"
    ;;
  flatpak-lang)
    # Flatpak apps download only the locales listed here (Locale extensions): Korean + English
    command -v flatpak >/dev/null || exit 0
    flatpak config --system --set languages "ko;en" || exit $?
    exec flatpak config --system --set extra-languages "ko_KR.UTF-8"
    ;;
  upgrade)
    wait_lock
    exec "${PACMAN[@]}" -Syu
    ;;
  clean-cache)
    if command -v paccache >/dev/null; then exec paccache -rk1; else exec "${PACMAN[@]}" -Sc; fi
    ;;
  android-init)
    # download Android (LineageOS + Google Play) for Waydroid and start its container
    command -v waydroid >/dev/null || { echo "waydroid is not installed" >&2; exit 3; }
    waydroid init -s GAPPS -f || exit $?
    exec systemctl enable --now waydroid-container.service
    ;;
  cpu-opt)
    # CPU-optimized (CachyOS x86-64-v3/v4/znver4) repositories and the matching kernel
    case "${1:-}" in
      enable)         exec /usr/local/bin/delay-cpu-opt enable ;;
      disable)        exec /usr/local/bin/delay-cpu-opt disable ;;
      kernel-install) exec /usr/local/bin/delay-cpu-opt kernel install ;;
      kernel-remove)  exec /usr/local/bin/delay-cpu-opt kernel remove ;;
      *) echo "usage: delay-sys-helper cpu-opt enable|disable|kernel-install|kernel-remove" >&2; exit 2 ;;
    esac
    ;;
  gpu-setup)
    # make the installed graphics drivers match the GPUs in this PC
    exec /usr/local/bin/delay-gpu-setup
    ;;
  recovery)
    # 설정 > 시스템 > 복구 (docs/recovery.md): snapshots, restart into the recovery environment
    sub="${1:-}"; shift || true
    num() { [[ "${1:-}" =~ ^[0-9]{1,7}$ ]] || { echo "invalid snapshot number" >&2; exit 2; }; }
    case "$sub" in
      snapshot-create)
        desc="${1:-수동 스냅샷}"
        [[ ${#desc} -le 80 && "$desc" != *[[:cntrl:]]* ]] || { echo "invalid description" >&2; exit 2; }
        exec /usr/local/bin/delay-snapshot create -d "$desc" ;;
      snapshot-delete)   num "${1:-}"; exec /usr/local/bin/delay-snapshot delete "$1" ;;
      snapshot-rollback) num "${1:-}"; exec /usr/local/bin/delay-snapshot rollback "$1" ;;
      enable)
        # turn snapshots on for an installation that has them off, with the boot menu entries
        /usr/local/bin/delay-snapshot setup || exit $?
        mkinitcpio -P || true
        exec grub-mkconfig -o /boot/grub/grub.cfg ;;
      reboot)
        case "${1:-menu}" in
          menu|repair|rollback|reset-keep|reset-wipe) exec /usr/local/bin/delay-recovery-ctl reboot --action "${1:-menu}" ;;
          *) echo "invalid action" >&2; exit 2 ;;
        esac ;;
      firmware) exec /usr/local/bin/delay-recovery-ctl firmware ;;
      install-re)
        # make the recovery partition (when there is none) or refresh the environment on it
        if /usr/local/bin/delay-deploy recovery status >/dev/null 2>&1; then /usr/local/bin/delay-deploy recovery install || exit $?
        else /usr/local/bin/delay-deploy recovery create / || exit $?; fi
        systemctl enable --now delay-boot-ok.service delay-boot-ok.timer >/dev/null 2>&1
        exec grub-mkconfig -o /boot/grub/grub.cfg ;;
      *) echo "usage: delay-sys-helper recovery snapshot-create|snapshot-delete|snapshot-rollback|enable|reboot|firmware|install-re" >&2; exit 2 ;;
    esac
    ;;
  enable-service)
    case "${1:-}" in
      waydroid-container.service|bluetooth.service|docker.service|libvirtd.service) exec systemctl enable --now "$1" ;;
      *) echo "service not allowed" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "usage: delay-sys-helper install|remove|upgrade|clean-cache|flatpak-lang|enable-service|cpu-opt|gpu-setup|recovery ..." >&2; exit 2 ;;
esac
