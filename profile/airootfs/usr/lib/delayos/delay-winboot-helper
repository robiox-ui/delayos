CONF = "/etc/delayos/winboot.conf"
GRUB_CFG = "/boot/grub/grub.cfg"
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
WIN_FILES = ("install.ps1", "agent.ps1", "messages.ko.json")
WIN_CMD = "DelayOS-Windows-연동.cmd"
ICON_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,80}\.png$")

