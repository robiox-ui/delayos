#!/usr/bin/python3
# DelayOS "Windows 전환": privileged half of delay-winboot. Started through
#   pkexec /usr/lib/delayos/delay-winboot-helper <command>
# (polkit action org.delayos.winboot: no password for the active local user), so it accepts only
# fixed commands and validated ids, and never launches or reboots anything itself.
#
#   status [--no-refresh]      JSON: Windows found? method, blockers/warnings, Windows helper state.
#                              Also copies the Windows game inventory + icons from the ESP to
#                              /var/cache/delayos/winboot (world readable).
#   arm ID [--delay N]         write the launch request and select Windows for the NEXT boot only
#   arm --setup                copy the Windows helper installer and select Windows (no request)
#   arm --install ID [--delay N]   request: install the curated game ID in Windows (official installer)
#   arm --install-launcher LID     request: install a launcher (steam|epic|riot|battlenet|ea|ubisoft)
#   install-helper             copy the Windows helper installer to the ESP (and C:\ if safe)
#   disarm                     drop a pending request / one-time boot selection
#
# Where the request goes: UEFI -> <Windows ESP>/EFI/DelayOS/winboot/request.json (FAT, never kept
# open by a hibernated Windows). Legacy BIOS -> <Windows NTFS>/ProgramData/DelayOS/winboot/.
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/share/delayos/winboot")
import wbgames as wb  # noqa: E402

