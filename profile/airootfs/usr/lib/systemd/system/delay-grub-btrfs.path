[Unit]
Description=DelayOS: refresh the GRUB snapshot menu when a snapshot is created or removed
Documentation=file:///usr/lib/systemd/system/grub-btrfsd.service.d/10-delay-ondemand.conf
ConditionPathIsDirectory=/.snapshots
# the original daemon was asked for: leave the work to it
ConditionPathExists=!/etc/delayos/always-on/grub-btrfsd
# no After= on delay-snapshot-boot.service here: path units come before basic.target, that service after it
# (the refresh service itself is ordered after it)

[Path]
PathChanged=/.snapshots
Unit=delay-grub-btrfs.service
