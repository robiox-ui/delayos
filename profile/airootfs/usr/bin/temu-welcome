#!/usr/bin/python3
# TEMUOS 시작하기 (org.temuos.Welcome). `temu-welcome --autostart` exits at once when the wizard was finished or in the live session.
import os
import sys
sys.path[:0] = ["/usr/share/temuos/apps/syskit", "/usr/share/temuos/apps/store"]
if "--autostart" in sys.argv:
    from syskit import kread
    if kread("temuosrc", "Welcome", "Done", "false") == "true" or os.path.exists("/run/archiso"):
        sys.exit(0)
from syskit import run_app, single_instance
if single_instance("org.temuos.Welcome", []):
    sys.exit(0)


def ctx():
    from installer import Installer
    return {"installer": Installer()}


sys.exit(run_app("org.temuos.Welcome", "시작하기", "/usr/share/temuos/apps/welcome/qml/main.qml",
                 icon="temuos-welcome", extra_ctx=ctx))
