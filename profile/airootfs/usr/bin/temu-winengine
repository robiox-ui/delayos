#!/usr/bin/python3
# Windows Engine launcher UI (§10.1): temu-winengine FILE.exe | temu-winengine --mac FILE.dmg
# Default handler for .exe/.msi/.bat/.lnk/.dmg (org.temuos.WinEngine.desktop); the real work is /usr/local/bin/temu-open.
import os
import sys
sys.path[:0] = ["/usr/share/temuos/apps/syskit", "/usr/share/temuos/apps/winengine"]
args = [a for a in sys.argv[1:] if a]
mac = "--mac" in args
files = [a for a in args if not a.startswith("--")]
if not files:
    sys.stderr.write("usage: temu-winengine [--mac] FILE\n")
    sys.exit(2)
path = files[0]
if path.startswith("file://"):
    from urllib.parse import unquote
    path = unquote(path[7:])
if path.lower().endswith(".dmg"):
    mac = True
from syskit import run_app


def ctx():
    from engine import Engine
    return {"engine": Engine(path, mac)}


# QGuiApplication must not quit when the (hidden) dialog closes before the app maps
sys.exit(run_app("org.temuos.WinEngine", "Windows Engine", "/usr/share/temuos/apps/winengine/qml/main.qml",
                 icon="temuos-winengine", extra_ctx=ctx))
