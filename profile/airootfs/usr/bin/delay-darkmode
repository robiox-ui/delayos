#!/bin/bash
# DelayOS dark/light switch (Control Center "다크 모드" tile, docs/ui-spec.md §6.1, §12).
#   delay-darkmode on|off|toggle|status
# Applies the DelayDark / DelayLight colour scheme (Breeze fallback). Shell surfaces follow the
# colour scheme at once; the wallpaper switches to its day/night image through the Plasma
# wallpaper package's light/dark variants (contents/images + contents/images_dark).
set -u
cur=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)
is_dark() { case "$cur" in *Light*|*light*|BreezeClassic|"") return 1 ;; *) return 0 ;; esac; }
have() { [ -e "/usr/share/color-schemes/$1.colors" ] || [ -e "$HOME/.local/share/color-schemes/$1.colors" ]; }

case "${1:-toggle}" in
    status) is_dark && echo dark || echo light; exit 0 ;;
    on) want=dark ;;
    off) want=light ;;
    toggle) is_dark && want=light || want=dark ;;
    *) echo "usage: delay-darkmode on|off|toggle|status" >&2; exit 2 ;;
esac

if [ "$want" = dark ]; then
    scheme=DelayDark; have DelayDark || scheme=BreezeDark
else
    scheme=DelayLight; have DelayLight || scheme=BreezeLight
fi
exec plasma-apply-colorscheme "$scheme" >/dev/null
