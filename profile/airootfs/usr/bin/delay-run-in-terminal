#!/bin/bash
# Run a shell command in a terminal window and keep it open afterwards
# (Command bar ">cmd", docs/ui-spec.md §5).  Usage: delay-run-in-terminal "<command line>"
cmd="$*"
[ -n "$cmd" ] || exit 2
inner="$cmd; status=\$?; echo; echo \"[종료 코드 \$status] Enter 키를 누르면 창이 닫힙니다.\"; read -r _"
if command -v delay-terminal >/dev/null 2>&1; then
    exec delay-terminal -e bash -lc "$inner"
elif command -v konsole >/dev/null 2>&1; then
    exec konsole -e bash -lc "$inner"
elif command -v alacritty >/dev/null 2>&1; then
    exec alacritty -e bash -lc "$inner"
else
    exec xterm -e bash -lc "$inner"
fi
