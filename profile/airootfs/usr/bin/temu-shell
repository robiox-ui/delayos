#!/usr/bin/python3
"""TEMUOS shell popups remote control (stream shell-popups).

    temu-shell toggle|show|hide <popup>
    temu-shell query <start|commandbar> "<text>"   (open with a search text)
    temu-shell launch <files|settings|snip|...>     (start a TEMUOS app, KDE fallback)

popups: start commandbar controlcenter calendar clipboard emoji winx allapps
        ("hide all" closes every popup)

Briefly owns the session-bus name org.temuos.Shell and emits the signal
org.temuos.Shell.<Toggle|Show|Hide>(s popup) on /org/temuos/Shell. Every popup
plasmoid listens for it (TemuShell/ShellListener.qml, a Plasma SignalWatcher,
which only accepts signals from that well-known name).
"""
import sys

NAMES = ("start", "commandbar", "controlcenter", "calendar", "clipboard", "emoji",
         "winx", "allapps", "all")


# temu-shell launch <app>: first installed desktop id wins (TEMUOS app, then KDE fallback)
APPS = {
    "files": ["org.temuos.Files", "org.kde.dolphin"],
    "store": ["org.temuos.Store", "org.kde.discover"],
    "notepad": ["org.temuos.Notepad", "org.kde.kwrite", "org.kde.kate"],
    "calculator": ["org.temuos.Calculator", "org.kde.kcalc"],
    "settings": ["org.temuos.Settings", "systemsettings"],
    "taskmanager": ["org.temuos.TaskManager", "org.kde.plasma-systemmonitor"],
    "android": ["org.temuos.Android", "temu-android"],
    "terminal": ["org.temuos.Terminal", "org.kde.konsole"],
    "snip": ["org.temuos.Snip", "org.kde.spectacle"],
    "drivers": ["org.temuos.Drivers"],
    "welcome": ["org.temuos.Welcome", "org.kde.plasma-welcome"],
    "disks": ["org.temuos.Disks", "org.kde.partitionmanager", "gnome-disks", "org.gnome.DiskUtility"],
}


def launch(key, extra):
    import os
    import subprocess
    dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    dirs.insert(0, os.path.expanduser("~/.local/share"))
    for app in APPS.get(key, [key]):
        for d in dirs:
            path = os.path.join(d, "applications", app + ".desktop")
            if os.path.exists(path):
                subprocess.Popen(["kioclient", "exec", path] + extra, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return 0
    sys.stderr.write("temu-shell: no app installed for %s\n" % key)
    return 1


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "launch":
        return launch(sys.argv[2], sys.argv[3:])
    query =len(sys.argv) == 4 and sys.argv[1] == "query"
    if not query and (len(sys.argv) != 3 or sys.argv[1] not in ("toggle", "show", "hide")) or sys.argv[2:3] == [] or sys.argv[2] not in NAMES:
        sys.stderr.write("usage: temu-shell toggle|show|hide <%s>\n" % "|".join(NAMES))
        return 2
    from PySide6.QtDBus import QDBusConnection, QDBusMessage, QDBusConnectionInterface
    bus = QDBusConnection.sessionBus()
    if not bus.isConnected():
        sys.stderr.write("temu-shell: no session bus\n")
        return 1
    # wait in the queue if another temu-shell holds the name right now
    reply = bus.interface().registerService("org.temuos.Shell",
                                            QDBusConnectionInterface.QueueService,
                                            QDBusConnectionInterface.AllowReplacement)
    member = sys.argv[1].capitalize()
    sig = QDBusMessage.createSignal("/org/temuos/Shell", "org.temuos.Shell", member)
    sig.setArguments(sys.argv[2:4] if query else [sys.argv[2]])
    bus.send(sig)
    # a blocking round trip flushes the signal before we exit and drop the name
    bus.call(QDBusMessage.createMethodCall("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                           "org.freedesktop.DBus", "GetId"))
    bus.unregisterService("org.temuos.Shell")
    return 0


if __name__ == "__main__":
    sys.exit(main())
