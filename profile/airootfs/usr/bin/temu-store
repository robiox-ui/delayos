#!/usr/bin/python3
# TEMUOS Store (org.temuos.Store). Usage: temu-store [--installed | --updates | --search TEXT | APP_ID | appstream://ID]
import sys
sys.path[:0] = ["/usr/share/temuos/apps/syskit", "/usr/share/temuos/apps/store"]
from syskit import run_app, single_instance
if single_instance("org.temuos.Store", sys.argv[1:]):
    sys.exit(0)


def ctx():
    from installer import Installer
    return {"installer": Installer()}


sys.exit(run_app("org.temuos.Store", "TEMUOS Store", "/usr/share/temuos/apps/store/qml/main.qml",
                 icon="temuos-store", extra_ctx=ctx))
