[Desktop Entry]
# DelayOS override of /usr/share/applications/kcm_bluetooth.desktop: opens DelayOS Settings.
Type=Application
Name=Bluetooth & Devices
Name[ko]=Bluetooth 및 장치
Icon=delayos-settings
Exec=delay-settings bluetooth
Terminal=false
StartupNotify=true
StartupWMClass=org.delayos.Settings
NoDisplay=true
