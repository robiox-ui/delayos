[Desktop Entry]
# DelayOS override of /usr/share/applications/kcm_componentchooser.desktop: opens DelayOS Settings.
Type=Application
Name=Default Apps
Name[ko]=기본 앱
Icon=delayos-settings
Exec=delay-settings defaultapps
Terminal=false
StartupNotify=true
StartupWMClass=org.delayos.Settings
NoDisplay=true
