#!/usr/bin/env bash
# Runs once as root on every boot of the live ISO and on the first boot of an
# installed system (delay-firstboot.service). Idempotent.
set -u
STAMP=/var/lib/delay/firstboot.done
mkdir -p /var/lib/delay

# ---- Live session user (only on the ISO) ----
if grep -q archisobasedir /proc/cmdline && ! id live >/dev/null 2>&1; then
  useradd -m -G wheel,video,audio,input,gamemode,docker -s /bin/bash live
  passwd -d live
  echo 'live ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/10-live
  chmod 440 /etc/sudoers.d/10-live
  install -d -o live -g live /home/live/Desktop
  cp /usr/local/share/applications/calamares.desktop /home/live/Desktop/install-delayos.desktop 2>/dev/null &&
    chown live:live /home/live/Desktop/install-delayos.desktop && chmod +x /home/live/Desktop/install-delayos.desktop
  # The live user has no password: never lock the screen (it locked after 5 idle minutes)
  install -d -o live -g live /home/live/.config
  printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > /home/live/.config/kscreenlockerrc
  chown live:live /home/live/.config/kscreenlockerrc
fi

# ---- Low-memory desktop profile (under ~3 GB RAM), checked on every boot ----
# Plasma stays the session, but KWin drops the effects that cost GPU memory and fill rate on
# weak machines: blur / background contrast behind the glass, the genie minimise and the
# rounded-corner shader. The shell itself (DelayShell.ShellBus) builds popups only on demand
# there. Adding RAM later puts the effects back at the next boot. A user's own choice in
# ~/.config/kwinrc always wins over these system defaults.
mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
LOWMARK=/var/lib/delay/lowmem
low_effects() { # $1 = true|false
  local e
  for e in blur contrast backgroundcontrast magiclamp kwin4_effect_shapecorners; do
    sed -i "s/^${e}Enabled=.*/${e}Enabled=$1/" /etc/xdg/kwinrc
  done
}
if (( mem_kb < 3100000 )); then
  [[ -e $LOWMARK ]] || { low_effects false; touch "$LOWMARK"; }
elif [[ -e $LOWMARK ]]; then
  low_effects true; rm -f "$LOWMARK"
fi

[[ -e $STAMP ]] && exit 0

# ---- Low-memory machines (< 1.5 GB): lightweight session as default ----
mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
if (( mem_kb < 1500000 )); then
  mkdir -p /etc/sddm.conf.d
  printf '[Autologin]\nSession=delay-lite\n' > /etc/sddm.conf.d/20-lite.conf
  # the greeter preselects the session named in SDDM's state file
  if [[ -d /var/lib/sddm ]]; then
    sed -i '/^Session=/d' /var/lib/sddm/state.conf 2>/dev/null
    grep -q '^\[Last\]' /var/lib/sddm/state.conf 2>/dev/null || echo '[Last]' >> /var/lib/sddm/state.conf
    sed -i 's|^\[Last\]|[Last]\nSession=/usr/share/wayland-sessions/delay-lite.desktop|' /var/lib/sddm/state.conf
  fi
  # zram up to 2x RAM on tiny machines
  mkdir -p /etc/systemd
  printf '[zram0]\ncompression-algorithm = zstd\nzram-size = ram * 2\nswap-priority = 100\nfs-type = swap\n' > /etc/systemd/zram-generator.conf
fi

# ---- Hardware-specific tuning ----
if lspci | grep -qi 'vga.*nvidia\|3d.*nvidia'; then
  systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service 2>/dev/null
fi

# ---- Flathub for the app store (Discover) ----
flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null

touch "$STAMP"
