#!/usr/bin/env bash
# Privileged half of Gaming mode (allowed via /etc/sudoers.d/20-delay-gamemode).
# Only accepts "on" or "off".
set -u
SERVICES=(packagekit.service fwupd.service snapper-timeline.timer snapper-cleanup.timer
          man-db.timer updatedb.timer)
case "${1:-}" in
  on)
    for s in "${SERVICES[@]}"; do systemctl stop "$s" 2>/dev/null; done
    # all cores to max clocks; disable deep idle on the scheduler side
    cpupower frequency-set -g performance >/dev/null 2>&1
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      [[ -w $f ]] && echo performance > "$f"
    done
    # sched-ext: LAVD in gaming mode (latency-critical tasks first), like CachyOS's gaming setup
    command -v scxctl >/dev/null && { scxctl switch -s lavd -m gaming >/dev/null 2>&1 || scxctl start -s lavd -m gaming >/dev/null 2>&1; }
    # Write back dirty pages now, so the game never waits on them
    sync
    ;;
  off)
    for s in snapper-timeline.timer snapper-cleanup.timer man-db.timer; do systemctl start "$s" 2>/dev/null; done
    cpupower frequency-set -g schedutil >/dev/null 2>&1 || cpupower frequency-set -g powersave >/dev/null 2>&1
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      [[ -w $f ]] && echo balance_performance > "$f"
    done
    command -v scxctl >/dev/null && { scxctl switch -s lavd -m auto >/dev/null 2>&1 || true; }
    ;;
  *) exit 1 ;;
esac
