#!/usr/bin/env bash
# Win+X quick tools menu
choice=$(kdialog --title "Quick tools" --menu "" \
    apps "Installed apps" power "Power options" sys "System" drv "Drivers" \
    net "Network connections" disk "Disk management" term "Terminal" \
    tm "Task Manager" set "Settings" files "File Explorer" search "Search" \
    game "Gaming mode" out "Sign out" reboot "Restart" off "Shut down" desk "Desktop")
case "$choice" in
  apps)   exec plasma-discover --mode installed ;;
  power)  exec systemsettings kcm_powerdevilprofilesconfig ;;
  sys)    exec kinfocenter ;;
  drv)    exec konsole --hold -e sh -c 'echo "== GPU =="; lspci -k | grep -A3 -E "VGA|3D"; echo; echo "Update everything: sudo pacman -Syu"' ;;
  net)    exec systemsettings kcm_networkmanagement ;;
  disk)   exec partitionmanager ;;
  term)   exec konsole ;;
  tm)     exec plasma-systemmonitor ;;
  set)    exec systemsettings ;;
  files)  exec dolphin ;;
  search) exec krunner ;;
  game)   exec /usr/local/bin/temu-gamemode toggle ;;
  out)    exec qdbus6 org.kde.Shutdown /Shutdown logout ;;
  reboot) exec qdbus6 org.kde.Shutdown /Shutdown logoutAndReboot ;;
  off)    exec qdbus6 org.kde.Shutdown /Shutdown logoutAndShutdown ;;
  desk)   exec qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut "Show Desktop" ;;
esac
