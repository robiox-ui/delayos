#!/usr/bin/env bash
# Run by Calamares (shellprocess, chroot) after the live image is copied to disk.
# Turns the live system into a normal installed DelayOS.
set -eu

# Kernels/microcode live on the ISO, not in the squashfs: bring them over
BOOTMNT=/run/archiso/bootmnt/arch/boot
for k in linux-delayos linux-lts; do
  if [[ -f /tmp/delay-boot/x86_64/vmlinuz-$k ]]; then
    install -m644 /tmp/delay-boot/x86_64/vmlinuz-$k /boot/vmlinuz-$k
  fi
  cat > /etc/mkinitcpio.d/$k.preset <<EOF
ALL_kver='/boot/vmlinuz-$k'
PRESETS=('default' 'fallback')
default_image='/boot/initramfs-$k.img'
fallback_image='/boot/initramfs-$k-fallback.img'
fallback_options='-S autodetect'
EOF
done
cp /tmp/delay-boot/*-ucode.img /boot/ 2>/dev/null || true
: "$BOOTMNT"

# Remove live-only bits
rm -f /etc/mkinitcpio.conf.d/archiso.conf
rm -f /etc/sddm.conf.d/00-live-autologin.conf
rm -f /etc/sudoers.d/10-live
userdel -rf live 2>/dev/null || true
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
pacman -Rns --noconfirm calamares mkinitcpio-archiso 2>/dev/null || true
rm -f /usr/local/share/applications/calamares.desktop
# Arch live-medium units and files that came along in the image copy
S=/etc/systemd/system
rm -f "$S"/multi-user.target.wants/{pacman-init,choose-mirror,livecd-talk,sshd}.service \
      "$S"/sound.target.wants/livecd-alsa-unmuter.service \
      "$S"/{pacman-init,choose-mirror,livecd-talk,livecd-alsa-unmuter}.service \
      "$S"/etc-pacman.d-gnupg.mount /etc/ssh/sshd_config.d/10-archiso.conf \
      /root/.automated_script.sh /root/.zlogin
rm -rf "$S"/pacman-init.service.d
# pacman keyring: on the live medium it is a tmpfs rebuilt on every boot; make a real one
rm -rf /etc/pacman.d/gnupg
pacman-key --init >/dev/null 2>&1 && pacman-key --populate >/dev/null 2>&1 || true
# There is no Korean console keymap: Calamares writes KEYMAP=ko/kr, systemd-vconsole-setup fails
km=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null | head -n1)
if [[ -n $km ]] && ! find /usr/share/kbd/keymaps -name "$km.map*" 2>/dev/null | grep -q .; then
  sed -i 's/^KEYMAP=.*/KEYMAP=us/' /etc/vconsole.conf
fi
# Log in to the Plasma session by default: SDDM preselects the first session file
# (delay-lite.desktop sorts before plasma.desktop) when it has no "last session" yet
install -d -o sddm -g sddm -m750 /var/lib/sddm 2>/dev/null || mkdir -p /var/lib/sddm
printf '[Last]\nSession=/usr/share/wayland-sessions/plasma.desktop\n' > /var/lib/sddm/state.conf

# Fast, quiet boot with gaming-friendly kernel options
# The boot menu is hidden (docs/recovery.md): Esc during the one-second wait (or Shift held down, where
# the firmware reports it) shows it with "DelayOS 복구" and "이전 상태로 부팅". With another operating
# system next to DelayOS (os-prober finds it) the menu stays visible for 3 seconds.
grub_set() { # KEY VALUE: set KEY=VALUE in /etc/default/grub (uncomment or append)
  if grep -Eq "^#?$1=" /etc/default/grub; then sed -i "s|^#\?$1=.*|$1=$2|" /etc/default/grub
  else printf '%s=%s\n' "$1" "$2" >> /etc/default/grub; fi
}
if [[ ${DELAYOS_WINGAMES:-0} != 1 ]] && os-prober 2>/dev/null | grep -q .; then
  grub_set GRUB_TIMEOUT 3; grub_set GRUB_TIMEOUT_STYLE menu
else
  grub_set GRUB_TIMEOUT 1; grub_set GRUB_TIMEOUT_STYLE hidden
fi
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grep -q '^GRUB_DISABLE_OS_PROBER' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
# Hidden Windows for anti-cheat games (delay-winsetup): it is started by "Windows 전환", never from the
# GRUB menu, so os-prober must not add it there
if [[ ${DELAYOS_WINGAMES:-0} == 1 ]]; then
  sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=true/' /etc/default/grub
fi
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 splash nowatchdog nvme_core.default_ps_max_latency_us=0 split_lock_detect=off zswap.enabled=0 mitigations=auto"/' /etc/default/grub
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="DelayOS"/' /etc/default/grub
# grub-mkconfig sorts linux-lts before linux-delayos, so the default entry booted the LTS
# fallback kernel: pin linux-delayos as the top-level entry (GRUB >= 2.12)
sed -i '/^GRUB_TOP_LEVEL=/d' /etc/default/grub
echo 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-delayos"' >> /etc/default/grub

# Services
systemctl enable sddm NetworkManager bluetooth fstrim.timer irqbalance \
  ananicy-cpp power-profiles-daemon systemd-oomd delay-firstboot delay-eac-facts scx_loader rtkit-daemon 2>/dev/null || true
systemctl enable thermald 2>/dev/null || true
systemctl disable earlyoom 2>/dev/null || true   # systemd-oomd is used instead
rm -f /var/lib/delay/firstboot.done

# Installer "Minimal" choice: drop the big optional app set
if [[ ${DELAYOS_SOFTWARE:-} == minimal ]]; then
  pacman -Rns --noconfirm libreoffice-fresh libreoffice-fresh-ko gimp vlc lutris bottles 2>/dev/null || true
fi

# ---- pacman: Steam and the 32-bit drivers come from multilib (commented out in the stock pacman.conf) ----
if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
  sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
fi

# ---- DelayOS package repository (docs/packaging.md) ----
# [delayos] goes above the Arch repositories: linux-delayos, the delayos-* packages (shell, apps,
# settings, branding) and proton-delayos are updated from it with every pacman -Syu. The key comes
# from the delayos-keyring package (populated above); without it nothing is written.
/usr/local/bin/delay-cpu-opt repo-setup || true

# ---- Graphics drivers that match this PC (the image carries every vendor's) ----
/usr/local/bin/delay-gpu-setup --install-time --quiet || true

# ---- CPU-optimized packages (docs/gaming-performance.md) ----
# On a CPU with x86-64-v3 / v4 / Zen 4-5 the DelayOS repository built for that level is enabled
# ([delayos-v3] / -v4 / -znver4) and the system is upgraded to those builds. Without a network (or when
# anything fails) nothing is changed here and delay-cpu-opt.service does it on the first boot that
# has a network. Opt out: boot the installer with delayos.cpuopt=off (or DELAYOS_CPUOPT=off).
# DELAYOS_CPUOPT_KERNEL=1 / delayos.cpuopt=kernel also installs the CPU-matched kernel.
# delayos.cpuopt.source=cachyos (or DELAYOS_CPUOPT_SOURCE=cachyos) uses the CachyOS repositories instead.
cpuopt="${DELAYOS_CPUOPT:-auto}"
for w in $(cat /proc/cmdline 2>/dev/null); do
  case "$w" in
    delayos.cpuopt=*) cpuopt="${w#delayos.cpuopt=}" ;;
    delayos.cpuopt.source=*) export DELAYOS_CPUOPT_SOURCE="${w#delayos.cpuopt.source=}" ;;
  esac
done
case "$cpuopt" in
  off|0|no) ;;
  *)
    cpuflags=(--install-time)
    [[ ${DELAYOS_CPUOPT_KERNEL:-0} == 1 || $cpuopt == kernel ]] && cpuflags+=(--kernel)
    /usr/local/bin/delay-cpu-opt enable "${cpuflags[@]}" || true
    ;;
esac

# ---- Snapshots and recovery (docs/recovery.md) ----
# snapper configuration "root" for @ (snap-pac: a snapshot before/after every pacman transaction;
# one automatic snapshot a day), /.snapshots = @snapshots, GRUB submenu "이전 상태로 부팅" (grub-btrfs).
# Last step on purpose: the package work above must not fill the new system with snapshots.
# On ext4/xfs installations this does nothing (exit 3).
/usr/local/bin/delay-snapshot setup --install-time || true
# Boot-failure counter for the automatic start of "DelayOS 복구" (etc/grub.d/45_delayos-recovery)
systemctl enable delay-boot-ok.service delay-boot-ok.timer 2>/dev/null || true
