#!/usr/bin/env bash
# delay-deploy: DelayOS 배포 도구 (Windows의 bcdboot / dism /apply-image / reagentc 에 해당). docs/recovery.md
#
#   delay-deploy boot <루트>            boot loader + boot entries + firmware entry of an installed DelayOS
#   delay-deploy apply <이미지> <파티션> put a system image on a partition (subvolumes, fstab, then "boot")
#   delay-deploy capture <루트> <이미지> make a system image (read-only snapshot -> btrfs send | zstd)
#   delay-deploy recovery ...           the hidden recovery partition (DELAYOS-RE)
#
# Used by the installer (Calamares modules delayos_recoverypart / delayos_factory), by the recovery
# environment ("시동 복구" = delay-deploy boot) and by Settings > 시스템 > 복구.
# It never writes to NTFS/BitLocker/FAT partitions, to the hidden Windows partitions or to a
# partition the running system uses.
set -u
export LC_ALL=C.UTF-8 LANGUAGE=en
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

PROG=delay-deploy
DRY=0; FORCE=0; JSON=0
RE_LABEL=DELAYOS-RE
RE_DIR=delayos-re
RE_SIZE_MIB=2048
RE_MIN_DISK_GIB=60          # "64 GB" drives (59.6 GiB) and smaller get no recovery partition
RE_MIN_ROOT_GIB=30          # what must be left for the system after the recovery partition is taken out
RE_IMAGE=/usr/share/delayos/recovery/image
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
BTRFS_OPTS=noatime,compress=zstd:1,space_cache=v2,discard=async,commit=120
# name:mount point (the layout Calamares makes, etc/calamares/modules/mount.conf)
SUBVOLS=("@:/" "@home:/home" "@cache:/var/cache" "@log:/var/log" "@snapshots:/.snapshots" "@docker:/var/lib/docker")

msg()  { printf '\e[1;36m==>\e[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
warn() { printf '\e[1;33m==> 경고:\e[0m %s\n' "$*" >&2; }
die()  { local rc=1; [[ ${1:-} =~ ^[0-9]+$ ]] && { rc=$1; shift; }; printf '\e[1;31m==> 오류:\e[0m %s\n' "$*" >&2; exit "$rc"; }
run()  { if (( DRY )); then printf '    [dry-run] %s\n' "$*"; else "$@"; fi; }
need_root() { (( DRY )) || [[ $EUID -eq 0 ]] || die 77 "루트 권한이 필요합니다 (sudo $PROG ...)"; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
delay-deploy: DelayOS 배포 도구

사용법:
  delay-deploy boot <루트 마운트 지점> [--esp <마운트 지점|파티션>] [--bios <디스크>]
        설치된 DelayOS의 부트로더(GRUB), 부팅 항목, 펌웨어(UEFI) 부팅 항목을 설치하거나 고칩니다.
        fstab 점검, 커널 이미지 복원, initramfs 재생성, grub.cfg 재생성, UEFI 부팅 순서 정리를 차례로 합니다.
        예) sudo delay-deploy boot /            지금 실행 중인 시스템
            sudo delay-deploy boot /mnt         /mnt에 마운트한 다른 DelayOS (복구 환경, 설치 USB)
        --esp <경로>       EFI 시스템 파티션 (기본: 루트의 fstab 또는 같은 디스크에서 찾음)
        --bios <디스크>    BIOS(레거시) 부트로더를 이 디스크의 MBR에 설치 (예: /dev/sda)
        --no-nvram         펌웨어 부팅 항목과 부팅 순서를 건드리지 않음
        --no-initramfs     initramfs를 다시 만들지 않음
        --no-fstab         fstab을 점검/수정하지 않음

  delay-deploy apply <이미지> <대상 파티션> [--esp <파티션>] [--bios <디스크>] [--format | --replace-system] [--no-boot]
        시스템 이미지를 파티션에 풉니다. 하위 볼륨(@, @home, @cache, @log, @snapshots, @docker)과 fstab을 만들고
        이어서 'boot'를 실행합니다.
        이미지 형식: capture로 만든 *.dimg (btrfs send 스트림 + zstd), *.tar / *.tar.zst, *.sfs (squashfs)
        --format           대상 파티션을 btrfs로 새로 포맷 (안의 모든 데이터 삭제)
        --replace-system   기존 DelayOS의 시스템(@)만 바꾸고 홈 폴더(@home) 등은 유지
        --overlay <폴더>   이미지를 푼 뒤 이 폴더의 파일을 시스템 위에 덮어씀 (드라이버, 설정 추가용)

  delay-deploy capture <루트 마운트 지점> <이미지 파일> [--level <1-19>]
        시스템 이미지를 만듭니다. 읽기 전용 스냅샷을 찍어 내보내므로 실행 중인 시스템도 캡처할 수 있습니다.
        확장자로 형식을 고릅니다: .dimg (기본, btrfs 전용) / .tar.zst / .sfs
        홈 폴더(@home), 로그, 캐시는 들어가지 않습니다.

  delay-deploy recovery status [--json]         복구 파티션 상태
  delay-deploy recovery create <루트>            시스템 파티션 끝에서 2 GB를 떼어 복구 파티션을 만들고 복구 환경을 설치
  delay-deploy recovery install [<파티션>]       복구 환경 이미지를 복구 파티션에 다시 설치
  delay-deploy recovery loader                  복구 환경 전용 부트로더와 펌웨어 항목(DelayOS Recovery)을 EFI 파티션에 설치
        --image <폴더>     복구 환경 이미지 위치 (기본: /usr/share/delayos/recovery/image)

공통 옵션:
  --dry-run   실제로 바꾸지 않고 할 일만 출력
  --force     실행 중인 시스템이 있는 디스크도 대상으로 허용 (복구 환경에서는 필요)
  -h, --help  이 도움말

Windows(NTFS/BitLocker), EFI, 복구 파티션에는 이미지를 풀지 않습니다. 다른 디스크는 건드리지 않습니다.
EOF
}

# ------------------------------------------------------------------ devices
src_of() { local s; s=$(findmnt -fno SOURCE -T "$1" 2>/dev/null) || return 1; printf '%s' "${s%%\[*}"; }
fstype_of() { blkid -s TYPE -o value "$1" 2>/dev/null; }
uuid_of() { blkid -s UUID -o value "$1" 2>/dev/null; }
disk_of() { lsblk -lpnso NAME,TYPE "$1" 2>/dev/null | awk '$2 == "disk" { print $1; exit }'; }
part_of() { lsblk -lpnso NAME,TYPE "$1" 2>/dev/null | awk '$2 == "part" { print $1; exit }'; }
partn_of() { cat "/sys/class/block/$(basename "$(readlink -f "$1")")/partition" 2>/dev/null; }
is_uefi() { [[ -d /sys/firmware/efi ]]; }
running_devs() { # every block device under the running system (partitions and their disks)
  local mp s
  for mp in / /home /boot /boot/efi /efi /usr /var /.snapshots /run/archiso/bootmnt /run/archiso/airootfs; do
    s=$(findmnt -fno SOURCE "$mp" 2>/dev/null) || continue
    s=${s%%\[*}
    [[ -b $s ]] && lsblk -lpnso NAME "$s" 2>/dev/null
  done
  swapon --noheadings --raw --show=NAME 2>/dev/null | while read -r s; do [[ -b $s ]] && lsblk -lpnso NAME "$s" 2>/dev/null; done
}
is_running_dev() { local d; d=$(readlink -f "$1"); running_devs | grep -qxF "$d"; }
protected_part() { # partitions delay-deploy never formats or fills, whatever the options
  local p=$1 t l pl
  t=$(fstype_of "$p"); l=$(blkid -s LABEL -o value "$p" 2>/dev/null); pl=$(blkid -s PARTLABEL -o value "$p" 2>/dev/null)
  case "$t" in ntfs|BitLocker|vfat|exfat) echo "$t 파일 시스템(Windows/EFI)"; return 0 ;; esac
  case "$l" in "$RE_LABEL"|DELAYOSWIN|DELAYWINSET) echo "레이블 $l"; return 0 ;; esac
  case "$pl" in DelayOS-Windows|DelayOS-WinSetup|"Microsoft reserved partition"|"EFI system partition"|"$RE_LABEL") echo "파티션 이름 $pl"; return 0 ;; esac
  [[ $(lsblk -dno PARTTYPE "$p" 2>/dev/null) == "$ESP_TYPE" ]] && { echo "EFI 시스템 파티션"; return 0; }
  return 1
}
find_esp_on() { # the EFI system partition on disk $1
  lsblk -lpno NAME,PARTTYPE "$1" 2>/dev/null | awk -v t="$ESP_TYPE" 'tolower($2) == t { print $1; exit }'
}

# ------------------------------------------------------------------ chroot plumbing
ROOT=""; CLEAN=()
cleanup() {
  local i p
  # daemons started inside the chroot (gpg-agent of pacman-key, ...) would keep it mounted
  if [[ -n $ROOT && $ROOT != / && ${#CLEAN[@]} -gt 0 ]]; then
    for p in /proc/[0-9]*; do
      [[ $(readlink "$p/root" 2>/dev/null) == "$ROOT" ]] && kill "${p#/proc/}" 2>/dev/null
    done
    sleep 0.3
  fi
  for (( i = ${#CLEAN[@]} - 1; i >= 0; i-- )); do eval "${CLEAN[i]}" >/dev/null 2>&1; done
  CLEAN=()
}
trap cleanup EXIT
in_root() { if [[ $ROOT == / ]]; then "$@"; else chroot "$ROOT" /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/bin LANG=C.UTF-8 HOME=/root TERM="${TERM:-linux}" "$@"; fi; }
rrun() { if (( DRY )); then printf '    [dry-run] (%s) %s\n' "$ROOT" "$*"; else in_root "$@"; fi; }
bind_mount() { # $1 fs type or "bind"  $2 source  $3 dir under ROOT
  local t=$ROOT$3
  mountpoint -q "$t" && return 0
  mkdir -p "$t" 2>/dev/null
  if [[ $1 == bind ]]; then mount --rbind "$2" "$t" && mount --make-rslave "$t"; else mount -t "$1" "$2" "$t"; fi || return 1
  CLEAN+=("umount -R '$t' || umount -l '$t'")
}
enter_root() {
  [[ $ROOT == / ]] && return 0
  (( DRY )) && return 0
  bind_mount proc proc /proc && bind_mount sysfs sys /sys && bind_mount bind /dev /dev || die "$ROOT 안에 /proc, /sys, /dev를 준비하지 못했습니다"
  bind_mount tmpfs tmpfs /run
  mkdir -p "$ROOT/run/udev" "$ROOT/run/lock" && bind_mount bind /run/udev /run/udev
  bind_mount tmpfs tmpfs /tmp
  is_uefi && bind_mount efivarfs efivarfs /sys/firmware/efi/efivars
  return 0
}

# ------------------------------------------------------------------ fstab
gen_fstab() { # $1 root dir  $2 btrfs device  $3 ESP device (may be empty)
  local r=$1 u e o
  u=$(uuid_of "$2")
  {
    echo "# /etc/fstab: DelayOS (delay-deploy가 작성)"
    echo "# <file system>                           <mount point>  <type>  <options>  <dump> <pass>"
    for e in "${SUBVOLS[@]}"; do
      [[ -d $r${e#*:} || ${e#*:} == / ]] || mkdir -p "$r${e#*:}"
      printf 'UUID=%-36s %-14s btrfs  subvol=/%s,%s 0 0\n' "$u" "${e#*:}" "${e%%:*}" "$BTRFS_OPTS"
    done
    if [[ -n ${3:-} ]]; then
      o=$(uuid_of "$3")
      printf 'UUID=%-36s %-14s vfat   defaults,umask=0077 0 2\n' "$o" /boot/efi
    fi
  } > "$r/etc/fstab"
}
fstab_check() { # $1 root dir  $2 device of /  $3 ESP device (may be empty)
  local f=$1/etc/fstab real esp_real old changed=0 line spec mp fs tmp
  real=$(uuid_of "$2"); esp_real=""; [[ -n ${3:-} ]] && esp_real=$(uuid_of "$3")
  if [[ ! -s $f ]] || ! awk '$1 !~ /^#/ && $2 == "/" { f = 1 } END { exit !f }' "$f"; then
    warn "fstab에 루트(/) 항목이 없습니다"
    if [[ $(fstype_of "$2") == btrfs ]]; then
      (( DRY )) && { note "[dry-run] fstab을 새로 씁니다"; return 0; }
      [[ -e $f ]] && cp -a "$f" "$f.delay-bak"
      gen_fstab "$1" "$2" "${3:-}"; note "fstab을 새로 썼습니다 (이전 파일: fstab.delay-bak)"
    fi
    return 0
  fi
  tmp=$(mktemp) || return 1
  cp "$f" "$tmp"
  # the UUID of / changed (file system re-created, disk cloned): every entry that used it follows
  old=$(awk '$1 !~ /^#/ && $2 == "/" { print $1; exit }' "$f")
  if [[ $old == UUID=* && -n $real && ${old#UUID=} != "$real" ]] && ! blkid -U "${old#UUID=}" >/dev/null 2>&1; then
    sed -i "s/UUID=${old#UUID=}\b/UUID=$real/g" "$tmp"; changed=1
    note "루트 파일 시스템의 UUID가 바뀌어 fstab을 고쳤습니다 (${old#UUID=} → $real)"
  fi
  while read -r spec mp fs _; do
    [[ -z $spec || $spec == \#* || $spec != UUID=* ]] && continue
    blkid -U "${spec#UUID=}" >/dev/null 2>&1 && continue
    grep -q "^UUID=${spec#UUID=}\b" "$tmp" || continue          # already rewritten above
    if [[ $fs == vfat && ( $mp == /boot/efi || $mp == /efi || $mp == /boot ) && -n $esp_real ]]; then
      sed -i "s/UUID=${spec#UUID=}\b/UUID=$esp_real/g" "$tmp"; changed=1
      note "EFI 파티션의 UUID가 바뀌어 fstab을 고쳤습니다 (${spec#UUID=} → $esp_real)"
    elif [[ $mp != / ]]; then
      # a missing data disk must not stop the boot
      awk -v s="$spec" -v m="$mp" 'BEGIN { OFS = " " }
        $1 == s && $2 == m && $4 !~ /nofail/ { $4 = $4 ",nofail,x-systemd.device-timeout=5s" } { print }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
      changed=1
      note "$mp: 장치(${spec})가 없습니다. 부팅을 막지 않도록 nofail을 붙였습니다."
    fi
  done < "$f"
  if (( changed )); then
    if (( DRY )); then note "[dry-run] fstab을 고칩니다"; else cp -a "$f" "$f.delay-bak"; cat "$tmp" > "$f"; fi
  else
    note "fstab: 이상 없음"
  fi
  rm -f "$tmp" "$tmp.2"
}

# ------------------------------------------------------------------ boot
restore_kernels() { # /boot/vmlinuz-* missing or empty: take the copy the kernel package keeps in /usr/lib/modules
  local d k
  for d in "$ROOT"/usr/lib/modules/*/; do
    [[ -f $d/pkgbase && -f $d/vmlinuz ]] || continue
    k=$(<"$d/pkgbase")
    if [[ ! -s $ROOT/boot/vmlinuz-$k ]]; then
      note "커널 이미지 /boot/vmlinuz-$k 이(가) 없어 복원합니다"
      run install -Dm644 "$d/vmlinuz" "$ROOT/boot/vmlinuz-$k"
    fi
    if [[ ! -f $ROOT/etc/mkinitcpio.d/$k.preset ]] && (( ! DRY )); then
      mkdir -p "$ROOT/etc/mkinitcpio.d"
      printf "ALL_kver='/boot/vmlinuz-%s'\nPRESETS=('default' 'fallback')\ndefault_image='/boot/initramfs-%s.img'\nfallback_image='/boot/initramfs-%s-fallback.img'\nfallback_options='-S autodetect'\n" \
        "$k" "$k" "$k" > "$ROOT/etc/mkinitcpio.d/$k.preset"
    fi
  done
}
# The boot menu entry "DelayOS 복구" lives in /boot/grub/grub.cfg, on the system's own btrfs: when
# that file system or GRUB's files are damaged, the entry is gone exactly when it is needed. So the
# recovery environment also gets its own loader on the EFI partition, a self-contained GRUB image
# that needs nothing from /boot, and its own firmware entry "DelayOS Recovery" (after DelayOS in the
# boot order: the firmware falls through to it when DelayOS's loader is missing, and it is in the
# firmware's boot menu, F8/F11/F12). UEFI only; not installed with Secure Boot (it is not signed).
install_re_loader() { # $1 ESP device  $2 ESP mount point inside ROOT
  local re cfg out=$2/EFI/DelayOS/recovery.efi disk n
  re=$(re_find "$ROOT") || return 0
  [[ -x $ROOT/usr/bin/grub-mkstandalone ]] || return 0
  cfg=$ROOT/tmp/delay-re-grub.cfg
  cat > "$cfg" <<EOF
set timeout=0
search --no-floppy --fs-uuid --set=root $(uuid_of "$re")
if [ -z "\$root" ]; then search --no-floppy --label --set=root $RE_LABEL; fi
echo 'DelayOS Recovery...'
linux /$RE_DIR/boot/vmlinuz archisobasedir=$RE_DIR archisolabel=$RE_LABEL nomodeset quiet loglevel=3 nowatchdog delayos.re=1
initrd /$RE_DIR/boot/initramfs.img
boot
EOF
  if in_root grub-mkstandalone -O x86_64-efi -o "$out" --locales= --fonts= --themes= \
       --modules="part_gpt part_msdos ext2 search search_fs_uuid search_label linux normal echo all_video" \
       "boot/grub/grub.cfg=/tmp/delay-re-grub.cfg" >/dev/null 2>&1; then
    note "복구 환경 전용 부트로더(EFI/DelayOS/recovery.efi)를 설치했습니다"
    if (( BOOT_NVRAM )) && have efibootmgr && ! efibootmgr 2>/dev/null | grep -q '^Boot[0-9A-Fa-f]\{4\}\*\? DelayOS Recovery'; then
      disk=$(disk_of "$1"); n=$(partn_of "$1")
      [[ -n $disk && -n $n ]] && efibootmgr -q -c -d "$disk" -p "$n" -L "DelayOS Recovery" -l '\EFI\DelayOS\recovery.efi' 2>/dev/null \
        && note "펌웨어 부팅 항목 'DelayOS Recovery'를 추가했습니다"
    fi
  else
    warn "복구 환경 전용 부트로더를 만들지 못했습니다 (부팅 메뉴의 'DelayOS 복구'는 그대로 쓸 수 있습니다)"
  fi
  rm -f "$cfg"
}
efi_order_first() { # make the firmware entry "DelayOS" the first one in BootOrder
  have efibootmgr || return 0
  local out num order rest
  out=$(efibootmgr 2>/dev/null) || return 0
  num=$(sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\? DelayOS\b.*/\1/p' <<<"$out" | head -n1)
  order=$(sed -n 's/^BootOrder: //p' <<<"$out")
  [[ -n $num ]] || { warn "펌웨어에 DelayOS 부팅 항목이 없습니다"; return 1; }
  [[ $order == "$num"* ]] && { note "UEFI 부팅 순서: DelayOS가 첫 번째입니다"; return 0; }
  rest=$(tr ',' '\n' <<<"$order" | grep -vix "$num" | paste -sd,)
  note "UEFI 부팅 순서에서 DelayOS를 맨 앞으로 옮깁니다"
  run efibootmgr -q -o "$num${rest:+,$rest}"
}
do_boot() { # ROOT set; $1 esp spec (mount point | device | "")  $2 bios disk ("" = auto)  flags in BOOT_*
  local esp_spec=$1 bios_disk=$2 rootdev esp_dev="" esp_rel=/boot/efi mp spec rc=0 step=0 total=6
  [[ -d $ROOT ]] || die "$ROOT: 디렉터리가 없습니다"
  ROOT=$(readlink -f "$ROOT")
  grep -qi 'delayos' "$ROOT/etc/os-release" "$ROOT/usr/lib/os-release" 2>/dev/null || (( FORCE )) \
    || die "$ROOT 에서 DelayOS를 찾지 못했습니다 (다른 Linux라면 --force)"
  [[ -x $ROOT/usr/bin/grub-install ]] || die "$ROOT 에 GRUB이 설치되어 있지 않습니다"
  rootdev=$(src_of "$ROOT") || die "$ROOT 의 장치를 알 수 없습니다"
  [[ -b $rootdev ]] || die "$ROOT 은(는) 디스크의 파일 시스템이 아닙니다 ($rootdev). 스냅샷으로 부팅한 상태에서는 쓸 수 없습니다."
  if [[ $ROOT != / ]] && (( ! FORCE )) && running_devs | grep -qxF "$(disk_of "$rootdev")"; then
    die 4 "$ROOT 은(는) 실행 중인 시스템과 같은 디스크에 있습니다. 맞다면 --force를 붙이세요."
  fi
  enter_root

  # --- EFI system partition
  if is_uefi; then
    if [[ -n $esp_spec && -b $esp_spec ]]; then esp_dev=$esp_spec
    elif [[ -n $esp_spec && -d $esp_spec ]]; then esp_dev=$(src_of "$esp_spec")
    else
      for mp in /boot/efi /efi; do
        if mountpoint -q "$ROOT$mp" && [[ $(findmnt -fno FSTYPE "$ROOT$mp") == vfat ]]; then esp_dev=$(src_of "$ROOT$mp"); esp_rel=$mp; break; fi
      done
      if [[ -z $esp_dev ]]; then
        spec=$(awk '$1 !~ /^#/ && $3 == "vfat" && ($2 == "/boot/efi" || $2 == "/efi") { print $1 " " $2; exit }' "$ROOT/etc/fstab" 2>/dev/null)
        if [[ -n $spec ]]; then
          esp_rel=${spec#* }
          spec=${spec%% *}
          case "$spec" in UUID=*) esp_dev=$(blkid -U "${spec#UUID=}" 2>/dev/null) ;; /dev/*) esp_dev=$spec ;; esac
        fi
      fi
      [[ -b ${esp_dev:-} ]] || esp_dev=$(find_esp_on "$(disk_of "$rootdev")")
    fi
    [[ -b ${esp_dev:-} ]] || die "EFI 시스템 파티션을 찾지 못했습니다. --esp <파티션>으로 지정하세요."
    [[ $(fstype_of "$esp_dev") == vfat ]] || die "$esp_dev 은(는) FAT 파일 시스템이 아닙니다 (EFI 시스템 파티션이 아님)"
    if ! mountpoint -q "$ROOT$esp_rel"; then
      if (( DRY )); then note "[dry-run] mount $esp_dev $ROOT$esp_rel"
      else
        mkdir -p "$ROOT$esp_rel"
        mount "$esp_dev" "$ROOT$esp_rel" || die "$esp_dev 을(를) 마운트하지 못했습니다"
        CLEAN+=("umount '$ROOT$esp_rel'")
      fi
    elif [[ $(src_of "$ROOT$esp_rel") != "$(readlink -f "$esp_dev")" ]]; then
      die "$ROOT$esp_rel 에 다른 장치가 마운트되어 있습니다"
    fi
  fi
  if [[ -z $bios_disk ]] && ! is_uefi; then bios_disk=$(disk_of "$rootdev"); fi
  if [[ -n $bios_disk ]]; then
    [[ -b $bios_disk && $(lsblk -dno TYPE "$bios_disk") == disk ]] || die "$bios_disk 은(는) 디스크가 아닙니다 (예: /dev/sda)"
    if [[ $(disk_of "$rootdev") != "$(readlink -f "$bios_disk")" ]] && (( ! FORCE )) && is_running_dev "$bios_disk"; then
      die 4 "$bios_disk 에는 실행 중인 시스템이 있습니다. 그 디스크의 MBR을 바꾸려면 --force를 붙이세요."
    fi
  fi
  msg "DelayOS: $ROOT ($rootdev)$( [[ -n $esp_dev ]] && echo ", EFI: $esp_dev")$( [[ -n $bios_disk ]] && echo ", BIOS: $bios_disk")"

  # --- 1. fstab
  step=$((step + 1)); msg "[$step/$total] fstab 점검"
  if (( BOOT_FSTAB )); then fstab_check "$ROOT" "$rootdev" "$esp_dev"; else note "건너뜀"; fi

  # --- 2. kernel images
  step=$((step + 1)); msg "[$step/$total] 커널 이미지 확인"
  restore_kernels
  ls "$ROOT"/boot/vmlinuz-* >/dev/null 2>&1 || (( DRY )) || die "커널이 없습니다 ($ROOT/boot/vmlinuz-*). 'pacman -S linux-delayos'로 다시 설치해야 합니다."

  # --- 3. boot loader
  step=$((step + 1)); msg "[$step/$total] 부트로더(GRUB) 설치"
  if [[ -n $esp_dev ]]; then
    local nv=(); (( BOOT_NVRAM )) || nv=(--no-nvram)
    rrun grub-install --target=x86_64-efi --efi-directory="$esp_rel" --bootloader-id=DelayOS --recheck "${nv[@]}" || { warn "grub-install(UEFI)이 실패했습니다"; rc=1; }
    if grep -Eq "^SB=['\"]?1" "$ROOT/etc/delayos/winsetup.conf" 2>/dev/null && [[ -x $ROOT/usr/local/bin/delay-winsetup ]]; then
      note "Secure Boot 구성: 서명된 GRUB과 커널을 다시 설치합니다"
      rrun /usr/bin/python3 /usr/local/bin/delay-winsetup sb-setup || { warn "Secure Boot 부팅 파일을 다시 설치하지 못했습니다"; rc=1; }
    elif (( ! DRY )); then
      # removable-media path: firmware that lost its boot entries (CMOS reset) still finds DelayOS.
      # Never replace somebody else's loader there (Windows keeps its own copy in EFI/Microsoft).
      local e=$ROOT$esp_rel/EFI
      if [[ -f $e/DelayOS/grubx64.efi ]] && { [[ ! -e $e/BOOT/BOOTX64.EFI ]] || grep -qa 'GRUB' "$e/BOOT/BOOTX64.EFI"; }; then
        mkdir -p "$e/BOOT" && cp -f "$e/DelayOS/grubx64.efi" "$e/BOOT/BOOTX64.EFI" && note "대체 부팅 경로(EFI/BOOT/BOOTX64.EFI)를 갱신했습니다"
      fi
      install_re_loader "$esp_dev" "$esp_rel"
    fi
  fi
  if [[ -n $bios_disk ]]; then
    rrun grub-install --target=i386-pc --recheck "$bios_disk" || { warn "grub-install(BIOS)이 실패했습니다"; rc=1; }
  fi

  # --- 4. initramfs
  step=$((step + 1)); msg "[$step/$total] initramfs 다시 만들기"
  if (( BOOT_INITRAMFS )); then
    rrun mkinitcpio -P || warn "mkinitcpio가 오류를 보고했습니다 (fallback 이미지 등 일부가 빠졌을 수 있습니다)"
    ls "$ROOT"/boot/initramfs-*.img >/dev/null 2>&1 || (( DRY )) || { warn "initramfs가 만들어지지 않았습니다"; rc=1; }
  else note "건너뜀"; fi

  # --- 5. boot menu
  step=$((step + 1)); msg "[$step/$total] 부팅 메뉴(grub.cfg) 다시 만들기"
  rrun grub-mkconfig -o /boot/grub/grub.cfg || { warn "grub-mkconfig가 실패했습니다"; rc=1; }

  # --- 6. firmware
  step=$((step + 1)); msg "[$step/$total] 펌웨어 부팅 순서"
  if [[ -n $esp_dev ]] && (( BOOT_NVRAM )); then efi_order_first || true; else note "건너뜀"; fi

  (( DRY )) || sync
  if (( rc == 0 )); then msg "완료: DelayOS 부팅 파일을 설치했습니다."; else warn "일부 단계가 실패했습니다. 위 메시지를 확인하세요."; fi
  return $rc
}
BOOT_NVRAM=1; BOOT_INITRAMFS=1; BOOT_FSTAB=1
cmd_boot() {
  local esp="" bios="" root=""
  while (( $# )); do
    case "$1" in
      --esp) esp=${2:-}; shift ;;
      --bios) bios=${2:-}; shift ;;
      --no-nvram) BOOT_NVRAM=0 ;;
      --no-initramfs) BOOT_INITRAMFS=0 ;;
      --no-fstab) BOOT_FSTAB=0 ;;
      -*) die 2 "알 수 없는 옵션: $1" ;;
      *) root=$1 ;;
    esac; shift
  done
  [[ -n $root ]] || die 2 "사용법: $PROG boot <루트 마운트 지점> [--esp <경로>] [--bios <디스크>]"
  need_root
  ROOT=$root
  do_boot "$esp" "$bios"
}

# ------------------------------------------------------------------ apply
image_kind() {
  case "$1" in
    *.tar|*.tar.zst|*.tar.gz|*.tar.xz|*.tzst) echo tar ;;
    *.sfs|*.squashfs) echo sfs ;;
    *) if [[ $(head -c4 "$1" 2>/dev/null) == hsqs ]]; then echo sfs; else echo stream; fi ;;
  esac
}
cmd_apply() {
  local image="" target="" esp="" bios="" format=0 replace=0 noboot=0 overlay="" a
  while (( $# )); do
    case "$1" in
      --esp) esp=${2:-}; shift ;;
      --bios) bios=${2:-}; shift ;;
      --format) format=1 ;;
      --replace-system) replace=1 ;;
      --no-boot) noboot=1 ;;
      --overlay) overlay=${2:-}; shift ;;
      --no-nvram) BOOT_NVRAM=0 ;;
      -*) die 2 "알 수 없는 옵션: $1" ;;
      *) if [[ -z $image ]]; then image=$1; elif [[ -z $target ]]; then target=$1; else die 2 "인수가 너무 많습니다: $1"; fi ;;
    esac; shift
  done
  [[ -n $image && -n $target ]] || die 2 "사용법: $PROG apply <이미지> <대상 파티션> [--esp <파티션>] [--format | --replace-system]"
  need_root
  [[ -f $image ]] || die "$image: 이미지 파일이 없습니다"
  [[ -b $target ]] || die "$target: 블록 장치(파티션)가 아닙니다"
  target=$(readlink -f "$target")
  (( format && replace )) && die 2 "--format과 --replace-system은 함께 쓸 수 없습니다"
  [[ $(lsblk -dno TYPE "$target") == disk ]] && die "$target 은(는) 디스크 전체입니다. 파티션을 지정하세요."
  a=$(protected_part "$target") && die 4 "$target 은(는) 대상으로 쓸 수 없습니다: $a"
  findmnt -S "$target" >/dev/null 2>&1 && die 4 "$target 이(가) 마운트되어 있습니다. 먼저 마운트를 해제하세요."
  is_running_dev "$target" && die 4 "$target 은(는) 실행 중인 시스템이 쓰고 있습니다."
  if (( ! FORCE )) && running_devs | grep -qxF "$(disk_of "$target")"; then
    die 4 "$target 은(는) 실행 중인 시스템과 같은 디스크에 있습니다. 맞다면 --force를 붙이세요."
  fi
  local kind fst tdisk top r e sv mp old="" live=0
  kind=$(image_kind "$image"); fst=$(fstype_of "$target"); tdisk=$(disk_of "$target")
  case "$kind" in
    stream) have btrfs && have zstd || die "btrfs-progs와 zstd가 필요합니다" ;;
    tar) have bsdtar || die "bsdtar(libarchive)가 필요합니다" ;;
  esac
  if is_uefi && (( ! noboot )); then
    [[ -n $esp ]] || esp=$(find_esp_on "$tdisk")
    [[ -b ${esp:-} ]] || die "EFI 시스템 파티션을 찾지 못했습니다. --esp <파티션>으로 지정하세요."
  fi
  if (( ! format && ! replace )); then
    case "$fst" in
      "") format=1 ;;
      btrfs) ;;
      *) die 4 "$target 에 $fst 파일 시스템이 있습니다. 지우고 쓰려면 --format을 붙이세요." ;;
    esac
  fi
  (( replace )) && [[ $fst != btrfs ]] && die "$target 은(는) btrfs가 아니어서 --replace-system을 쓸 수 없습니다"
  msg "이미지 $image ($kind) → $target$( (( format )) && echo ' (포맷함)')$( (( replace )) && echo ' (시스템만 교체)')"
  if (( DRY )); then
    (( format )) && note "[dry-run] mkfs.btrfs -f -L DelayOS $target"
    note "[dry-run] 하위 볼륨 ${SUBVOLS[*]%%:*} 만들기, 이미지 풀기, fstab 쓰기"
    (( noboot )) || note "[dry-run] $PROG boot <대상> ${esp:+--esp $esp} ${bios:+--bios $bios}"
    return 0
  fi
  (( format )) && { mkfs.btrfs -q -f -L DelayOS "$target" || die "포맷하지 못했습니다"; udevadm settle 2>/dev/null; }
  top=$(mktemp -d /tmp/delay-top.XXXXXX)
  mount -o subvolid=5,compress=zstd:1,noatime "$target" "$top" || die "$target 을(를) 마운트하지 못했습니다"
  CLEAN+=("umount '$top'; rmdir '$top'")
  if [[ -e $top/@ ]]; then
    (( replace )) || die 4 "$target 에 이미 DelayOS(@)가 있습니다. 시스템만 바꾸려면 --replace-system, 모두 지우려면 --format."
    old=$top/@old-$(date +%Y%m%d-%H%M%S)
    mv "$top/@" "$old" || die "기존 시스템의 이름을 바꾸지 못했습니다"
  fi
  for e in "${SUBVOLS[@]}"; do
    sv=${e%%:*}; [[ $sv == @ ]] && continue
    [[ -d $top/$sv ]] || btrfs subvolume create "$top/$sv" >/dev/null || die "$sv 하위 볼륨을 만들지 못했습니다"
  done
  fail_apply() { [[ -d $top/@ ]] && btrfs subvolume delete "$top/@" >/dev/null 2>&1; [[ -n $old ]] && mv "$old" "$top/@"; die "$*"; }
  msg "이미지를 푸는 중… (몇 분 걸릴 수 있습니다)"
  case "$kind" in
    stream)
      mkdir -p "$top/.delay-recv"
      if [[ $(head -c4 "$image" | od -An -tx1 | tr -d ' ') == 28b52ffd ]]; then zstd -dc "$image"; else cat "$image"; fi \
        | btrfs receive "$top/.delay-recv" >/dev/null || { btrfs subvolume delete "$top"/.delay-recv/* >/dev/null 2>&1; rmdir "$top/.delay-recv"; fail_apply "이미지를 풀지 못했습니다 (btrfs receive)"; }
      sv=$(ls "$top/.delay-recv" | head -n1)
      btrfs subvolume snapshot "$top/.delay-recv/$sv" "$top/@" >/dev/null || fail_apply "받은 이미지를 시스템으로 만들지 못했습니다"
      btrfs subvolume delete "$top/.delay-recv/$sv" >/dev/null; rmdir "$top/.delay-recv"
      ;;
    tar)
      btrfs subvolume create "$top/@" >/dev/null || fail_apply "@ 하위 볼륨을 만들지 못했습니다"
      bsdtar -xpf "$image" --numeric-owner --acls --xattrs -C "$top/@" || fail_apply "이미지를 풀지 못했습니다 (tar)"
      ;;
    sfs)
      btrfs subvolume create "$top/@" >/dev/null || fail_apply "@ 하위 볼륨을 만들지 못했습니다"
      r=$(mktemp -d /tmp/delay-sfs.XXXXXX)
      mount -o loop,ro "$image" "$r" || { rmdir "$r"; fail_apply "squashfs 이미지를 마운트하지 못했습니다"; }
      cp -a "$r/." "$top/@/"; a=$?
      umount "$r"; rmdir "$r"
      (( a == 0 )) || fail_apply "이미지를 복사하지 못했습니다"
      ;;
  esac
  [[ -e $top/@/usr/lib/os-release || -e $top/@/etc/os-release ]] || fail_apply "이미지에 시스템이 들어 있지 않습니다"
  # data that the image carries inside the system moves to its own subvolume (fresh targets only)
  for e in "@home:/home" "@cache:/var/cache" "@log:/var/log"; do
    sv=${e%%:*}; mp=${e#*:}
    if [[ -n $(ls -A "$top/@$mp" 2>/dev/null) && -z $(ls -A "$top/$sv" 2>/dev/null) ]]; then
      cp -a "$top/@$mp/." "$top/$sv/" && find "$top/@$mp" -mindepth 1 -delete 2>/dev/null
    fi
  done
  for e in "${SUBVOLS[@]}"; do mkdir -p "$top/@${e#*:}"; done
  mkdir -p "$top/@/boot/efi"
  # fstab: the replaced system's own when there is one, otherwise a new one
  if [[ -n $old && -s $old/etc/fstab ]]; then cp -a "$old/etc/fstab" "$top/@/etc/fstab"; else gen_fstab "$top/@" "$target" "$esp"; fi
  if [[ -n $overlay ]]; then
    [[ -d $overlay ]] || fail_apply "$overlay: 폴더가 없습니다"
    cp -a "$overlay/." "$top/@/" || fail_apply "--overlay 폴더를 복사하지 못했습니다"
  fi
  [[ -f $top/@/etc/mkinitcpio.conf.d/archiso.conf ]] && live=1
  if (( live )); then
    # the live medium's own image: kernels are on the medium, the rest is what the installer would do
    [[ -d /run/archiso/bootmnt/arch/boot ]] || fail_apply "라이브 이미지(airootfs.sfs)는 DelayOS 설치 미디어로 부팅한 상태에서만 적용할 수 있습니다"
    mkdir -p "$top/@/tmp/delay-boot" && cp -a /run/archiso/bootmnt/arch/boot/. "$top/@/tmp/delay-boot/"
    cp -a "$top/@/tmp/delay-boot" "$top/.delay-boot"
  fi
  sync
  # --- mount it the way it will run and install the boot files
  r=$(mktemp -d /tmp/delay-root.XXXXXX)
  mount -o "subvol=/@,$BTRFS_OPTS" "$target" "$r" || fail_apply "새 시스템을 마운트하지 못했습니다"
  CLEAN+=("umount -R '$r'; rmdir '$r'")
  for e in "${SUBVOLS[@]}"; do
    sv=${e%%:*}; mp=${e#*:}; [[ $sv == @ ]] && continue
    mount -o "subvol=/$sv,$BTRFS_OPTS" "$target" "$r$mp" 2>/dev/null
  done
  ROOT=$r
  if (( live )); then
    msg "라이브 이미지 설치 마무리 (delay-postinstall)"
    enter_root
    mkdir -p "$r/tmp/delay-boot" && cp -a "$top/.delay-boot/." "$r/tmp/delay-boot/"; rm -rf "$top/.delay-boot"
    [[ -s $r/etc/machine-id ]] || in_root systemd-machine-id-setup >/dev/null 2>&1
    if [[ -x $r/usr/local/bin/delay-postinstall ]]; then
      in_root /usr/bin/env DELAYOS_SOFTWARE=recommended DELAYOS_WINGAMES=0 DELAYOS_CPUOPT=off /usr/local/bin/delay-postinstall \
        || warn "delay-postinstall이 오류를 보고했습니다"
    fi
    rm -rf "$r/tmp/delay-boot"
    # what Calamares' initcpiocfg would add
    [[ -x $r/usr/bin/plymouth ]] && ! grep -q '^HOOKS=.*plymouth' "$r/etc/mkinitcpio.conf" \
      && sed -i 's/^\(HOOKS=(.*\bsystemd\)\b/\1 plymouth/' "$r/etc/mkinitcpio.conf"
  fi
  a=0
  if (( ! noboot )); then
    FORCE=1 do_boot "$esp" "$bios" || a=1
  fi
  [[ -n $old ]] && { btrfs subvolume delete "$old" >/dev/null 2>&1 || warn "이전 시스템($old)을 지우지 못했습니다"; }
  (( live )) && note "사용자 계정은 아직 없습니다: arch-chroot <루트> useradd -m -G wheel <이름> && passwd <이름>"
  cleanup
  (( a == 0 )) && msg "완료: 이미지를 $target 에 적용했습니다."
  return $a
}

# ------------------------------------------------------------------ capture
cmd_capture() {
  local root="" image="" level=6 src fsroot top snap dev rc=0
  while (( $# )); do
    case "$1" in
      --level) level=${2:-6}; shift ;;
      -*) die 2 "알 수 없는 옵션: $1" ;;
      *) if [[ -z $root ]]; then root=$1; elif [[ -z $image ]]; then image=$1; else die 2 "인수가 너무 많습니다: $1"; fi ;;
    esac; shift
  done
  [[ -n $root && -n $image ]] || die 2 "사용법: $PROG capture <루트 마운트 지점> <이미지 파일>"
  [[ $level =~ ^[0-9]+$ ]] && (( level >= 1 && level <= 19 )) || die 2 "--level은 1~19"
  need_root
  [[ -e $root/usr/lib/os-release || -e $root/etc/os-release ]] || die "$root 에 시스템이 없습니다"
  [[ -d $(dirname "$image") ]] || die "$(dirname "$image"): 폴더가 없습니다"
  [[ -e $image ]] && (( ! FORCE )) && die "$image: 이미 있습니다 (덮어쓰려면 --force)"
  dev=$(src_of "$root"); src=$root
  local kind; kind=$(image_kind "$image"); [[ -e $image ]] || case "$image" in *.tar*|*.tzst) kind=tar ;; *.sfs|*.squashfs) kind=sfs ;; *) kind=stream ;; esac
  if [[ $(findmnt -fno FSTYPE -T "$root") == btrfs && $(stat -c %i "$root") == 256 ]]; then
    fsroot=$(findmnt -fno FSROOT -T "$root")
    msg "캡처: $root ($dev, 하위 볼륨 $fsroot) → $image ($kind)"
    (( DRY )) && { note "[dry-run] 읽기 전용 스냅샷 → $( [[ $kind == stream ]] && echo 'btrfs send | zstd' || echo "$kind")"; return 0; }
    top=$(mktemp -d /tmp/delay-top.XXXXXX)
    mount -o subvolid=5,noatime "$dev" "$top" || die "btrfs 최상위를 마운트하지 못했습니다"
    snap=$top/@capture-$(date +%Y%m%d-%H%M%S)
    CLEAN+=("btrfs subvolume delete '$snap'; umount '$top'; rmdir '$top'")
    btrfs subvolume snapshot -r "$top$fsroot" "$snap" >/dev/null || die "스냅샷을 만들지 못했습니다"
    src=$snap
  else
    [[ $kind == stream ]] && die "$root 은(는) btrfs 하위 볼륨이 아닙니다. .tar.zst 또는 .sfs 형식으로 캡처하세요."
    msg "캡처: $root → $image ($kind)"
    (( DRY )) && { note "[dry-run] $kind 만들기"; return 0; }
  fi
  case "$kind" in
    stream) btrfs send -q "$src" | zstd -q -T0 "-$level" -o "$image" -f; rc=$(( PIPESTATUS[0] | PIPESTATUS[1] )) ;;
    tar)    bsdtar -cpf - --one-file-system --acls --xattrs -C "$src" . | zstd -q -T0 "-$level" -o "$image" -f; rc=$(( PIPESTATUS[0] | PIPESTATUS[1] )) ;;
    sfs)    have mksquashfs || die "squashfs-tools가 필요합니다"
            mksquashfs "$src" "$image" -noappend -one-file-system -comp zstd -Xcompression-level "$level" -b 1M -no-progress >/dev/null; rc=$? ;;
  esac
  cleanup
  (( rc == 0 )) || { rm -f "$image"; die "캡처하지 못했습니다"; }
  msg "완료: $image ($(du -h "$image" | cut -f1))"
  note "다른 PC나 파티션에 풀기: sudo $PROG apply $image <파티션> --format"
}

# ------------------------------------------------------------------ recovery partition
re_find() { # device of the recovery partition; the one on the disk of the system wins
  local d sysdisk="" all first=""
  d=$(src_of "${1:-/}" 2>/dev/null) && [[ -b $d ]] && sysdisk=$(disk_of "$d")
  [[ -z $sysdisk ]] && { d=$(src_of /run/archiso/bootmnt 2>/dev/null) && [[ -b $d ]] && sysdisk=$(disk_of "$d"); }
  all=$(blkid -t "LABEL=$RE_LABEL" -o device 2>/dev/null)
  for d in $all; do
    [[ -z $first ]] && first=$d
    [[ -n $sysdisk && $(disk_of "$d") == "$sysdisk" ]] && { echo "$d"; return 0; }
  done
  [[ -n $first ]] && { echo "$first"; return 0; }
  return 1
}
re_install() { # $1 partition  $2 image dir  $3 format (1|0)  $4 root of the system (for the signed kernel)
  local part=$1 img=$2 fmt=$3 sysroot=${4:-/} m k i s disk n sb a
  [[ -f $img/$RE_DIR/x86_64/airootfs.sfs ]] || die 5 "복구 환경 이미지가 없습니다 ($img/$RE_DIR). 이 DelayOS 빌드에는 복구 환경이 들어 있지 않습니다."
  k=$(ls "$img/$RE_DIR"/boot/x86_64/vmlinuz-* 2>/dev/null | head -n1); i=$(ls "$img/$RE_DIR"/boot/x86_64/initramfs-*.img 2>/dev/null | head -n1)
  [[ -f $k && -f $i ]] || die 5 "복구 환경 이미지에 커널이 없습니다"
  if (( DRY )); then
    (( fmt )) && note "[dry-run] mkfs.ext4 -L $RE_LABEL $part"
    note "[dry-run] $img/$RE_DIR → $part:/$RE_DIR"; return 0
  fi
  if (( fmt )); then
    a=$(fstype_of "$part")
    case "$a" in ""|ext4) ;; *) [[ $(blkid -s LABEL -o value "$part") == "$RE_LABEL" ]] || die 4 "$part 에 $a 파일 시스템이 있습니다. 복구 파티션이 아닙니다." ;; esac
    # GRUB reads the kernel from here and writes its boot counter here: keep to features every GRUB knows
    mkfs.ext4 -q -F -L "$RE_LABEL" -m 0 -O '^metadata_csum_seed,^orphan_file' "$part" 2>/dev/null \
      || mkfs.ext4 -q -F -L "$RE_LABEL" -m 0 "$part" || die "복구 파티션을 포맷하지 못했습니다"
    udevadm settle 2>/dev/null
  fi
  [[ $(blkid -s LABEL -o value "$part") == "$RE_LABEL" ]] || die 4 "$part 은(는) 복구 파티션($RE_LABEL)이 아닙니다"
  m=$(mktemp -d /tmp/delay-re.XXXXXX)
  mount "$part" "$m" || { rmdir "$m"; die "복구 파티션을 마운트하지 못했습니다"; }
  CLEAN+=("umount '$m'; rmdir '$m'")
  mkdir -p "$m/$RE_DIR/boot" "$m/$RE_DIR/x86_64" "$m/$RE_DIR/logs"
  # new image next to the old one, then swap: an interrupted update leaves a bootable environment
  cp -f "$img/$RE_DIR/x86_64/airootfs.sfs" "$m/$RE_DIR/x86_64/airootfs.sfs.new" && cp -f "$k" "$m/$RE_DIR/boot/vmlinuz.new" \
    && cp -f "$i" "$m/$RE_DIR/boot/initramfs.img.new" || die "복구 환경을 복사하지 못했습니다 (공간 부족?)"
  # Secure Boot (delayos-sb-general): the signed copy of the same kernel image
  sb=$sysroot/usr/share/delayos/secureboot/general
  if [[ -f $sb/vmlinuz-linux-delayos.signed && -f $sb/vmlinuz-linux-delayos.sha256 ]]; then
    s=$(sha256sum "$k" | cut -d' ' -f1)
    [[ $s == "$(cut -d' ' -f1 "$sb/vmlinuz-linux-delayos.sha256")" ]] && cp -f "$sb/vmlinuz-linux-delayos.signed" "$m/$RE_DIR/boot/vmlinuz.new"
  fi
  sync
  mv -f "$m/$RE_DIR/x86_64/airootfs.sfs.new" "$m/$RE_DIR/x86_64/airootfs.sfs"
  mv -f "$m/$RE_DIR/boot/vmlinuz.new" "$m/$RE_DIR/boot/vmlinuz"
  mv -f "$m/$RE_DIR/boot/initramfs.img.new" "$m/$RE_DIR/boot/initramfs.img"
  cp -f "$img/$RE_DIR/version" "$m/$RE_DIR/version" 2>/dev/null || date '+%Y.%m.%d' > "$m/$RE_DIR/version"
  if [[ ! -f $m/$RE_DIR/grubenv ]]; then
    if have grub-editenv; then grub-editenv "$m/$RE_DIR/grubenv" create && grub-editenv "$m/$RE_DIR/grubenv" set delay_boot_ok=1 delay_boot_tries=0
    else { printf '# GRUB Environment Block\ndelay_boot_ok=1\ndelay_boot_tries=0\n'; head -c 1024 /dev/zero | tr '\0' '#'; } | head -c 1024 > "$m/$RE_DIR/grubenv"; fi
  fi
  sync; umount "$m" && rmdir "$m"; unset 'CLEAN[-1]'
  # GPT: name it and mark it "required" so partition tools do not offer to delete it lightly
  disk=$(disk_of "$part"); n=$(partn_of "$part")
  if [[ -n $disk && -n $n && $(lsblk -dno PTTYPE "$disk") == gpt ]]; then
    sfdisk --no-reread --part-label "$disk" "$n" "$RE_LABEL" >/dev/null 2>&1
    sfdisk --no-reread --part-attrs "$disk" "$n" "RequiredPartition,63" >/dev/null 2>&1
  fi
  note "복구 환경($(cat "$img/$RE_DIR/version" 2>/dev/null))을 $part 에 설치했습니다"
}
re_create() { # $1 mount point or device of the system  $2 image dir
  local spec=$1 img=$2 fsdev part disk n pt ss start512 size512 disk_b part_b re_b new_b re_start_b re_len_b mp tmpmp="" newpart="" p busy=() luks="" fs_target
  if [[ -d $spec ]]; then fsdev=$(src_of "$spec"); else fsdev=$(readlink -f "$spec"); fi
  [[ -b $fsdev ]] || die "$spec: 장치를 찾지 못했습니다"
  [[ $(fstype_of "$fsdev") == btrfs ]] || die 3 "시스템 파티션이 btrfs가 아니어서 복구 파티션을 만들지 않습니다"
  [[ -f $img/$RE_DIR/x86_64/airootfs.sfs ]] || die 5 "복구 환경 이미지가 없습니다 ($img/$RE_DIR)"
  part=$fsdev
  if [[ $(lsblk -dno TYPE "$fsdev") == crypt ]]; then luks=$fsdev; part=$(part_of "$fsdev"); fi
  [[ -b $part && $(lsblk -dno TYPE "$part") == part ]] || die 3 "시스템이 일반 파티션에 있지 않아(LVM/RAID) 복구 파티션을 만들지 않습니다"
  disk=$(disk_of "$part"); n=$(partn_of "$part"); pt=$(lsblk -dno PTTYPE "$disk")
  p=$(blkid -t "LABEL=$RE_LABEL" -o device 2>/dev/null | while read -r d; do [[ $(disk_of "$d") == "$disk" ]] && echo "$d"; done | head -n1)
  if [[ -n $p ]]; then note "복구 파티션이 이미 있습니다 ($p): 복구 환경만 다시 설치합니다"; re_install "$p" "$img" 0 "$([[ -d $spec ]] && echo "$spec" || echo /)"; return; fi
  ss=$(blockdev --getss "$disk"); disk_b=$(blockdev --getsize64 "$disk")
  start512=$(<"/sys/class/block/$(basename "$part")/start"); size512=$(<"/sys/class/block/$(basename "$part")/size")
  part_b=$(( size512 * 512 )); re_b=$(( RE_SIZE_MIB * 1048576 ))
  (( disk_b >= RE_MIN_DISK_GIB * 1073741824 )) || die 3 "디스크가 64 GB보다 작아 복구 파티션을 만들지 않습니다 ($(( disk_b / 1000000000 )) GB)"
  (( part_b - re_b >= RE_MIN_ROOT_GIB * 1073741824 )) || die 3 "시스템 파티션이 작아 복구 파티션을 만들지 않습니다"
  case "$pt" in
    gpt) ;;
    dos) (( n <= 4 )) && (( $(lsblk -lno TYPE "$disk" | grep -c '^part$') < 4 )) || die 3 "MBR 디스크에 주 파티션 자리가 없어 복구 파티션을 만들지 않습니다" ;;
    *) die 3 "파티션 표 형식($pt)을 지원하지 않습니다" ;;
  esac
  new_b=$(( (part_b - re_b) / 1048576 * 1048576 ))
  re_start_b=$(( start512 * 512 + new_b )); re_len_b=$(( part_b - new_b ))
  (( re_start_b % ss == 0 )) || die 3 "파티션 정렬이 맞지 않아 복구 파티션을 만들지 않습니다"
  fs_target=$(( new_b - 16 * 1048576 )); [[ -n $luks ]] && fs_target=$(( new_b - 80 * 1048576 ))
  msg "복구 파티션 만들기: $part 끝에서 $(( re_len_b / 1048576 )) MiB"
  if (( DRY )); then
    note "[dry-run] btrfs filesystem resize $fs_target, sfdisk -N $n $disk (, $(( new_b / ss ))), 새 파티션 $(( re_start_b / ss ))+$(( re_len_b / ss ))"
    return 0
  fi
  mp=$(findmnt -fno TARGET -S "$fsdev" 2>/dev/null | head -n1)
  if [[ -z $mp ]]; then
    tmpmp=$(mktemp -d /tmp/delay-shrink.XXXXXX); mount "$fsdev" "$tmpmp" || die "시스템 파티션을 마운트하지 못했습니다"; mp=$tmpmp
  else busy=(--force); fi
  [[ -n $luks ]] && busy=(--force)
  if ! btrfs filesystem resize "$fs_target" "$mp" >/dev/null; then
    [[ -n $tmpmp ]] && { umount "$tmpmp"; rmdir "$tmpmp"; }
    die 3 "시스템 파티션에 빈 공간이 모자라 복구 파티션을 만들지 않습니다"
  fi
  sync
  sfdisk -d "$disk" > "/tmp/delay-ptable-$(basename "$disk").bak" 2>/dev/null
  if ! echo ", $(( new_b / ss ))" | sfdisk -q --no-reread --no-tell-kernel "${busy[@]}" -N "$n" "$disk" >/dev/null 2>&1; then
    btrfs filesystem resize max "$mp" >/dev/null 2>&1
    [[ -n $tmpmp ]] && { umount "$tmpmp"; rmdir "$tmpmp"; }
    die 3 "파티션 크기를 줄이지 못했습니다"
  fi
  if ! echo "$(( re_start_b / ss )), $(( re_len_b / ss )), L" | sfdisk -q --no-reread --no-tell-kernel --force --append "$disk" >/dev/null 2>&1; then
    warn "새 파티션을 만들지 못했습니다: 파티션 표를 되돌립니다"
    sfdisk -q --no-reread --no-tell-kernel --force "$disk" < "/tmp/delay-ptable-$(basename "$disk").bak" >/dev/null 2>&1
    partx -u "$disk" 2>/dev/null; btrfs filesystem resize max "$mp" >/dev/null 2>&1
    [[ -n $tmpmp ]] && { umount "$tmpmp"; rmdir "$tmpmp"; }
    die 3 "복구 파티션을 만들지 못했습니다"
  fi
  # tell the kernel: shrink the system partition first, then add the new one
  partx -u --nr "$n" "$disk" 2>/dev/null || partx -u "$disk" 2>/dev/null
  partx -a "$disk" 2>/dev/null || true
  partprobe "$disk" 2>/dev/null || true
  udevadm settle 2>/dev/null
  for p in /sys/class/block/"$(basename "$disk")"/*/start; do
    [[ -f $p && $(<"$p") == $(( re_start_b / 512 )) ]] && newpart=/dev/$(basename "$(dirname "$p")")
  done
  # the system partition got its final size: let the file system use all of it again
  if [[ -n $luks ]]; then
    if [[ -n ${DELAY_LUKS_PASSFILE:-} && -f $DELAY_LUKS_PASSFILE ]]; then cryptsetup resize --key-file "$DELAY_LUKS_PASSFILE" "$(basename "$luks")" 2>/dev/null
    else cryptsetup resize "$(basename "$luks")" </dev/null 2>/dev/null; fi \
      && btrfs filesystem resize max "$mp" >/dev/null 2>&1 \
      || note "암호화된 볼륨의 크기는 다음 부팅 때 맞춰집니다"
  else
    btrfs filesystem resize max "$mp" >/dev/null 2>&1
  fi
  [[ -n $tmpmp ]] && { umount "$tmpmp"; rmdir "$tmpmp"; }
  [[ -b $newpart ]] || die "새 파티션이 나타나지 않습니다. 다시 시작한 뒤 '$PROG recovery install'을 실행하세요."
  wipefs -q -a "$newpart" 2>/dev/null
  re_install "$newpart" "$img" 1 "$([[ -d $spec ]] && echo "$spec" || echo /)"
  msg "복구 파티션을 만들었습니다: $newpart"
}
cmd_recovery() {
  local sub=${1:-status}; (( $# )) && shift
  local img=$RE_IMAGE pos=() fmt=0
  while (( $# )); do
    case "$1" in
      --image) img=${2:-}; shift ;;
      --format) fmt=1 ;;
      -*) die 2 "알 수 없는 옵션: $1" ;;
      *) pos+=("$1") ;;
    esac; shift
  done
  case "$sub" in
    status)
      local dev="" uuid="" ver="" avail="" size=0 m
      dev=$(re_find /) || dev=""
      [[ -f $img/$RE_DIR/version ]] && avail=$(<"$img/$RE_DIR/version")
      if [[ -n $dev ]]; then
        uuid=$(uuid_of "$dev"); size=$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)
        if [[ $EUID -eq 0 ]]; then
          m=$(findmnt -fno TARGET -S "$dev" 2>/dev/null | head -n1)
          if [[ -n $m ]]; then ver=$(cat "$m/$RE_DIR/version" 2>/dev/null)
          else m=$(mktemp -d /tmp/delay-re.XXXXXX); mount -o ro "$dev" "$m" 2>/dev/null && { ver=$(cat "$m/$RE_DIR/version" 2>/dev/null); umount "$m"; }; rmdir "$m" 2>/dev/null; fi
        fi
      fi
      if (( JSON )); then
        printf '{"present":%s,"device":"%s","uuid":"%s","sizeBytes":%s,"version":"%s","imageVersion":"%s","uefi":%s}\n' \
          "$([[ -n $dev ]] && echo true || echo false)" "$dev" "$uuid" "$size" "$ver" "$avail" "$(is_uefi && echo true || echo false)"
      elif [[ -n $dev ]]; then
        echo "복구 파티션: $dev ($(( size / 1048576 )) MiB), 복구 환경 버전: ${ver:-알 수 없음}"
        [[ -n $avail && -n $ver && $avail != "$ver" ]] && echo "새 복구 환경($avail)이 있습니다: sudo $PROG recovery install"
      else
        echo "복구 파티션이 없습니다.$( [[ -n $avail ]] && echo " 만들기: sudo $PROG recovery create /")"
        return 1
      fi ;;
    create)
      need_root
      re_create "${pos[0]:-/}" "$img" ;;
    loader)
      # the recovery environment's own loader on the EFI partition + firmware entry (UEFI, running system or chroot)
      need_root
      is_uefi || { note "UEFI가 아니어서 건너뜁니다"; return 0; }
      ROOT=/
      local e
      for e in /boot/efi /efi; do
        if mountpoint -q "$e" && [[ $(findmnt -fno FSTYPE "$e") == vfat ]]; then
          grep -Eq "^SB=['\"]?1" /etc/delayos/winsetup.conf 2>/dev/null && { note "Secure Boot 구성에서는 설치하지 않습니다"; return 0; }
          install_re_loader "$(src_of "$e")" "$e"; efi_order_first || true; return 0
        fi
      done
      die "EFI 시스템 파티션이 마운트되어 있지 않습니다" ;;
    install)
      need_root
      local part=${pos[0]:-}
      [[ -n $part ]] || part=$(re_find /) || die "복구 파티션을 찾지 못했습니다. 먼저 '$PROG recovery create /'로 만드세요."
      [[ -b $part ]] || die "$part: 파티션이 아닙니다"
      findmnt -S "$part" >/dev/null 2>&1 && die 4 "$part 이(가) 마운트되어 있습니다"
      re_install "$part" "$img" "$fmt" / ;;
    *) die 2 "사용법: $PROG recovery status|create <루트>|install [<파티션>]|loader" ;;
  esac
}

# ------------------------------------------------------------------ main
args=()
while (( $# )); do
  case "$1" in
    --dry-run|-n) DRY=1 ;;
    --force) FORCE=1 ;;
    --json) JSON=1 ;;
    -h|--help|help) usage; exit 0 ;;
    *) args+=("$1") ;;
  esac
  shift
done
set -- "${args[@]+"${args[@]}"}"
cmd=${1:-}; (( $# )) && shift
case "$cmd" in
  boot)     cmd_boot "$@" ;;
  apply)    cmd_apply "$@" ;;
  capture)  cmd_capture "$@" ;;
  recovery) cmd_recovery "$@" ;;
  "")       usage ;;
  *)        usage >&2; exit 2 ;;
esac
