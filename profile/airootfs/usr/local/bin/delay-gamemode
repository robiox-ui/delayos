#!/usr/bin/env bash
# DelayOS "Gaming" mode — one click in the top bar.
# Frees CPU/RAM/disk for the game: performance power profile, no desktop
# glass/blur effects, file indexer + background updaters paused.
#
#   delay-gamemode on|off|toggle|status
#   delay-gamemode hook-start|hook-end   (called by gamemoded for every game)
set -u
STATE="${XDG_RUNTIME_DIR:-/tmp}/delay-gaming"
KWIN_EFFECTS=(blur contrast backgroundcontrast slidingpopups kwin4_effect_translucency
              wobblywindows magiclamp overview windowview)

qdbus_cmd() { command -v qdbus6 >/dev/null && echo qdbus6 || echo qdbus; }

kwin_effects() { # $1 = load|unload
  local q; q=$(qdbus_cmd)
  for e in "${KWIN_EFFECTS[@]}"; do
    if [[ $1 == unload ]]; then
      $q org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "$e" >/dev/null 2>&1
    else
      # only reload effects that are enabled in the user's config
      if kreadconfig6 --file kwinrc --group Plugins --key "${e}Enabled" --default true | grep -q true; then
        $q org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$e" >/dev/null 2>&1
      fi
    fi
  done
}

# the top-bar pill (org.delayos.gamingtoggle) re-reads the state at once
pill_refresh() { /usr/local/bin/delay-shell-activate gaming-changed >/dev/null 2>&1 & }

on() {
  touch "$STATE"
  powerprofilesctl set performance 2>/dev/null
  kwin_effects unload
  balooctl6 suspend >/dev/null 2>&1 || balooctl suspend >/dev/null 2>&1
  systemctl --user stop plasma-discover-notifier.service 2>/dev/null
  pkill -STOP -x DiscoverNotifier 2>/dev/null
  # ask the privileged helper to pause system-wide background jobs
  sudo -n /usr/local/bin/delay-gamemode-root on 2>/dev/null
  pill_refresh
  notify-send -a "게이밍" -i input-gaming "게이밍 모드 켜짐" "성능 전원 모드를 사용하고, 화면 효과와 백그라운드 작업을 잠시 멈췄어요." 2>/dev/null
}

off() {
  rm -f "$STATE"
  powerprofilesctl set balanced 2>/dev/null
  kwin_effects load
  balooctl6 resume >/dev/null 2>&1 || balooctl resume >/dev/null 2>&1
  pkill -CONT -x DiscoverNotifier 2>/dev/null
  sudo -n /usr/local/bin/delay-gamemode-root off 2>/dev/null
  pill_refresh
  notify-send -a "게이밍" -i input-gaming "게이밍 모드 꺼짐" 2>/dev/null
}

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  toggle) [[ -e $STATE ]] && off || on ;;
  status) [[ -e $STATE ]] && echo on || echo off ;;
  # gamemoded hooks: make games always get full power, even without the toggle
  hook-start) powerprofilesctl set performance 2>/dev/null ;;
  hook-end) [[ -e $STATE ]] || powerprofilesctl set balanced 2>/dev/null ;;
  *) echo "usage: $0 on|off|toggle|status"; exit 1 ;;
esac
