#!/usr/bin/env bash
# delay-recovery-ctl: DelayOS 복구 환경 제어 (Windows의 reagentc / shutdown /r /o 에 해당). docs/recovery.md
#
#   status [--json]            recovery partition, boot counter, boot menu entry
#   reboot [--action A]        restart into the recovery environment once ("고급 시작 옵션")
#                              A = menu (default) | repair | rollback | reset-keep | reset-wipe
#   cancel                     forget a pending "reboot"
#   boot-ok [--check]          tell the boot loader that this start was good (delay-boot-ok.*)
#   firmware                   restart into the UEFI firmware setup
#
# The state is a GRUB environment block on the recovery partition (<RE>/delayos-re/grubenv), read by
# /etc/grub.d/45_delayos-recovery. The partition is mounted only for the moment it is needed.
set -u
export LC_ALL=C.UTF-8 LANGUAGE=en
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
PROG=delay-recovery-ctl
RE_LABEL=DELAYOS-RE
RE_DIR=delayos-re
RUN=/run/delayos
JSON=0; QUIET=0

say()  { (( QUIET )) || printf '%s\n' "$*"; }
die()  { local rc=1; [[ ${1:-} =~ ^[0-9]+$ ]] && { rc=$1; shift; }; printf '%s: %s\n' "$PROG" "$*" >&2; exit "$rc"; }
need_root() { [[ $EUID -eq 0 ]] || die 77 "루트 권한이 필요합니다 (sudo $PROG ...)"; }

usage() {
  cat <<'EOF'
delay-recovery-ctl: DelayOS 복구 환경 제어

사용법:
  delay-recovery-ctl status [--json]       복구 파티션과 부팅 실패 카운터 상태
  delay-recovery-ctl reboot [--action <동작>] [--no-reboot]
        다음 한 번만 복구 환경(DelayOS 복구)으로 다시 시작합니다.
        동작: menu(기본, 메뉴 표시) | repair(시동 복구) | rollback(이전 상태로 되돌리기)
              reset-keep(이 PC 초기화: 내 파일 유지) | reset-wipe(이 PC 초기화: 모두 제거)
  delay-recovery-ctl cancel                예약한 복구 환경 시작을 취소
  delay-recovery-ctl boot-ok               이번 부팅이 정상이라고 기록 (자동 실행됨)
  delay-recovery-ctl firmware              펌웨어 설정(UEFI)으로 다시 시작
EOF
}

disk_of() { lsblk -lpnso NAME,TYPE "$1" 2>/dev/null | awk '$2 == "disk" { print $1; exit }'; }
sys_dev() { # a block device of the running system
  local mp s
  for mp in / /.snapshots /home /var/log; do
    s=$(findmnt -fno SOURCE "$mp" 2>/dev/null) || continue
    s=${s%%\[*}; [[ -b $s ]] && { echo "$s"; return 0; }
  done
  return 1
}
re_dev() {
  local d sd="" first=""
  d=$(sys_dev) && sd=$(disk_of "$d")
  while read -r d l; do
    [[ $l == "$RE_LABEL" ]] || continue
    [[ -z $first ]] && first=$d
    [[ -n $sd && $(disk_of "$d") == "$sd" ]] && { echo "$d"; return 0; }
  done < <(lsblk -lpno NAME,LABEL 2>/dev/null)
  [[ -n $first ]] && { echo "$first"; return 0; }
  return 1
}
RE_MNT=""; RE_OWNED=0
re_close() { (( RE_OWNED )) && { umount "$RE_MNT" 2>/dev/null; rmdir "$RE_MNT" 2>/dev/null; RE_OWNED=0; }; return 0; }
re_open() { # $1 = ro|rw
  local dev m
  dev=$(re_dev) || return 1
  m=$(findmnt -fno TARGET -S "$dev" 2>/dev/null | head -n1)
  if [[ -n $m ]]; then
    RE_MNT=$m
    [[ $1 == rw ]] && { mount -o remount,rw "$m" 2>/dev/null || return 1; }
    return 0
  fi
  mkdir -p "$RUN"; RE_MNT=$RUN/re.$$
  mkdir -p "$RE_MNT" && mount -o "$1,noatime" "$dev" "$RE_MNT" 2>/dev/null || { rmdir "$RE_MNT" 2>/dev/null; return 1; }
  RE_OWNED=1; trap re_close EXIT
}
env_get() { grub-editenv "$RE_MNT/$RE_DIR/grubenv" list 2>/dev/null | sed -n "s/^$1=//p" | head -n1; }
env_set() {
  local f=$RE_MNT/$RE_DIR/grubenv
  [[ -f $f ]] || grub-editenv "$f" create || return 1
  grub-editenv "$f" set "$@"
}
grub_entry() { grep -q "delayos-recovery" /boot/grub/grub.cfg 2>/dev/null; }

cmd_status() {
  local dev="" ver="" ok="" tries="" next="" entry=false size=0 img=""
  dev=$(re_dev) || dev=""
  grub_entry && entry=true
  [[ -f /usr/share/delayos/recovery/image/$RE_DIR/version ]] && img=$(< /usr/share/delayos/recovery/image/$RE_DIR/version)
  if [[ -n $dev ]]; then
    size=$(lsblk -bdno SIZE "$dev" 2>/dev/null || echo 0)
    if [[ $EUID -eq 0 ]] && re_open ro; then
      ver=$(cat "$RE_MNT/$RE_DIR/version" 2>/dev/null); ok=$(env_get delay_boot_ok); tries=$(env_get delay_boot_tries); next=$(env_get delay_next)
      re_close
    fi
  fi
  if (( JSON )); then
    printf '{"present":%s,"device":"%s","sizeBytes":%s,"version":"%s","imageVersion":"%s","menuEntry":%s,"bootOk":"%s","bootTries":"%s","pending":%s,"uefi":%s}\n' \
      "$([[ -n $dev ]] && echo true || echo false)" "$dev" "${size:-0}" "$ver" "$img" "$entry" "$ok" "$tries" \
      "$([[ $next == recovery ]] && echo true || echo false)" "$([[ -d /sys/firmware/efi ]] && echo true || echo false)"
    return 0
  fi
  if [[ -z $dev ]]; then echo "복구 파티션이 없습니다. (만들기: sudo delay-deploy recovery create /)"; return 1; fi
  echo "복구 파티션: $dev ($(( size / 1048576 )) MiB)${ver:+, 복구 환경 버전 $ver}"
  echo "부팅 메뉴 항목 'DelayOS 복구': $([[ $entry == true ]] && echo 있음 || echo "없음 (sudo grub-mkconfig -o /boot/grub/grub.cfg)")"
  [[ -n $ok ]] && echo "부팅 실패 카운터: 연속 ${tries:-0}회 (3회면 복구 환경이 자동으로 시작됩니다)"
  [[ $next == recovery ]] && echo "다음 시작 때 복구 환경이 열립니다."
  return 0
}

cmd_reboot() {
  need_root
  local action=menu noreboot=0
  while (( $# )); do
    case "$1" in --action) action=${2:-menu}; shift ;; --no-reboot) noreboot=1 ;; *) die 2 "알 수 없는 옵션: $1" ;; esac; shift
  done
  case "$action" in menu|repair|rollback|reset-keep|reset-wipe) ;; *) die 2 "알 수 없는 동작: $action" ;; esac
  command -v grub-editenv >/dev/null || die "grub-editenv가 없습니다"
  grub_entry || die 3 "부팅 메뉴에 'DelayOS 복구' 항목이 없습니다. 먼저: sudo grub-mkconfig -o /boot/grub/grub.cfg"
  re_open rw || die 3 "복구 파티션을 찾지 못했습니다. (만들기: sudo delay-deploy recovery create /)"
  [[ -f $RE_MNT/$RE_DIR/x86_64/airootfs.sfs && -f $RE_MNT/$RE_DIR/boot/vmlinuz ]] || { re_close; die 3 "복구 파티션에 복구 환경이 없습니다. (다시 설치: sudo delay-deploy recovery install)"; }
  [[ $action == menu ]] && action=""
  env_set delay_next=recovery "delay_re_action=$action" || { re_close; die "복구 환경 시작을 예약하지 못했습니다"; }
  sync; re_close
  say "다음 시작 때 DelayOS 복구가 열립니다."
  (( noreboot )) || systemctl reboot
}

cmd_cancel() {
  need_root
  re_open rw || die 3 "복구 파티션을 찾지 못했습니다"
  grub-editenv "$RE_MNT/$RE_DIR/grubenv" unset delay_next delay_re_action
  sync; re_close
  say "예약을 취소했습니다."
}

cmd_boot_ok() {
  need_root
  local check=0
  [[ ${1:-} == --check ]] && check=1
  command -v grub-editenv >/dev/null || return 0
  if (( check )); then
    # a desktop system whose login screen is not up did not start properly
    if systemctl -q is-enabled display-manager.service 2>/dev/null && ! systemctl -q is-active display-manager.service; then
      say "로그인 화면이 실행 중이 아니어서 정상 부팅으로 기록하지 않습니다"; return 0
    fi
  fi
  re_open rw || return 0
  [[ -d $RE_MNT/$RE_DIR ]] && env_set delay_boot_ok=1 delay_boot_tries=0
  sync; re_close
  return 0
}

args=()
while (( $# )); do
  case "$1" in
    --json) JSON=1 ;;
    -q|--quiet) QUIET=1 ;;
    -h|--help|help) usage; exit 0 ;;
    *) args+=("$1") ;;
  esac; shift
done
set -- "${args[@]+"${args[@]}"}"
cmd=${1:-}; (( $# )) && shift
case "$cmd" in
  status)   cmd_status "$@" ;;
  reboot)   cmd_reboot "$@" ;;
  cancel)   cmd_cancel "$@" ;;
  boot-ok)  cmd_boot_ok "$@" ;;
  firmware) need_root; [[ -d /sys/firmware/efi ]] || die 3 "이 PC는 UEFI로 부팅하지 않았습니다"; systemctl reboot --firmware-setup ;;
  "")       usage ;;
  *)        usage >&2; exit 2 ;;
esac
