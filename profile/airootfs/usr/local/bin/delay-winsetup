DRY = False
LOGS = [LOG]


class Fail(Exception):
    def __init__(self, code, *args, detail=""):
        super().__init__(code)
        self.code, self.detail = code, detail
        try:
            self.message = MSG.get(code, code).format(*args)
        except IndexError:
            self.message = MSG.get(code, code).format(*(list(args) + [detail or "?"] * 3))


def log(msg):
    line = "%s %s%s" % (time.strftime("%Y-%m-%d %H:%M:%S"), "[dry-run] " if DRY else "", msg)
    for p in LOGS:
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "a", encoding="utf-8") as f:
                f.write(line + "\n")
        except OSError:
            pass
    if sys.stderr.isatty():
        sys.stderr.write(line + "\n")


def progress(frac, msg):
    print("PROGRESS %.4f %s" % (max(0.0, min(1.0, frac)), msg), flush=True)


def run(cmd, mutate=False, check=False, timeout=600, stdin=None, quiet=False):
    """mutate=True marks commands that change something: they are skipped in dry-run mode."""
    if mutate and DRY:
        log("would run: " + " ".join(cmd))
        return 0, ""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                           errors="replace", timeout=timeout, input=stdin)
        rc, out = p.returncode, p.stdout
    except Exception as e:  # noqa
        rc, out = 127, str(e)
    if mutate or (rc != 0 and not quiet):
        log("run rc=%d: %s%s" % (rc, " ".join(cmd), ("\n    " + out.strip()[-800:].replace("\n", "\n    ")) if out.strip() and rc != 0 else ""))
    if check and rc != 0:
        raise Fail("internal", detail="%s: %s" % (cmd[0], out.strip()[-300:]))
    return rc, out


def have(b):
    return shutil.which(b) is not None


def need_tools(*names):
    missing = [n for n in names if not have(n)]
    if missing:
        raise Fail("tool", ", ".join(missing))


def read_text(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


def write_file(path, data, mode=0o644):
    if DRY:
        log("would write %s (%d bytes)" % (path, len(data)))
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if isinstance(data, str):
        data = data.encode("utf-8")
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def remove_file(path):
    if DRY:
        if os.path.exists(path):
            log("would remove " + path)
        return
    try:
        os.unlink(path)
    except OSError:
        pass


# ---- configuration (shell style KEY='value') -------
def load_conf(root="/"):
    conf = {}
    for line in read_text(os.path.join(root, CONF.lstrip("/"))).splitlines():
        m = re.match(r"^([A-Z_][A-Z0-9_]*)='?([^']*)'?$", line.strip())
        if m:
            conf[m.group(1)] = m.group(2)
    return conf


def save_conf(conf, root="/"):
    body = "# DelayOS hidden Windows (delay-winsetup). Do not edit by hand.\n"
    body += "".join("%s='%s'\n" % (k, str(v).replace("'", "")) for k, v in sorted(conf.items()))
    write_file(os.path.join(root, CONF.lstrip("/")), body)


# ---- block devices -------------------------------------------------------------------------------
def lsblk(dev=None):
    cmd = ["lsblk", "-J", "-b", "-l", "-o", "PATH,PKNAME,TYPE,FSTYPE,PARTUUID,PARTLABEL,SIZE,UUID,MOUNTPOINT,RM,MODEL,TRAN,PTTYPE,LABEL"]
    if dev:
        cmd.append(dev)
    rc, out = run(cmd, quiet=True)
    try:
        return json.loads(out)["blockdevices"]
    except Exception:
        return []


def settle(disk=None):
    if DRY:
        return
    if disk:
        if run(["partprobe", disk], quiet=True)[0] != 0:
            run(["partx", "-u", disk], quiet=True)
    run(["udevadm", "settle", "--timeout=15"], quiet=True)


def sfdisk_table(disk):
    rc, out = run(["sfdisk", "-J", disk])
    try:
        return json.loads(out)["partitiontable"]
    except Exception:
        raise Fail("not_gpt", detail=out.strip()[-200:])


def partnum(node):
    m = re.search(r"(\d+)$", node)
    return int(m.group(1)) if m else 0


def partnode(disk, n):
    return "%s%s%d" % (disk, "p" if disk[-1].isdigit() else "", n)


def by_partuuid(pu):
    p = "/dev/disk/by-partuuid/" + pu.lower()
    return os.path.realpath(p) if os.path.exists(p) else None


def blkid(dev, tag):
    rc, out = run(["blkid", "-p", "-s", tag, "-o", "value", dev], quiet=True)
    return out.strip() if rc == 0 else ""


def verify_part(pu, name, disk):
    """Device node of the partition with GPT GUID pu, only if its name and disk are what we made."""
    if DRY and not pu:
        return "/dev/null"
    settle()
    dev = by_partuuid(pu) if pu else None
    if not dev:
        raise Fail("verify", detail="partuuid %s not found" % pu)
    for d in lsblk(dev):
        if d.get("path") == dev and (d.get("partlabel") or "") == name and "/dev/" + (d.get("pkname") or "") == disk:
            return dev
    raise Fail("verify", detail="%s is not %s on %s" % (dev, name, disk))


class Mount:
    def __init__(self, dev, fstype=None, opts="rw"):
        self.dev, self.fstype, self.opts, self.path = dev, fstype, opts, None

    def __enter__(self):
        os.makedirs(RUN, 0o700, exist_ok=True)
        self.path = tempfile.mkdtemp(prefix="mnt-", dir=RUN)
        cmd = ["mount", "-o", self.opts]
        if self.fstype:
            cmd += ["-t", self.fstype]
        rc, out = run(cmd + [self.dev, self.path], timeout=120)
        if rc != 0:
            os.rmdir(self.path)
            raise Fail("internal", detail="mount %s: %s" % (self.dev, out.strip()[-200:]))
        return self.path

    def __exit__(self, *a):
        run(["sync"], quiet=True, timeout=900)
        for _ in range(10):
            if run(["umount", self.path], quiet=True)[0] == 0:
                break
            time.sleep(1)
        try:
            os.rmdir(self.path)
        except OSError:
            log("could not remove mount point " + self.path)
        return False


def find_ci(root, rel):
    cur = root
    for part in rel.split("/"):
        try:
            hit = next((n for n in os.listdir(cur) if n.lower() == part.lower()), None)
        except OSError:
            return None
        if hit is None:
            return None
        cur = os.path.join(cur, hit)
    return cur


# ---- facts (installer page) ----------------------------------------------------------------------
def tpm_facts():
    base = "/sys/class/tpm/tpm0"
    if not os.path.isdir(base):
        return {"present": False, "version": 0}
    v = read_text(base + "/tpm_version_major").strip()
    return {"present": True, "version": int(v) if v.isdigit() else 0}


def secure_boot():
    """True/False, or None when unknown (no UEFI)."""
    try:
        with open("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c", "rb") as f:
            d = f.read()
        return len(d) >= 5 and d[4] == 1
    except OSError:
        return None


def msdm_key():
    """OEM Windows key stored in the firmware (ACPI MSDM table), or ''. Root only. Never logged."""
    try:
        with open("/sys/firmware/acpi/tables/MSDM", "rb") as f:
            d = f.read()
        key = d[-29:].decode("ascii", "replace").strip().upper()
        return key if KEY_RE.match(key) else ""
    except OSError:
        return ""


def sb_available(root="/"):
    j = lambda p: os.path.join(root, p.lstrip("/"))
    return all(os.path.isfile(j(p)) for p in (SB_DIR + "/grubx64.efi", SB_DIR + "/delayos-general-ca.cer",
                                              SB_DIR + "/vmlinuz-linux-delayos.signed",
                                              SHIM_DIR + "/shimx64.efi", SHIM_DIR + "/mmx64.efi"))


def tpm_bypass():
    return os.environ.get("DELAYOS_WINSETUP_SKIP_TPM") == "1" or os.path.exists(RUN + "/skip-tpm")


BUNDLED_MNT = RUN + "/medium"


def live_medium_devs():
    """Block devices that can be the DelayOS live medium when it is still plugged in but no longer
    mounted (copytoram: archiso unmounts /run/archiso/bootmnt after copying the system to RAM)."""
    devs = []
    cmdline = read_text("/proc/cmdline")
    for opt, by in (("archisosearchuuid", "by-uuid"), ("archisodevice", ""), ("archisolabel", "by-label")):
        m = re.search(r"(?:^|\s)%s=(\S+)" % opt, cmdline)
        if not m:
            continue
        v = m.group(1)
        if not by and v.startswith("UUID="):
            by, v = "by-uuid", v[5:]
        elif not by and v.startswith("LABEL="):
            by, v = "by-label", v[6:]
        link = "/dev/disk/%s/%s" % (by, v) if by else v
        if link.startswith("/dev/") and os.path.exists(link):
            devs.append(os.path.realpath(link))
    for d in lsblk():
        p = d.get("path") or ""
        if p in devs and d.get("pkname"):
            devs.append("/dev/" + d["pkname"])     # ISO written to a stick: the file system starts at the disk
        elif p and (d.get("label") or "").upper().startswith("DELAYOS") and d.get("fstype") in ("iso9660", "udf", "vfat", "exfat", "ntfs"):
            devs.append(p)
    seen = []
    for p in devs:
        if p not in seen and not p.startswith("/dev/loop"):
            seen.append(p)
    return seen


def bundled_isos():
    """Windows ISO files that a personal build carries on the live medium in /windows/
    (tools/make-personal-iso.sh, docs/windows-switch.md). Looks at the mounted medium; when archiso
    has unmounted it (copytoram), the medium is mounted read-only at RUN/medium and stays mounted
    while it holds such a file, so that the installer can read the ISO later. Live system only."""
    def scan(base):
        d = find_ci(base, "windows")
        if not d or not os.path.isdir(d):
            return []
        try:
            return sorted(os.path.join(d, n) for n in os.listdir(d)
                          if n.lower().endswith(".iso") and os.path.isfile(os.path.join(d, n)))
        except OSError:
            return []
    if not os.path.isdir("/run/archiso"):
        return []
    for base in ("/run/archiso/bootmnt", BUNDLED_MNT):
        if os.path.ismount(base):
            return scan(base)
    if os.geteuid() != 0:
        return []
    for dev in live_medium_devs():
        os.makedirs(BUNDLED_MNT, 0o755, exist_ok=True)
        if run(["mount", "-o", "ro", dev, BUNDLED_MNT], quiet=True)[0] != 0:
            continue
        hits = scan(BUNDLED_MNT)
        if hits:
            log("Windows ISO on the live medium (%s): %s" % (dev, ", ".join(hits)))
            return hits
        run(["umount", BUNDLED_MNT], quiet=True)
    return []


def facts():
    live_src = ""
    rc, out = run(["findmnt", "-no", "SOURCE", "/run/archiso/bootmnt"], quiet=True)
    if rc == 0:
        live_src = out.strip()
    disks = []
    for d in lsblk():
        if d.get("type") != "disk" or (d.get("path") or "").startswith(("/dev/loop", "/dev/zram", "/dev/sr", "/dev/ram", "/dev/fd")):
            continue
        if live_src.startswith(d["path"]):
            continue
        disks.append({"path": d["path"], "size_gb": round(int(d.get("size") or 0) / GIB, 1),
                      "model": (d.get("model") or "").strip(), "removable": bool(d.get("rm")) or d.get("tran") == "usb"})
    existing = any((d.get("fstype") in ("ntfs", "BitLocker")) and int(d.get("size") or 0) >= 30 * GIB for d in lsblk())
    # optical drives / USB partitions that hold a disc-format medium (a Windows ISO written to a disc
    # or attached as a virtual drive): offered on the installer page as "use this medium"
    media = []
    for d in lsblk():
        p = d.get("path") or ""
        # never the DelayOS medium itself: on an installed system (or a live system copied to RAM)
        # nothing is mounted at /run/archiso/bootmnt and the DVD or USB stick was offered as Windows media
        if (d.get("label") or "").upper().startswith(("DELAYOS", "ARCHISO")):
            continue
        if d.get("fstype") in ("udf", "iso9660") and p and not p.startswith("/dev/loop") and not (live_src and (live_src.startswith(p) or p.startswith(live_src))):
            media.append({"path": p, "label": (d.get("label") or "").strip(), "size_gb": round(int(d.get("size") or 0) / GIB, 1)})
    # a Windows ISO carried by the live medium itself (personal build): listed first with source
    # "bundled", the installer page preselects it (no download)
    for iso in reversed(bundled_isos()):
        try:
            media.insert(0, {"path": iso, "label": os.path.basename(iso), "size_gb": round(os.path.getsize(iso) / GIB, 1), "source": "bundled"})
        except OSError:
            pass
    t = tpm_facts()
    return {
        "schema": 1,
        "win_media": media,
        "uefi": os.path.isdir("/sys/firmware/efi"),
        "tpm": t, "tpm_ok": (t["present"] and t["version"] >= 2) or tpm_bypass(), "tpm_bypass": tpm_bypass(),
        "secure_boot": secure_boot(), "sb_build": sb_available(), "sb_enrolled": sb_available() and sb_enrolled(),
        "oem_key": bool(msdm_key()) if os.geteuid() == 0 else os.path.exists("/sys/firmware/acpi/tables/MSDM"),
        "existing_windows": existing,
        "disks": disks, "stage_gb": STAGE_GB, "min_win_gb": MIN_WIN_GB, "min_root_gb": MIN_ROOT_GB,
        "tools": {t_: have(t_) for t_ in ("wimlib-imagex", "sgdisk", "sfdisk", "mkfs.vfat", "efibootmgr")},
    }


def cmd_probe(a):
    f = facts()
    if a.write:
        os.makedirs(RUN, 0o755, exist_ok=True)
        os.chmod(RUN, 0o755)
        qml = "// generated by delay-winsetup probe\nimport QtQuick\nItem {\n    readonly property var facts: (%s)\n}\n" % json.dumps(f, ensure_ascii=False)
        write_file(RUN + "/WinFacts.qml", qml)
    print(json.dumps(f, ensure_ascii=False, indent=1))
    return 0


# ---- stage 1: partitions -------------------------------------------------------------------------
def cmd_parts(a):
    need_tools("sfdisk", "sgdisk", "mkfs.vfat", "lsblk", "blkid")
    if not os.path.isdir("/sys/firmware/efi"):
        raise Fail("not_uefi")
    t = tpm_facts()
    if not ((t["present"] and t["version"] >= 2) or tpm_bypass()):
        raise Fail("no_tpm")
    win_gb = max(MIN_WIN_GB, int(a.win_gb))
    root_dev = os.path.realpath(a.root_dev)
    info = next((d for d in lsblk(root_dev) if d.get("path") == root_dev), None)
    if not info or info.get("type") != "part" or not info.get("pkname"):
        raise Fail("luks" if info and info.get("type") == "crypt" else "root_dev", detail=str(info))
    if info.get("mountpoint"):
        raise Fail("root_dev", detail="mounted")
    disk = "/dev/" + info["pkname"]
    fstype = blkid(root_dev, "TYPE")
    if fstype == "crypto_LUKS":
        raise Fail("luks")
    if fstype not in ("btrfs", "ext4", "xfs"):
        raise Fail("fs", detail=fstype)
    table = sfdisk_table(disk)
    if table.get("label") != "gpt":
        raise Fail("not_gpt")
    ss = int(table.get("sectorsize") or 512)
    al = MIB // ss
    entry = next((p for p in table["partitions"] if os.path.realpath(p["node"]) == root_dev), None)
    if not entry:
        raise Fail("root_dev", detail="not in table")
    n_root, start, size = partnum(entry["node"]), int(entry["start"]), int(entry["size"])
    old_end = start + size                                  # exclusive
    stage_s, win_s = STAGE_GB * GIB // ss, win_gb * GIB // ss
    new_size = ((size - stage_s - win_s) // al) * al
    if new_size * ss < MIN_ROOT_GB * GIB:
        raise Fail("too_small", detail="root %d GiB, need %d" % (size * ss // GIB, win_gb + STAGE_GB + MIN_ROOT_GB))
    stg_start = -(-(start + new_size) // al) * al
    stg_end = stg_start + stage_s - 1
    win_start = stg_end + 1
    win_end = (old_end // al) * al - 1
    used = sorted(partnum(p["node"]) for p in table["partitions"])
    free = [n for n in range(1, 129) if n not in used]
    # Windows gets the LOWER free entry number, the temporary staging partition the higher one (it
    # still lies in front of Windows on the disk). Deleting the staging partition later must not
    # leave an empty GPT entry below the Windows entry: Windows then stops with
    # INACCESSIBLE_BOOT_DEVICE (0x7B) on every start (seen in the VM test, docs/reports/wintest.md).
    n_win, n_stg = free[0], free[1]
    fs_uuid, fs_label = blkid(root_dev, "UUID"), blkid(root_dev, "LABEL")
    log("parts: disk=%s root=%s (#%d %s uuid=%s) start=%d size=%d -> %d sectors; staging #%d %d-%d; windows #%d %d-%d (%d GiB)"
        % (disk, root_dev, n_root, fstype, fs_uuid, start, size, new_size, n_stg, stg_start, stg_end, n_win, win_start, win_end, win_gb))

    # 1. the root file system must be the brand-new, empty one Calamares just made
    new_bytes = new_size * ss
    if fstype in ("btrfs", "ext4"):
        with Mount(root_dev, fstype, "ro" if DRY else "rw") as m:
            extra = [n for n in os.listdir(m) if n != "lost+found"]
            if extra:
                raise Fail("not_empty", detail=", ".join(extra[:5]))
            if fstype == "btrfs":
                run(["btrfs", "filesystem", "resize", str(new_bytes), m], mutate=True, check=True)
        if fstype == "ext4":
            run(["e2fsck", "-f", "-p", root_dev], mutate=True)
            run(["resize2fs", root_dev, "%dK" % (new_bytes // 1024)], mutate=True, check=True)
    else:
        with Mount(root_dev, "xfs", "ro") as m:
            extra = os.listdir(m)
        if extra:
            raise Fail("not_empty", detail=", ".join(extra[:5]))
    # 2. shrink the partition entry (GUID, name, type and start stay as they are)
    run(["sfdisk", "--no-reread", "-N", str(n_root), disk], mutate=True, check=True, stdin=", %d\n" % new_size)
    settle(disk)
    if fstype == "xfs":          # XFS cannot shrink: make the (empty) file system again, same UUID/label
        cmd = ["mkfs.xfs", "-f", "-m", "uuid=" + fs_uuid]
        if fs_label:
            cmd += ["-L", fs_label]
        run(cmd + [root_dev], mutate=True, check=True)
    # 3. the two new partitions, only inside the space that was just freed
    run(["sgdisk", "-n", "%d:%d:%d" % (n_stg, stg_start, stg_end), "-t", "%d:0700" % n_stg, "-c", "%d:%s" % (n_stg, STG_NAME),
         "-n", "%d:%d:%d" % (n_win, win_start, win_end), "-t", "%d:0700" % n_win, "-c", "%d:%s" % (n_win, WIN_NAME), disk],
        mutate=True, check=True)
    settle(disk)
    state = {"disk": disk, "root_dev": root_dev, "root_n": n_root, "root_fstype": fstype, "stage_n": n_stg, "win_n": n_win,
             "win_gb": win_gb, "nonce": uuid.uuid4().hex, "time": int(time.time()), "dry": DRY}
    if not DRY:
        t2 = sfdisk_table(disk)
        byn = {partnum(p["node"]): p for p in t2["partitions"]}
        if n_stg not in byn or n_win not in byn or byn[n_stg].get("name") != STG_NAME or byn[n_win].get("name") != WIN_NAME:
            raise Fail("parts_failed", detail="new partitions missing")
        if blkid(root_dev, "UUID") != fs_uuid:
            raise Fail("parts_failed", detail="root file system UUID changed")
        state.update(disk_ptuuid=t2.get("id", ""), root_partuuid=byn[n_root]["uuid"].lower(),
                     stage_partuuid=byn[n_stg]["uuid"].lower(), win_partuuid=byn[n_win]["uuid"].lower())
        stg_dev = verify_part(state["stage_partuuid"], STG_NAME, disk)
        win_dev = verify_part(state["win_partuuid"], WIN_NAME, disk)
        run(["wipefs", "-a", stg_dev], mutate=True)
        run(["wipefs", "-a", win_dev], mutate=True)
        run(["mkfs.vfat", "-F", "32", "-n", "DELAYWINSET", stg_dev], mutate=True, check=True)
        os.makedirs(RUN, 0o755, exist_ok=True)
    write_file(STATE, json.dumps(state, indent=1), 0o600)
    print(json.dumps({"ok": True, "state": state}, ensure_ascii=False))
    return 0


# ---- Microsoft download (same public API flow as the open-source Fido / Mido scripts) -------------
class MsDownload:
    PAGE = "https://www.microsoft.com/en-us/software-download/windows11"
    REFERER = "https://www.microsoft.com/software-download/windows11"
    API = "https://www.microsoft.com/software-download-connector/api/"
    ORG_ID, PROFILE, INSTANCE = "y6jn8c31", "606624d44113", "560dc9f3-1aa5-4a2f-b63c-9e18f8d0e175"
    FALLBACK_EDITIONS = ("3813", "3262", "3113", "2935")

    def __init__(self):
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
        self.sha = ""

    def get(self, url, referer=None, timeout=40):
        req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "*/*", "Accept-Language": "en-US,en;q=0.8"})
        if referer:
            req.add_header("Referer", referer)
        with self.opener.open(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "replace")

    @staticmethod
    def allowed(url):
        host = (urllib.parse.urlparse(url).hostname or "").lower()
        return url.startswith("https://") and (host.endswith(".microsoft.com") or host == "microsoft.com")

    def resolve(self, language="Korean"):
        """(url, sha256 or '') of the official Windows 11 x64 ISO in the given language."""
        editions = []
        try:
            page = self.get(self.PAGE)
            editions = re.findall(r'<option[^>]*value="(\d+)"[^>]*>\s*Windows 11', page)
            m = re.search(re.escape(language) + r"\s*64-bit\s*</td>\s*<td[^>]*>\s*([A-Fa-f0-9]{64})", page)
            if m:
                self.sha = m.group(1).lower()
        except Exception as e:  # noqa
            log("download page: %s" % e)
        last = ""
        for ed in list(dict.fromkeys(editions + list(self.FALLBACK_EDITIONS))):
            sid = str(uuid.uuid4())
            try:
                try:
                    self.get("https://vlscppe.microsoft.com/tags?org_id=%s&session_id=%s" % (self.ORG_ID, sid))
                    js = self.get("https://ov-df.microsoft.com/mdt.js?instanceId=%s&PageId=si&session_id=%s" % (self.INSTANCE, sid))
                    w, rt = re.search(r"[?&]w=([A-F0-9]+)", js), re.search(r'rticks\="\+?(\d+)', js)
                    if w and rt:
                        self.get("https://ov-df.microsoft.com/?session_id=%s&CustomerId=%s&PageId=si&w=%s&mdt=%d&rticks=%s"
                                 % (sid, self.INSTANCE, w.group(1), int(time.time() * 1000), rt.group(1)))
                except Exception as e:  # noqa
                    log("session whitelist: %s" % e)
                q = "?profile=%s&productEditionId=%s&SKU=undefined&friendlyFileName=undefined&Locale=en-US&sessionID=%s" % (self.PROFILE, ed, sid)
                skus = json.loads(self.get(self.API + "getskuinformationbyproductedition" + q))
                sku = next((s for s in skus.get("Skus", []) if s.get("Language") == language), None)
                if not sku:
                    last = "edition %s: no %s SKU (%s)" % (ed, language, str(skus.get("Errors"))[:200])
                    continue
                q = "?profile=%s&productEditionId=undefined&SKU=%s&friendlyFileName=undefined&Locale=en-US&sessionID=%s" % (self.PROFILE, sku["Id"], sid)
                txt = self.get(self.API + "GetProductDownloadLinksBySku" + q, referer=self.REFERER)
                links = json.loads(txt)
                if links.get("Errors"):
                    last = "edition %s: %s" % (ed, str(links["Errors"])[:300])
                    continue
                opts = [o.get("Uri", "") for o in links.get("ProductDownloadOptions", [])]
                opts = [u for u in opts if self.allowed(u)]
                x64 = [u for u in opts if "x64" in u.lower()] or [u for u in opts if "arm64" not in u.lower()]
                if x64:
                    if not self.sha:
                        m = re.search(r'"(?:Sha256|DownloadHash|Hash)"\s*:\s*"([A-Fa-f0-9]{64})"', txt)
                        if m:
                            self.sha = m.group(1).lower()
                    log("resolved Windows ISO: edition id %s, %s, sha256 %s" % (ed, x64[0].split("?")[0], self.sha or "not published"))
                    return x64[0], self.sha
                last = "edition %s: no x64 link" % ed
            except Exception as e:  # noqa
                last = "edition %s: %s" % (ed, e)
            log("download api: " + last)
        raise Fail("download_api", detail=last)

    def download(self, url, dest, cb):
        """Resumable download; returns the size."""
        if not self.allowed(url):
            raise Fail("download", detail="not a Microsoft URL")
        part = dest + ".part"
        for attempt in range(8):
            have_ = os.path.getsize(part) if os.path.exists(part) else 0
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            if have_:
                req.add_header("Range", "bytes=%d-" % have_)
            try:
                with self.opener.open(req, timeout=60) as r:
                    if not self.allowed(r.geturl()):
                        raise Fail("download", detail="redirected outside microsoft.com")
                    if have_ and r.status != 206:
                        have_ = 0
                    total = have_ + int(r.headers.get("Content-Length") or 0)
                    last = 0.0
                    with open(part, "ab" if have_ else "wb") as f:
                        while True:
                            b = r.read(MIB)
                            if not b:
                                break
                            f.write(b)
                            have_ += len(b)
                            if time.time() - last > 1.0:
                                last = time.time()
                                cb(have_, total)
                    if total and have_ < total:
                        raise IOError("short read %d/%d" % (have_, total))
                os.replace(part, dest)
                return have_
            except Fail:
                raise
            except urllib.error.HTTPError as e:
                log("download attempt %d: HTTP %s" % (attempt + 1, e.code))
                if e.code in (403, 404, 410):
                    break
                if e.code == 416:
                    os.unlink(part)
            except Exception as e:  # noqa
                log("download attempt %d: %s" % (attempt + 1, e))
            time.sleep(3 + attempt * 2)
        raise Fail("download")


def sha256_file(path, cb=None, size=None):
    """SHA-256 of a file, or of the first `size` bytes (an ISO image on a disc or a USB partition)."""
    h, done, total = hashlib.sha256(), 0, size if size is not None else os.path.getsize(path)
    with open(path, "rb") as f:
        while done < total:
            b = f.read(min(4 * MIB, total - done))
            if not b:
                break
            h.update(b)
            done += len(b)
            if cb:
                cb(done, total)
    return h.hexdigest()


def iso_image_size(dev):
    """Size in bytes of the ISO image written to a block device, from its ISO 9660 volume descriptor
    (the device itself can be longer than the image), or 0."""
    import struct
    try:
        with open(dev, "rb") as f:
            f.seek(16 * 2048)
            pvd = f.read(2048)
        if pvd[:6] != b"\x01CD001":
            return 0
        blocks, bsize = struct.unpack_from("<I", pvd, 80)[0], struct.unpack_from("<H", pvd, 128)[0]
        return blocks * bsize
    except (OSError, struct.error):
        return 0


def cmd_iso_url(a):
    d = MsDownload()
    url, sha = d.resolve(a.language)
    print(json.dumps({"url": url, "sha256": sha}, indent=1))
    return 0


# ---- WIM helpers ---------------------------------------------------------------------------------
def wim_images(path):
    """Images of a WIM/ESD (or the first part of a split WIM), in index order:
    [{index, name, display, edition, arch, build, lang, type}]."""
    try:
        raw = subprocess.run(["wimlib-imagex", "info", path, "--xml"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=120).stdout
    except Exception:
        return []
    txt = raw.decode("utf-16", "replace") if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else raw.decode("utf-8", "replace")
    res = []
    for m in re.finditer(r'<IMAGE INDEX="(\d+)">(.*?)</IMAGE>', txt, re.S):
        body = m.group(2)

        def tag(t, body=body):
            x = re.search(r"<%s>([^<]*)</%s>" % (t, t), body)
            return x.group(1).strip() if x else ""
        ver = re.search(r"<VERSION>.*?<BUILD>(\d+)</BUILD>", body, re.S)
        lang = re.search(r"<LANGUAGES>.*?<DEFAULT>([^<]+)</DEFAULT>", body, re.S)
        res.append({"index": int(m.group(1)), "name": tag("NAME"), "display": tag("DISPLAYNAME"), "edition": tag("EDITIONID"),
                    "arch": tag("ARCH"), "build": ver.group(1) if ver else "", "lang": lang.group(1) if lang else "",
                    "type": tag("INSTALLATIONTYPE"), "flags": tag("FLAGS")})
    return res


def image_label(im):
    # a rebuilt image may have lost its EDITIONID and only carry the edition name in FLAGS
    ed = im["edition"] or im.get("flags", "")
    return "%d: %s%s" % (im["index"], im["name"] or im["display"] or "?", " [%s]" % ed if ed else "")


def select_image(images, edition, index=0, name=""):
    """The image to install. Official ISO: the one whose EDITIONID is the chosen edition. A custom
    ISO may have one image only, other names, or no EDITIONID: an explicit index / name comes first,
    then the edition, then "the only image", then the image name. Returns (image, how)."""
    if not images:
        raise Fail("iso", detail="no image in install.wim/esd")
    listing = ", ".join(image_label(i) for i in images)
    if index:
        im = next((i for i in images if i["index"] == index), None)
        if not im:
            raise Fail("edition", listing, detail="no image index %d" % index)
        return im, "index given"
    if name:
        n = name.strip().lower()
        hits = [i for i in images if n in (i["name"].lower(), i["display"].lower(), i["edition"].lower())] or \
               [i for i in images if n in i["name"].lower() or n in i["display"].lower()]
        if len(hits) != 1:
            raise Fail("edition", listing, detail="image name '%s' matches %d images" % (name, len(hits)))
        return hits[0], "name given"
    want = EDITION_IDS.get(edition, edition)
    im = next((i for i in images if i["edition"].lower() == want.lower()), None) or \
        next((i for i in images if not i["edition"] and i.get("flags", "").lower() == want.lower()), None)
    if im:
        return im, "edition"
    usable = [i for i in images if i["type"].lower() != "windowspe"]
    if len(usable) == 1:
        return usable[0], "only image"
    words = {"home": r"\bhome\b", "pro": r"\bpro(fessional)?\b"}.get(edition, re.escape(edition.lower()))
    other = r"\b(n|single language|education|workstations?)\b"
    hits = [i for i in usable if re.search(words, (i["name"] + " " + i["display"]).lower())
            and not re.search(other, (i["name"] + " " + i["display"]).lower())]
    if len(hits) == 1:
        return hits[0], "image name"
    raise Fail("edition", listing, detail="requested %s" % edition)


def wim_has(path, index, rel):
    """Does the image contain this file or folder? None when it cannot be told."""
    rc, out = run(["wimlib-imagex", "dir", path, str(index), "--path=" + rel], quiet=True, timeout=300)
    if rc == 0:
        return True
    return False if re.search(r"not found|does not exist|no such", out, re.I) else None


def wim_boot_index(path):
    rc, out = run(["wimlib-imagex", "info", path, "--header"], quiet=True)
    m = re.search(r"Boot Index\s*[:=]\s*(\d+)", out)
    c = re.search(r"Image Count\s*[:=]\s*(\d+)", out)
    count = int(c.group(1)) if c else 2
    boot = int(m.group(1)) if m else 0
    # official media: image 2 (Windows Setup) is the boot image; a rebuilt boot.wim may have only one
    return boot if 0 < boot <= count else min(2, max(1, count))


# ---- WinPE shell ---------------------------------------------------------------------------------
# Windows PE starts ONE program: HKLM\SYSTEM\Setup\CmdLine of its registry, normally "winpeshl.exe",
# which reads winpeshl.ini (that is where DelayOS puts its own script). A custom medium can ship its
# own installer there instead (seen: winpeshl.exe replaced by a 9 MB installer that ignores
# winpeshl.ini and wants to partition a disk by itself). DelayOS must be the only thing that runs:
# when the shell is not the genuine small winpeshl.exe, the CmdLine value is rewritten in place to
# start the DelayOS script through cmd.exe. If that is not possible the medium is refused.
PE_CMDLINE = "cmd /c d.cmd"            # 12 characters: fits wherever "winpeshl.exe" was stored


def hive_find_value(data, key, value):
    """(vk offset, data cell offset, capacity in bytes, data length, text) of REG_SZ <root>\\key\\value in
    a registry hive file (regf), or None. Read-only parser for exactly this lookup."""
    import struct
    if data[:4] != b"regf" or len(data) < 0x2000:
        return None
    cell = lambda off: 0x1000 + off + 4            # start of the cell contents

    def subkeys(list_off):
        c = cell(list_off)
        sig, n = data[c:c + 2], struct.unpack_from("<H", data, c + 2)[0]
        if sig in (b"lf", b"lh"):
            return [struct.unpack_from("<I", data, c + 4 + 8 * i)[0] for i in range(n)]
        if sig == b"li":
            return [struct.unpack_from("<I", data, c + 4 + 4 * i)[0] for i in range(n)]
        if sig == b"ri":
            res = []
            for i in range(n):
                res += subkeys(struct.unpack_from("<I", data, c + 4 + 4 * i)[0])
            return res
        return []

    def name_of(c, len_at, name_at, flags):
        n = struct.unpack_from("<H", data, c + len_at)[0]
        raw = data[c + name_at:c + name_at + n]
        return (raw.decode("latin-1") if flags & (0x20 if len_at == 0x48 else 1) else raw.decode("utf-16le", "replace")).lower()
    try:
        nk = cell(struct.unpack_from("<I", data, 0x24)[0])
        if data[nk:nk + 2] != b"nk":
            return None
        nsub, sublist = struct.unpack_from("<I", data, nk + 0x14)[0], struct.unpack_from("<I", data, nk + 0x1C)[0]
        target = None
        for off in (subkeys(sublist) if nsub else []):
            k = cell(off)
            if data[k:k + 2] == b"nk" and name_of(k, 0x48, 0x4C, struct.unpack_from("<H", data, k + 2)[0]) == key.lower():
                target = k
                break
        if target is None:
            return None
        nval, vlist = struct.unpack_from("<I", data, target + 0x24)[0], struct.unpack_from("<I", data, target + 0x28)[0]
        for i in range(nval):
            vk = cell(struct.unpack_from("<I", data, cell(vlist) + 4 * i)[0])
            if data[vk:vk + 2] != b"vk":
                continue
            dlen, doff, typ, flags = struct.unpack_from("<IIIH", data, vk + 4)
            if name_of(vk, 2, 0x14, flags) != value.lower() or typ not in (1, 2) or dlen & 0x80000000:
                continue
            dc = 0x1000 + doff
            size = -struct.unpack_from("<i", data, dc)[0]
            if size < 8 or dc + size > len(data) or dlen > size - 4:
                return None
            return vk, dc + 4, size - 4, dlen, data[dc + 4:dc + 4 + dlen].decode("utf-16le", "replace").rstrip("\0")
    except Exception:           # struct.error / IndexError on a damaged hive
        return None
    return None


def pe_shell_takeover(bw, idx, tmp):
    """Make sure the DelayOS script is what the boot image starts. Returns extra "wimlib update"
    lines (empty when the image already uses the genuine winpeshl.exe)."""
    import struct
    for f in ("SYSTEM", "winpeshl.exe"):
        remove_file(os.path.join(tmp, f))
    run(["wimlib-imagex", "extract", bw, str(idx), "/Windows/System32/config/SYSTEM", "--dest-dir=" + tmp, "--no-acls"], quiet=True, timeout=300)
    run(["wimlib-imagex", "extract", bw, str(idx), "/Windows/System32/winpeshl.exe", "--dest-dir=" + tmp, "--no-acls"], quiet=True, timeout=300)
    hive_file, shell_file = os.path.join(tmp, "SYSTEM"), os.path.join(tmp, "winpeshl.exe")
    try:
        with open(hive_file, "rb") as f:
            data = bytearray(f.read())
    except OSError:
        raise Fail("iso_pe", detail="no registry in the boot image")
    v = hive_find_value(bytes(data), "Setup", "CmdLine")
    cmdline = v[4] if v else ""
    shell_size = os.path.getsize(shell_file) if os.path.isfile(shell_file) else 0
    genuine = cmdline.strip().lower() in ("winpeshl.exe", "winpeshl") and 0 < shell_size < MIB
    log("boot image: Setup\\CmdLine = '%s', winpeshl.exe %d bytes: %s" % (cmdline, shell_size, "standard shell" if genuine else "NOT the standard shell"))
    if genuine:
        return ""
    if not v:
        raise Fail("iso_pe", detail="Setup\\CmdLine not found in the boot image registry")
    vk, dpos, cap, dlen, _t = v
    new = PE_CMDLINE.encode("utf-16le")
    if len(new) + 2 <= cap:
        new += b"\0\0"
    if len(new) > cap:
        raise Fail("iso_pe", detail="Setup\\CmdLine '%s' cannot be replaced in place (%d bytes)" % (cmdline, cap))
    data[dpos:dpos + cap] = new + b"\0" * (cap - len(new))
    struct.pack_into("<I", data, vk + 4, len(new))
    with open(hive_file, "wb") as f:
        f.write(data)
    check = hive_find_value(bytes(data), "Setup", "CmdLine")
    if not check or check[4] != PE_CMDLINE:
        raise Fail("iso_pe", detail="registry edit could not be verified")
    write_file(os.path.join(tmp, "d.cmd"), template("delayos-start.cmd"))
    log("boot image: the medium's own installer is bypassed, Setup\\CmdLine is now '%s' (DelayOS script)" % PE_CMDLINE)
    return "add '%s' '/Windows/System32/config/SYSTEM'\nadd '%s' '/Windows/System32/d.cmd'\n" % (hive_file, os.path.join(tmp, "d.cmd"))


def copy_progress(src, dst, cb):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    total, done = os.path.getsize(src), 0
    with open(src, "rb") as fi, open(dst, "wb") as fo:
        while True:
            b = fi.read(4 * MIB)
            if not b:
                break
            fo.write(b)
            done += len(b)
            cb(done, total)


def copy_tree(src, dst):
    for base, dirs, files in os.walk(src):
        rel = os.path.relpath(base, src)
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for f in files:
            shutil.copyfile(os.path.join(base, f), os.path.join(dst, rel, f))


def template(name, subst=None, crlf=True, encoding="ascii"):
    t = read_text(os.path.join(SHARE, name))
    if not t:
        raise Fail("internal", detail="missing " + name)
    for k, v in (subst or {}).items():
        t = t.replace("@%s@" % k, str(v))
    t = t.replace("\r\n", "\n")
    if crlf:
        t = t.replace("\n", "\r\n")
    return t.encode(encoding, "replace")


# ---- firmware boot entries -----------------------------------------------------------------------
def efi_entries():
    rc, out = run(["efibootmgr"], quiet=True)
    order, nxt, entries = [], "", []
    for line in out.splitlines():
        m = re.match(r"^BootOrder: (.*)$", line)
        if m:
            order = [x for x in m.group(1).strip().split(",") if x]
        m = re.match(r"^BootNext: ([0-9A-Fa-f]{4})", line)
        if m:
            nxt = m.group(1).upper()
        m = re.match(r"^Boot([0-9A-Fa-f]{4})(\*?) ([^\t]*)(?:\t(.*))?$", line)
        if m:
            entries.append({"num": m.group(1).upper(), "label": m.group(3).strip(), "path": m.group(4) or ""})
    return order, nxt, entries


def set_order_first(first_nums):
    order, _n, entries = efi_entries()
    known = [e["num"] for e in entries]
    new = [n for n in first_nums if n in known] + [n for n in order if n not in first_nums]
    if new and new != order:
        run(["efibootmgr", "-q", "-o", ",".join(new)], mutate=True)


def delayos_entry(entries):
    cands = [e for e in entries if e["label"] != SETUP_LABEL and "bootmgfw" not in e["path"].lower()
             and (e["label"].lower().startswith("delayos") or "\\efi\\delayos\\" in e["path"].lower())]
    return cands[0] if cands else None


def windows_entry(conf, create=False):
    """Firmware entry of the hidden Windows (its boot manager on our ESP). "bcdboot /s" does not
    create one, so DelayOS adds it, last in the boot order; Windows keeps it up to date later."""
    esp_pu = conf.get("ESP_PARTUUID", "")
    find = lambda: next((e for e in efi_entries()[2] if "bootmgfw" in e["path"].lower() and esp_pu and esp_pu in e["path"].lower()), None)
    e = find()
    if e or not create:
        return e
    try:
        esp, esp_dev = find_esp("/")
    except Fail:
        return None
    if not find_ci(esp, "EFI/Microsoft/Boot/bootmgfw.efi"):
        return None
    info = next((d for d in lsblk(esp_dev) if d.get("path") == esp_dev), {})
    order_before = efi_entries()[0]
    run(["efibootmgr", "-q", "-c", "-d", "/dev/" + info.get("pkname", ""), "-p", str(partnum(esp_dev)),
         "-L", "Windows Boot Manager", "-l", r"\EFI\Microsoft\Boot\bootmgfw.efi"], mutate=True)
    e = find()
    if e:
        run(["efibootmgr", "-q", "-o", ",".join([n for n in order_before if n != e["num"]] + [e["num"]])], mutate=True)
    return e


def remove_setup_entries():
    for e in efi_entries()[2]:
        if e["label"] == SETUP_LABEL:
            run(["efibootmgr", "-q", "-b", e["num"], "-B"], mutate=True)


def create_setup_entry(disk, n_stg):
    """Firmware entry for the staging partition; DelayOS stays first, the entry is used once (BootNext)."""
    need_tools("efibootmgr")
    remove_setup_entries()
    order_before = efi_entries()[0]
    rc, out = run(["efibootmgr", "-q", "-c", "-d", disk, "-p", str(n_stg), "-L", SETUP_LABEL, "-l", "\\efi\\boot\\bootx64.efi"], mutate=True)
    if DRY:
        return "0000"
    order, _n, entries = efi_entries()
    num = next((e["num"] for e in entries if e["label"] == SETUP_LABEL), None)
    if rc != 0 or not num:
        raise Fail("bootentry", detail=out.strip()[-200:])
    run(["efibootmgr", "-q", "-o", ",".join([n for n in order_before if n != num] + [num])], mutate=True)
    rc, _ = run(["efibootmgr", "-q", "-n", num], mutate=True)
    if rc != 0:
        log("BootNext could not be set now; the DelayOS boot service sets it at the next start")
    return num


# ---- Secure Boot (shim + DelayOS general key) ------------------------------------------------------
def sb_setup(root, esp, disk, esp_n, enroll=True):
    """Boot DelayOS through the Microsoft-signed shim: shim -> GRUB and linux-delayos signed with the
    DelayOS *general* key (not the anti-cheat key, see docs). enroll: also queue the CA for MOK
    enrollment now (the blue MokManager screen then appears at the very next start through shim and
    waits only 10 seconds, so the installer passes enroll=False and "finalize" queues it when the
    unattended Windows setup is over and the user is back at the PC)."""
    j = lambda p: os.path.join(root, p.lstrip("/"))
    if not sb_available(root):
        return False
    inroot = (lambda c: c) if root == "/" else (lambda c: ["chroot", root] + c)
    rc, fsuuid = run(inroot(["grub-probe", "--target=fs_uuid", "/boot/grub"]))
    rc2, rel = run(inroot(["grub-mkrelpath", "/boot/grub"]))
    if rc != 0 or rc2 != 0 or not fsuuid.strip():
        log("sb: cannot locate /boot/grub for GRUB")
        return False
    stub = ("# DelayOS Secure Boot: signed GRUB -> the normal configuration\n"
            "search --no-floppy --fs-uuid --set=root %s\nset prefix=($root)%s\nconfigfile ($root)%s/grub.cfg\n"
            % (fsuuid.strip(), rel.strip(), rel.strip()))
    if DRY:
        log("would install shim + signed GRUB to %s/EFI/DelayOS and EFI/BOOT, signed kernel to /boot, queue MOK" % esp)
        return True
    for sub, shim_name in (("EFI/DelayOS", "shimx64.efi"), ("EFI/BOOT", "BOOTX64.EFI")):
        d = find_ci(esp, sub) or os.path.join(esp, sub)
        os.makedirs(d, exist_ok=True)
        old = find_ci(d, "grubx64.efi")
        if old and not os.path.exists(os.path.join(d, "grubx64-unsigned.efi")) and sub == "EFI/DelayOS":
            shutil.copyfile(old, os.path.join(d, "grubx64-unsigned.efi"))
        shutil.copyfile(j(SHIM_DIR + "/shimx64.efi"), os.path.join(d, shim_name))
        shutil.copyfile(j(SHIM_DIR + "/mmx64.efi"), os.path.join(d, "mmx64.efi"))
        shutil.copyfile(j(SB_DIR + "/grubx64.efi"), os.path.join(d, "grubx64.efi"))
        shutil.copyfile(j(SB_DIR + "/delayos-general-ca.cer"), os.path.join(d, "delayos-general-ca.cer"))
        write_file(os.path.join(d, "grub.cfg"), stub)
    sb_kernel(root)
    for e in efi_entries()[2]:
        if e["label"] == "DelayOS":
            run(["efibootmgr", "-q", "-b", e["num"], "-B"], mutate=True)
    run(["efibootmgr", "-q", "-c", "-d", disk, "-p", str(esp_n), "-L", "DelayOS", "-l", "\\EFI\\DelayOS\\shimx64.efi"], mutate=True)
    if enroll:
        sb_enroll(root)
    return True


def sb_enrolled(root="/"):
    """Is the DelayOS general CA an enrolled Machine Owner Key? (readable without root)"""
    inroot = (lambda c: c) if root == "/" else (lambda c: ["chroot", root] + c)
    rc, out = run(inroot(["mokutil", "--test-key", SB_DIR + "/delayos-general-ca.cer"]), quiet=True)
    return "already enrolled" in out


def sb_enroll(root="/"):
    """Queue the DelayOS general CA for MOK enrollment (MokManager asks at the next start through shim).
    Returns "enrolled", "queued" or "failed"."""
    j = lambda p: os.path.join(root, p.lstrip("/"))
    inroot = (lambda c: c) if root == "/" else (lambda c: ["chroot", root] + c)
    cer = SB_DIR + "/delayos-general-ca.cer"
    if sb_enrolled(root):
        log("sb: DelayOS general CA already enrolled")
        return "enrolled"
    if DRY:
        log("would queue the DelayOS general CA for MOK enrollment")
        return "queued"
    rc, h = run(inroot(["mokutil", "--generate-hash=" + MOK_PASSWORD]), quiet=True)
    hf = j("/run/delayos-mok.hash") if root != "/" else RUN + "/mok.hash"
    os.makedirs(os.path.dirname(hf), exist_ok=True)
    write_file(hf, h.strip() + "\n", 0o600)
    rc, out = run(inroot(["mokutil", "--import", cer, "--hash-file", "/run/delayos-mok.hash" if root != "/" else hf]), mutate=True)
    remove_file(hf)
    if rc != 0:
        log("sb: MOK import failed; run 'sudo delay-winsetup sb-setup' later")
        return "failed"
    return "queued"


def sb_kernel(root="/"):
    """Put the DelayOS-signed linux-delayos image into /boot when it matches the installed kernel."""
    j = lambda p: os.path.join(root, p.lstrip("/"))
    signed, want = j(SB_DIR + "/vmlinuz-linux-delayos.signed"), read_text(j(SB_DIR + "/vmlinuz-linux-delayos.sha256")).split()
    boot = j("/boot/vmlinuz-linux-delayos")
    if not os.path.isfile(signed) or not os.path.isfile(boot):
        return False
    cur = sha256_file(boot)
    if cur == sha256_file(signed):
        return True
    if not want or cur != want[0]:
        log("sb: /boot/vmlinuz-linux-delayos is not the kernel the signed image was made from; it stays unsigned "
            "(it will not boot with Secure Boot on)")
        return False
    if DRY:
        log("would install the signed kernel image")
        return True
    shutil.copyfile(signed, boot + ".tmp")
    os.replace(boot + ".tmp", boot)
    log("sb: signed linux-delayos image installed")
    return True


def sb_refresh_grub():
    """After an update of delayos-sb-general: put its signed GRUB on the EFI partition, where sb_setup
    put the one of the installation (pacman only replaces the copy under /usr/share). Replaces existing
    files only, and EFI/BOOT only while DelayOS's shim is the fallback loader there."""
    src = SB_DIR + "/grubx64.efi"
    if not os.path.isfile(src):
        return False
    try:
        esp, _dev = find_esp("/")
    except Fail:
        return False
    want, done = sha256_file(src), False
    for sub in ("EFI/DelayOS", "EFI/BOOT"):
        d = find_ci(esp, sub)
        dst = find_ci(d, "grubx64.efi") if d else None
        shim = find_ci(d, "shimx64.efi" if sub == "EFI/DelayOS" else "BOOTX64.EFI") if d else None
        if not dst or not shim or sha256_file(dst) == want:
            continue
        if not os.path.isfile(SHIM_DIR + "/shimx64.efi") or sha256_file(shim) != sha256_file(SHIM_DIR + "/shimx64.efi"):
            continue                                   # not the boot chain sb_setup installed
        if DRY:
            log("would update the signed GRUB in %s" % sub)
            continue
        try:
            shutil.copyfile(src, dst + ".new")
            if sha256_file(dst + ".new") != want:
                raise OSError("short write")
            os.replace(dst + ".new", dst)
            done = True
            log("sb: signed GRUB updated in %s" % sub)
        except OSError as e:
            log("sb: could not update the signed GRUB in %s: %s" % (sub, e))
            remove_file(dst + ".new")
    return done


def cmd_sb_kernel(a):
    conf = load_conf()
    if conf.get("SB") == "1":
        sb_kernel("/")
        sb_refresh_grub()
    return 0


def cmd_sb_setup(a):
    esp, esp_dev = find_esp("/")
    info = next((d for d in lsblk(esp_dev) if d.get("path") == esp_dev), {})
    ok = sb_setup("/", esp, "/dev/" + info.get("pkname", ""), partnum(esp_dev))
    if ok:
        conf = load_conf()
        conf["SB"] = "1"
        conf["SB_MOK"] = "enrolled" if sb_enrolled() else "queued"
        save_conf(conf)
        if conf["SB_MOK"] == "enrolled":
            print("Secure Boot 준비가 끝났습니다. DelayOS 키는 이 PC에 이미 등록되어 있으므로 더 할 일이 없습니다."
                  + ("" if secure_boot() else " BIOS에서 Secure Boot를 켜도 DelayOS가 그대로 시작됩니다."))
        else:
            print("Secure Boot 준비가 끝났습니다. 다시 시작하면 파란 화면(MOK 관리)이 나옵니다: "
                  "Enroll MOK > Continue > Yes > 암호 '%s' 입력 > Reboot. 그다음 BIOS에서 Secure Boot를 켜세요." % MOK_PASSWORD)
        return 0
    print("이 DelayOS 빌드에는 Secure Boot용 서명 파일이 없습니다 (Secure Boot 미지원 빌드).")
    return 1


def cmd_sb_install(a):
    """Installer step for every installation (Calamares module delayos_winsetup, after "bootloader").
    The PC was started with Secure Boot ON from the signed live medium (docs/secure-boot.md), so the
    installed system has to start the same way: shim -> signed GRUB -> signed linux-delayos. The
    DelayOS general CA is this PC's MOK already (the live medium could not have started without
    it), so normally nothing is queued. With Secure Boot off nothing is changed (--force: do it
    anyway); "sudo delay-winsetup sb-setup" does the same on the installed system later."""
    root = a.root
    res = {"ok": True, "sb": False, "sb_mok": "", "secure_boot": secure_boot(), "sb_build": sb_available(root)}
    if not res["sb_build"] or not os.path.isdir("/sys/firmware/efi") or not (res["secure_boot"] or a.force):
        if res["secure_boot"] and not res["sb_build"]:
            log("sb-install: Secure Boot is on, but this build has no signed boot files: the installed system "
                "will only start with Secure Boot off")
        print(json.dumps(res, ensure_ascii=False))
        return 0
    esp, esp_dev = find_esp(root)
    info = next((d for d in lsblk(esp_dev) if d.get("path") == esp_dev), {})
    if not info.get("pkname"):
        raise Fail("esp", detail="no parent disk for " + esp_dev)
    if sb_setup(root, esp, "/dev/" + info["pkname"], partnum(esp_dev), enroll=False):
        conf = load_conf(root)
        conf["SB"] = "1"
        conf["SB_MOK"] = "enrolled" if sb_enrolled(root) else sb_enroll(root)
        if not DRY:
            save_conf(conf, root)
        res.update(sb=True, sb_mok=conf["SB_MOK"])
        log("sb-install: Secure Boot chain installed, DelayOS general CA: %s" % conf["SB_MOK"])
    print(json.dumps(res, ensure_ascii=False))
    return 0


# ---- stage 2 -------------------------------------------------------------------------------------
def find_esp(root):
    for mp in ("boot/efi", "efi", "boot"):
        p = os.path.join(root, mp)
        rc, out = run(["findmnt", "-no", "SOURCE,FSTYPE", "-M", p], quiet=True)
        f = out.split()
        if rc == 0 and len(f) >= 2 and f[1] == "vfat":
            return p, os.path.realpath(f[0])
    raise Fail("esp")


def find_local_iso():
    """A Windows 11 ISO on plugged-in media (e.g. next to the DelayOS USB), newest first."""
    hits = []
    for base in ("/run/media", "/mnt", "/media", "/run/archiso/bootmnt"):
        for dp, dn, fn in os.walk(base):
            if dp.count(os.sep) - base.count(os.sep) > 3:
                dn[:] = []
            for f in fn:
                if re.match(r"(?i)^win(dows)?[ _-]?11.*\.iso$", f):
                    hits.append(os.path.join(dp, f))
    hits.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return hits[0] if hits else ""


def published_hashes():
    """Every SHA-256 on Microsoft's Windows 11 download page (all languages), or an empty set."""
    try:
        page = MsDownload().get(MsDownload.PAGE, timeout=20)
        return set(h.lower() for h in re.findall(r"<td[^>]*>\s*([A-Fa-f0-9]{64})\s*</td>", page))
    except Exception as e:  # noqa
        log("Microsoft hash list not available: %s" % e)
        return set()


def local_iso_verified(path, p0, p1):
    """A local ISO needs no Microsoft SHA-256. It is still compared with the published list when that
    is possible: a match means "official, unmodified" (and the gaming cleanup applies by default)."""
    size = None
    if os.path.isdir(path):
        return False            # folder: nothing to hash
    if not os.path.isfile(path):
        size = iso_image_size(path)     # disc in a drive / ISO written to a USB partition
        if not size:
            return False
    known = published_hashes()
    if not known:
        return False
    progress(p0, "지정한 ISO 파일을 확인하는 중 (SHA-256)…")
    try:
        got = sha256_file(path, lambda a_, b_: progress(p0 + (p1 - p0) * a_ / b_, "지정한 ISO 파일을 확인하는 중 (SHA-256)…"), size)
    except OSError as e:
        log("local ISO could not be read for the check: %s" % e)
        return False
    ok = got in known
    log("local ISO sha256 %s: %s" % (got, "matches a value Microsoft publishes" if ok else "not in Microsoft's published list"))
    return ok


def obtain_iso(root, iso_arg, p0, p1):
    """Returns (source, downloaded?, verified?). source is an ISO file, or for a local source also an
    optical drive (/dev/sr1) or a folder with the contents of the medium. Downloads only from
    Microsoft; a local source is used as it is (no SHA-256 is required, see local_iso_verified)."""
    span = p1 - p0
    if iso_arg:
        iso_arg = os.path.realpath(os.path.expanduser(iso_arg))
        if os.path.isdir(iso_arg):
            if not find_ci(iso_arg, "sources"):
                raise Fail("iso", detail="%s has no 'sources' folder" % iso_arg)
        elif not (os.path.isfile(iso_arg) or (os.path.exists(iso_arg) and iso_arg.startswith("/dev/"))):
            raise Fail("iso", detail=iso_arg)
        log("using the Windows medium given by the user: " + iso_arg)
        verified = False if DRY else local_iso_verified(iso_arg, p0, p0 + span * 0.5)
        return iso_arg, False, verified
    cache = os.path.join(root, "var/cache/delayos/winsetup")
    dest = os.path.join(cache, "windows.iso")
    if DRY:
        d = MsDownload()
        try:
            url, sha = d.resolve()
            log("would download %s (sha256 %s)" % (url.split("?")[0], sha or "not published"))
        except Fail as e:
            log("download link could not be resolved in dry-run: %s" % e.detail)
        return dest, True, True
    os.makedirs(cache, exist_ok=True)
    d = MsDownload()
    progress(p0, "Microsoft에서 Windows 11 다운로드 주소를 확인하는 중…")
    try:
        url, sha = d.resolve()
    except Fail:
        local = find_local_iso()
        if local:
            log("download API failed, using local ISO " + local)
            return local, False, local_iso_verified(local, p0, p0 + span * 0.5)
        raise
    st = os.statvfs(cache)
    if st.f_bavail * st.f_frsize < 9 * GIB:
        raise Fail("space")

    def cb(done, total):
        frac = done / total if total else 0
        progress(p0 + span * 0.9 * frac, "Windows 11 다운로드 중… %.1f / %.1f GB" % (done / GIB, total / GIB))
    size = d.download(url, dest, cb)
    log("downloaded %d bytes" % size)
    if sha:
        progress(p0 + span * 0.9, "받은 파일을 확인하는 중 (SHA-256)…")
        got = sha256_file(dest, lambda a_, b_: progress(p0 + span * (0.9 + 0.1 * a_ / b_), "받은 파일을 확인하는 중 (SHA-256)…"))
        if got != sha:
            os.unlink(dest)
            raise Fail("sha", detail="got %s want %s" % (got, sha))
        log("SHA-256 matches the value Microsoft publishes: " + got)
    else:
        log("Microsoft did not publish a SHA-256 for this download in the page; size %d, TLS download from %s"
            % (size, urllib.parse.urlparse(url).hostname))
    return dest, True, True


class IsoSource:
    """The Windows medium, mounted read-only: an ISO file (loop), an optical drive / USB partition,
    or a folder that already holds the files."""
    def __init__(self, src):
        self.src, self.m = src, None

    def __enter__(self):
        if os.path.isdir(self.src):
            return self.src
        opts = "ro" if self.src.startswith("/dev/") else "loop,ro"
        try:
            self.m = Mount(self.src, "udf", opts)
            return self.m.__enter__()
        except Fail:
            self.m = Mount(self.src, None, opts)
            return self.m.__enter__()

    def __exit__(self, *a):
        if self.m:
            self.m.__exit__()
        return False


# Answer files inside an image that Windows Setup would read (some of them before ours)
IMAGE_ANSWER_FILES = ("Windows/Panther/Unattend/Unattend.xml", "Windows/Panther/Unattend/Autounattend.xml",
                      "Windows/Panther/Unattend.xml", "Windows/System32/Sysprep/Unattend.xml", "Unattend.xml", "Autounattend.xml")


def inspect_medium(im, inst, image):
    """What a (custom) medium brings along. Nothing of it stops the installation; it is logged, and the
    WinPE script sets the image's own answer files aside so that the DelayOS answer file is the one
    Windows uses. Returns a list of short notes."""
    notes = []
    for f in ("autounattend.xml", "unattend.xml"):
        if find_ci(im, f):
            notes.append("medium has its own %s (not used: DelayOS does not run Windows Setup)" % f)
    if find_ci(im, "sources/$OEM$"):
        notes.append("medium has sources/$OEM$ (not copied)")
    if not find_ci(im, "sources/setup.exe") and not find_ci(im, "setup.exe"):
        notes.append("medium has no setup.exe (rebuilt medium)")
    for f in IMAGE_ANSWER_FILES:
        if wim_has(inst, image["index"], "/" + f):
            notes.append("image has its own answer file %s (set aside at install time)" % f)
    for f, what in (("Windows/Setup/Scripts/SetupComplete.cmd", "its own SetupComplete.cmd (still runs, before the first logon)"),
                    ("Windows/Setup/Scripts/OOBE.cmd", "its own OOBE.cmd (still runs)")):
        if wim_has(inst, image["index"], "/" + f):
            notes.append("image has " + what)
    for f, what in (("Windows/System32/SecurityHealthService.exe", "Windows Security"), ("Program Files/Windows Defender/MsMpEng.exe", "Microsoft Defender"),
                    ("Windows/System32/wuaueng.dll", "Windows Update"), ("Windows/System32/WindowsPowerShell/v1.0/Modules/ScheduledTasks", "the ScheduledTasks PowerShell module")):
        if wim_has(inst, image["index"], "/" + f) is False:
            notes.append("image has no " + what)
    return notes


def run_progress(cmd, watch, total, cb):
    """Run a wimlib command; cb(bytes written so far, total) every two seconds. watch() -> bytes."""
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    while proc.poll() is None:
        time.sleep(2)
        try:
            cb(min(watch(), total), total)
        except OSError:
            pass
    tail = (proc.stdout.read() or "")[-400:]
    if proc.returncode != 0:
        raise Fail("internal", detail="%s: %s" % (" ".join(cmd[:2]), tail))


def fill_staging(iso, stg_dev, win_dev, st, edition, key, opts, p0, p1):
    """Windows medium -> staging partition (boot files, boot.wim, install image) + unattended payload.
    opts: index, image_name (explicit image choice), cleanup ("auto"/"on"/"off"), verified (the medium
    is an unmodified Microsoft ISO), cache (folder on the DelayOS root for temporary files).
    Returns {image, edition, cleanup, notes}."""
    span = p1 - p0
    nonce = st["nonce"]
    verified = bool(opts.get("verified"))
    # gaming cleanup: by default only for an unmodified Microsoft image; a custom image is already
    # the way its author wants it
    cleanup = opts.get("cleanup") == "on" or (opts.get("cleanup", "auto") == "auto" and verified)
    info = {"image": {}, "edition": edition, "cleanup": cleanup, "notes": []}
    if DRY:
        log("would extract %s to %s, add the unattended files (edition %s, gaming cleanup %s) and mark %s"
            % (iso, stg_dev, edition, "on" if cleanup else "off", win_dev))
        return info
    run(["wipefs", "-a", stg_dev], mutate=True)
    run(["mkfs.vfat", "-F", "32", "-n", "DELAYWINSET", stg_dev], mutate=True, check=True)
    medium = IsoSource(iso)
    im = medium.__enter__()
    tmp_wim = ""
    try:
        boot_wim = find_ci(im, "sources/boot.wim")
        sdir = find_ci(im, "sources")
        inst = find_ci(im, "sources/install.wim") or find_ci(im, "sources/install.esd") or find_ci(im, "sources/install.swm")
        if not boot_wim or not inst or not find_ci(im, "efi/boot/bootx64.efi"):
            raise Fail("iso", detail="no sources/boot.wim, sources/install.wim|esd|swm or efi/boot/bootx64.efi")
        kind = inst.lower().rsplit(".", 1)[-1]
        parts = [inst]
        if kind == "swm":       # already split by whoever made the medium: install.swm, install2.swm, ...
            parts = sorted(os.path.join(sdir, f) for f in os.listdir(sdir) if re.match(r"(?i)^install\d*\.swm$", f))
        images = wim_images(inst)
        log("images on the medium (%s): %s" % (os.path.basename(inst), "; ".join(image_label(i) for i in images) or "none"))
        image, how = select_image(images, edition, int(opts.get("index") or 0), opts.get("image_name") or "")
        index = image["index"]
        log("installing image %s (chosen by: %s; build %s, language %s)" % (image_label(image), how, image["build"] or "?", image["lang"] or "?"))
        if image["arch"] not in ("", "9"):
            raise Fail("iso_arch", detail="ARCH=%s" % image["arch"])
        if kind != "swm":
            if wim_has(inst, index, "/Windows/System32/WindowsPowerShell/v1.0/powershell.exe") is False:
                raise Fail("iso_nops")
            info["notes"] = inspect_medium(im, inst, image)
            for n in info["notes"]:
                log("medium: " + n)
        info["image"] = image
        # the edition that is really installed decides the generic installation key (none for other editions)
        real = image["edition"] or image.get("flags", "")
        info["edition"] = {v: k for k, v in EDITION_IDS.items()}.get(real, real or "custom")
        if info["edition"] != edition:
            log("the image is edition '%s', not the requested '%s'" % (info["edition"], edition))
        with Mount(stg_dev, "vfat", "rw,utf8") as sm:
            fs = os.statvfs(sm)
            free = fs.f_bavail * fs.f_frsize
            isize = sum(os.path.getsize(p) for p in parts)
            need = os.path.getsize(boot_wim) + isize + 300 * MIB
            if free < need and kind != "swm" and len(images) > 1:
                need = os.path.getsize(boot_wim) + isize // 2 + 300 * MIB      # only one image will be exported
                kind_export = True
            else:
                kind_export = False
            if free < need:
                raise Fail("stage_small", detail="need %d MiB, have %d MiB" % (need // MIB, free // MIB))
            progress(p0, "Windows 설치 파일을 준비하는 중…")
            for d in ("efi", "boot"):
                src = find_ci(im, d)
                if src:
                    copy_tree(src, os.path.join(sm, d))
            for f in ("bootmgr.efi", "bootmgr"):
                src = find_ci(im, f)
                if src:
                    shutil.copyfile(src, os.path.join(sm, f))
            os.makedirs(os.path.join(sm, "sources"), exist_ok=True)
            bw = os.path.join(sm, "sources", "boot.wim")
            copy_progress(boot_wim, bw, lambda a_, b_: progress(p0 + span * 0.12 * a_ / b_, "Windows 설치 파일을 준비하는 중…"))
            ssrc = os.path.join(sm, "sources")
            img_msg = lambda a_, b_: progress(p0 + span * (0.12 + 0.75 * (a_ / b_ if b_ else 0)),
                                              "Windows 이미지를 복사하는 중… %.1f / %.1f GB" % (a_ / GIB, b_ / GIB))
            swm_size = lambda: sum(os.path.getsize(os.path.join(ssrc, f)) for f in os.listdir(ssrc) if f.lower().endswith(".swm"))
            # FAT32 holds files below 4 GiB only. A big install.wim is split; a big install.esd (solid
            # compression, cannot be split) or a medium that does not fit is first reduced to the one
            # image that is installed (temporary file on the DelayOS root).
            if kind != "swm" and (kind_export or (kind == "esd" and isize > 3800 * MIB)):
                cache = opts.get("cache") or RUN
                os.makedirs(cache, exist_ok=True)
                cs = os.statvfs(cache)
                if cs.f_bavail * cs.f_frsize < isize * (2 if kind == "esd" else 1) + GIB:
                    raise Fail("space", detail="temporary export of the image")
                tmp_wim = os.path.join(cache, "install-export.wim")
                remove_file(tmp_wim)
                log("exporting image %d of %s to a temporary WIM" % (index, os.path.basename(inst)))
                cmd = ["wimlib-imagex", "export", inst, str(index), tmp_wim] + (["--compress=LZX"] if kind == "esd" else [])
                run_progress(cmd, lambda: os.path.getsize(tmp_wim) if os.path.exists(tmp_wim) else 0, isize,
                             lambda a_, b_: progress(p0 + span * (0.12 + 0.35 * a_ / b_), "Windows 이미지를 변환하는 중… (몇 분 걸릴 수 있습니다)"))
                inst, kind, index, isize, parts = tmp_wim, "wim", 1, os.path.getsize(tmp_wim), [tmp_wim]
                if os.path.getsize(boot_wim) + isize + 300 * MIB > free:
                    raise Fail("stage_small", detail="exported image %d MiB" % (isize // MIB))
            if kind == "swm":
                wimfile, swm = "install.swm", "/SWMFile:%STG%:\\sources\\install*.swm"
                done = 0
                for p in parts:
                    copy_progress(p, os.path.join(ssrc, os.path.basename(p).lower()), lambda a_, b_, d=done: img_msg(d + a_, isize))
                    done += os.path.getsize(p)
            elif kind == "wim" and isize > 3800 * MIB:
                wimfile, swm = "install.swm", "/SWMFile:%STG%:\\sources\\install*.swm"
                run_progress(["wimlib-imagex", "split", inst, os.path.join(ssrc, "install.swm"), "3800"], swm_size, isize, img_msg)
            else:
                wimfile, swm = "install." + kind, ""
                copy_progress(inst, os.path.join(ssrc, wimfile), img_msg)
            progress(p0 + span * 0.88, "자동 설치를 구성하는 중…")
            # payload that WinPE copies to C:\ProgramData\DelayOS\winsetup
            dd = os.path.join(sm, "delayos")
            pay = os.path.join(dd, "payload")
            os.makedirs(os.path.join(pay, "helper"), exist_ok=True)
            write_file(os.path.join(dd, "staging.tag"), nonce + "\r\n")
            # Microsoft's generic installation key only when it is the key of the edition that is really
            # installed: a key for another edition makes the "specialize" pass fail. No key = the image
            # keeps whatever it has (custom images, other editions).
            # An image whose metadata has no EDITIONID (rebuilt image) gets no key either.
            gkey = GENERIC_KEYS.get(info["edition"], "") if image["edition"] else ""
            log("answer file: " + ("generic installation key for edition " + info["edition"] if gkey else "no product key (the image keeps its own)"))
            # A custom image often has the first-run experience (OOBE) taken out or changed; Windows
            # then stops at "Why did my PC restart?" when it tries to show it (seen in the VM test).
            # For every image that is not an unmodified Microsoft one the answer file therefore skips
            # the first-run screens altogether: the account comes from the answer file anyway.
            skip_oobe = not verified
            log("answer file: first-run experience (OOBE) %s" % ("skipped (custom image)" if skip_oobe else "hidden pages, Microsoft default"))
            # Korean progress text in Windows PE needs a Korean CONSOLE font: the console window of
            # code page 949 draws with GulimChe (gulim.ttc; the "TrueTypeFont" list of the console).
            # Microsoft's Korean medium has it; a custom boot image may not, and the text then shows
            # as empty boxes: English there. Malgun Gothic alone is not enough: it draws the window
            # title, not the console text (seen with a custom image in the 2026.11.27 ISO test).
            bidx0 = wim_boot_index(bw)
            ko_fonts = [f for f in ("gulim.ttc", "gulimche.ttf", "gulimche.ttc")
                        if wim_has(bw, bidx0, "/Windows/Fonts/" + f)]
            kofont = verified or bool(ko_fonts)
            log("boot image: Korean console font %s -> %s messages" % (ko_fonts or "not found", "Korean" if kofont else "English"))
            sub = {"NONCE": nonce, "INDEX": index, "WIMFILE": wimfile, "SWM": swm, "KOFONT": "1" if kofont else "",
                   "PRODUCT_KEY": "<ProductKey>%s</ProductKey>" % gkey if gkey else "<!-- no generic key for this edition -->",
                   "OOBE_SKIP": "<SkipMachineOOBE>true</SkipMachineOOBE>\r\n        <SkipUserOOBE>true</SkipUserOOBE>" if skip_oobe
                                else "<!-- first-run pages hidden one by one above -->"}
            write_file(os.path.join(dd, "install.cmd"), template("install.cmd.in", sub, encoding="cp949"))
            write_file(os.path.join(dd, "unattend.xml"), template("unattend.xml.in", sub, encoding="utf-8"))
            write_file(os.path.join(pay, "specialize.cmd"), template("specialize.cmd"))
            write_file(os.path.join(pay, "finish.ps1"), template("finish.ps1"))
            # gaming cleanup: the script is always there (report / undo / applying it later by hand);
            # the marker file decides whether the unattended setup runs it
            write_file(os.path.join(pay, "cleanup.ps1"), template("cleanup.ps1"))
            write_file(os.path.join(pay, "cleanup-undo.cmd"), template("cleanup-undo.cmd"))
            if cleanup:
                write_file(os.path.join(pay, "cleanup.on"), "1\r\n")
            if key:
                write_file(os.path.join(pay, "productkey.txt"), key + "\r\n")
            for f in os.listdir(HELPER_SRC):
                if f.endswith((".ps1", ".json")):
                    shutil.copyfile(os.path.join(HELPER_SRC, f), os.path.join(pay, "helper", f))
            # WinPE: run our script instead of Windows Setup (winpeshl.ini), with an answer-file fallback
            tmp = tempfile.mkdtemp(prefix="pe-", dir=RUN)
            try:
                files = {"winpeshl.ini": ("/Windows/System32/winpeshl.ini", template("winpeshl.ini")),
                         "delayos-start.cmd": ("/delayos-start.cmd", template("delayos-start.cmd")),
                         "autounattend.xml": ("/autounattend.xml", template("autounattend.xml", encoding="utf-8"))}
                cmds = ""
                for name, (dst, data) in files.items():
                    write_file(os.path.join(tmp, name), data)
                    cmds += "add '%s' '%s'\n" % (os.path.join(tmp, name), dst)
                bidx = wim_boot_index(bw)
                takeover = pe_shell_takeover(bw, bidx, tmp)
                if takeover:
                    info["notes"].append("the medium starts its own installer in Windows PE: bypassed (DelayOS script runs instead)")
                run(["wimlib-imagex", "update", bw, str(bidx)], mutate=True, check=True, stdin=cmds + takeover, timeout=900)
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
            progress(p0 + span * 0.95, "자동 설치를 구성하는 중…")
    finally:
        medium.__exit__()
        if tmp_wim:
            remove_file(tmp_wim)
    # the Windows partition: an empty FAT32 volume that only carries our marker, so WinPE finds exactly
    # this volume; WinPE then formats it as NTFS itself (no NTFS tools needed on the DelayOS side)
    run(["wipefs", "-a", win_dev], mutate=True)
    run(["mkfs.vfat", "-F", "32", "-n", "DELAYOSWIN", win_dev], mutate=True, check=True, timeout=900)
    with Mount(win_dev, "vfat", "rw") as wm:
        write_file(os.path.join(wm, "DelayOS-WinTarget.tag"), nonce + "\r\n")
    return info


def arm_esp(esp, st):
    d = os.path.join(find_ci(esp, "EFI") or os.path.join(esp, "EFI"), "DelayOS", "winsetup")
    if DRY:
        log("would write markers to " + d)
        return d
    os.makedirs(d, exist_ok=True)
    for f in ("done.json", "pe-done", "winpe.log", "finish.log", "failed"):
        remove_file(os.path.join(d, f))
    write_file(os.path.join(d, "esp.tag"), st["nonce"] + "\r\n")
    write_file(os.path.join(d, "pending"), "1\r\n")
    write_file(os.path.join(d, "pe-pending"), "1\r\n")
    # the Windows helper installer, same place delay-winboot uses
    hd = os.path.join(os.path.dirname(d), "winboot")
    os.makedirs(hd, exist_ok=True)
    for f in os.listdir(HELPER_SRC):
        if f.endswith((".ps1", ".json")):
            shutil.copyfile(os.path.join(HELPER_SRC, f), os.path.join(hd, f))
        elif f.endswith(".cmd"):
            shutil.copyfile(os.path.join(HELPER_SRC, f), os.path.join(hd, "setup.cmd"))
    return d


def copy_log(esp_dir):
    if DRY or not esp_dir:
        return
    try:
        shutil.copyfile(LOGS[0], os.path.join(esp_dir, "winsetup.log"))
    except OSError:
        pass


def do_stage(root, st, edition, key, iso_arg, win_gb, opts=None):
    """opts: index / image_name (which image of the medium), cleanup "auto" (default) / "on" / "off"."""
    opts = dict(opts or {})
    need_tools("wimlib-imagex", "mkfs.vfat", "efibootmgr")
    disk = st["disk"]
    stg_dev = verify_part(st.get("stage_partuuid"), STG_NAME, disk)
    win_dev = verify_part(st.get("win_partuuid"), WIN_NAME, disk)
    esp, esp_dev = find_esp(root)
    if find_ci(esp, "EFI/Microsoft/Boot/bootmgfw.efi"):
        raise Fail("has_windows")
    fs = os.statvfs(esp)
    if fs.f_bavail * fs.f_frsize < 80 * MIB:
        raise Fail("esp_full")
    conf = load_conf(root)
    conf.update(ENABLED="1", STATE="preparing", REASON="", DISK=disk, DISK_PTUUID=st.get("disk_ptuuid", ""),
                ROOT_PARTUUID=st.get("root_partuuid", ""), STAGE_PARTUUID=st.get("stage_partuuid", ""),
                WIN_PARTUUID=st.get("win_partuuid", ""), ESP_PARTUUID=blkid(esp_dev, "PART_ENTRY_UUID").lower(),
                ESP_FSUUID=blkid(esp_dev, "UUID"), NONCE=st["nonce"], EDITION=edition, WIN_GB=str(win_gb),
                STAGE_GB=str(STAGE_GB), RECLAIM=conf.get("RECLAIM", "grow-root"), CREATED=str(int(time.time())),
                SB=conf.get("SB", "0"), USER_KEY="1" if key else "0")
    save_conf(conf, root)
    iso, downloaded, verified = obtain_iso(root, iso_arg, 0.02, 0.62)
    opts.update(verified=verified, cache=os.path.join(root, "var/cache/delayos/winsetup"))
    try:
        info = fill_staging(iso, stg_dev, win_dev, st, edition, key, opts, 0.62, 0.93)
    finally:
        if downloaded and not DRY:
            remove_file(iso)
    image = info.get("image") or {}
    edition = info.get("edition") or edition
    conf.update(EDITION=edition, ISO_SOURCE="download" if downloaded else ("local-official" if verified else "local-unverified"),
                CLEANUP="1" if info.get("cleanup") else "0", IMAGE_INDEX=str(image.get("index", "")),
                IMAGE_NAME=(image.get("name") or image.get("display") or "")[:80], IMAGE_BUILD=image.get("build", ""))
    if not downloaded and not verified:
        log("WARNING: the Windows medium given by the user is not a file Microsoft publishes a SHA-256 for "
            "(custom or modified image, or no internet to compare): used as it is, without verification")
        print("WARNING " + MSG["iso_unverified"], flush=True)
    log("gaming cleanup: %s (%s)" % ("on" if info.get("cleanup") else "off",
                                     {"on": "asked for", "off": "switched off"}.get(opts.get("cleanup"), "automatic: on for an unmodified Microsoft image only")))
    progress(0.94, "부팅 항목을 준비하는 중…")
    conf["STAGE_FSUUID"] = blkid(stg_dev, "UUID") if not DRY else ""
    esp_dir = arm_esp(esp, st)
    # hide the Windows partition from the DelayOS desktop (udisks: Dolphin, Files, automount)
    rule = ("# DelayOS hidden Windows (delay-winsetup)\n"
            'ENV{ID_PART_ENTRY_UUID}=="%s", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"\n'
            'ENV{ID_PART_ENTRY_UUID}=="%s", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"\n'
            % (st.get("win_partuuid", ""), st.get("stage_partuuid", "")))
    write_file(os.path.join(root, UDEV_RULE.lstrip("/")), rule)
    if not DRY:
        wants = os.path.join(root, "etc/systemd/system/multi-user.target.wants")
        os.makedirs(wants, exist_ok=True)
        link = os.path.join(wants, "delay-winsetup-finalize.service")
        if not os.path.lexists(link):
            os.symlink("/etc/systemd/system/delay-winsetup-finalize.service", link)
    # Secure Boot chain (only when this build ships the signed files)
    if sb_available(root):
        try:
            # the MOK request is queued by "finalize" when Windows is ready (see sb_setup)
            if sb_setup(root, esp, disk, partnum(esp_dev), enroll=False):
                conf["SB"] = "1"
                # installed from the Secure Boot live medium: the CA is this PC's MOK already
                # (docs/secure-boot.md), so nothing is queued later and no blue screen follows
                conf["SB_MOK"] = "enrolled" if sb_enrolled(root) else "wanted"
        except Exception as e:  # noqa
            log("sb setup failed: %s" % e)
    conf["STATE"] = "pending"
    conf["HOPS"] = "0"
    save_conf(conf, root)
    num = create_setup_entry(disk, st["stage_n"])
    conf["SETUP_BOOTNUM"] = num
    save_conf(conf, root)
    log("stage finished: Windows setup armed (Boot%s), edition %s, source %s, gaming cleanup %s, Secure Boot chain %s"
        % (num, edition, conf["ISO_SOURCE"], conf["CLEANUP"], conf["SB"]))
    copy_log(esp_dir)
    progress(1.0, "Windows 게임 지원 준비 완료")
    return conf


def grub_mkconfig(root):
    cmd = ["grub-mkconfig", "-o", "/boot/grub/grub.cfg"]
    if not os.path.exists(os.path.join(root, "boot/grub/grub.cfg")):
        return
    rc, out = run(cmd if root == "/" else ["chroot", root] + cmd, mutate=True, timeout=300)
    if rc != 0:
        log("grub-mkconfig failed")


def mark_failed(root, e):
    try:
        conf = load_conf(root)
        if conf.get("ENABLED") == "1":
            conf.update(STATE="failed", REASON=e.code if isinstance(e, Fail) else "internal")
            save_conf(conf, root)
    except Exception:
        pass


def cmd_stage(a):
    root = os.path.realpath(a.root)
    if root != "/":
        LOGS.append(os.path.join(root, LOG.lstrip("/")))
        try:        # carry the stage-1 log over into the installed system
            os.makedirs(os.path.dirname(LOGS[1]), exist_ok=True)
            shutil.copyfile(LOG, LOGS[1])
        except OSError:
            pass
    try:
        st = json.loads(read_text(STATE) or "{}")
    except ValueError:
        st = {}
    if not st.get("disk"):
        raise Fail("state")
    edition = a.edition if a.edition in EDITION_IDS else "home"
    key = ""
    if a.key_file:
        key = read_text(a.key_file).strip().upper()
        if not KEY_RE.match(key):
            log("the product key has the wrong format and is ignored")
            key = ""
    try:
        conf = do_stage(root, st, edition, key, a.iso or "", st.get("win_gb", MIN_WIN_GB), image_opts(a))
    except Exception as e:  # noqa
        mark_failed(root, e)
        raise
    unverified = conf.get("ISO_SOURCE") == "local-unverified"
    print(json.dumps({"ok": True, "sb": conf.get("SB") == "1", "sb_mok": conf.get("SB_MOK", ""), "secure_boot": secure_boot(), "iso_source": conf.get("ISO_SOURCE", ""),
                      "cleanup": conf.get("CLEANUP") == "1", "edition": conf.get("EDITION", ""), "image": conf.get("IMAGE_NAME", ""),
                      "warning": MSG["iso_unverified"] if unverified else ""}, ensure_ascii=False))
    return 0


def image_opts(a):
    return {"index": getattr(a, "index", 0) or 0, "image_name": getattr(a, "image_name", "") or "",
            "cleanup": getattr(a, "cleanup", "auto") or "auto"}


# ---- installed system ------------------------------------------------------------------------------
def state_from_conf(conf):
    disk = conf.get("DISK", "")
    rootp = by_partuuid(conf.get("ROOT_PARTUUID", "")) or ""
    if rootp:
        info = next((d for d in lsblk(rootp) if d.get("path") == rootp), {})
        disk = "/dev/" + info.get("pkname", "") if info.get("pkname") else disk
    st = {"disk": disk, "nonce": conf.get("NONCE", ""), "root_partuuid": conf.get("ROOT_PARTUUID", ""),
          "stage_partuuid": conf.get("STAGE_PARTUUID", ""), "win_partuuid": conf.get("WIN_PARTUUID", ""),
          "disk_ptuuid": conf.get("DISK_PTUUID", ""), "win_gb": int(conf.get("WIN_GB") or MIN_WIN_GB)}
    for k, pu in (("stage_n", st["stage_partuuid"]), ("win_n", st["win_partuuid"]), ("root_n", st["root_partuuid"])):
        dev = by_partuuid(pu) if pu else None
        st[k] = partnum(dev) if dev else 0
    return st


def esp_state():
    try:
        esp, _dev = find_esp("/")
    except Fail:
        return None, {}
    d = find_ci(esp, ESP_REL)
    if not d:
        return None, {}
    s = {f: os.path.exists(os.path.join(d, f)) for f in ("pending", "pe-pending", "pe-done", "done.json", "failed")}
    s["done"] = {}
    if s["done.json"]:
        try:
            with open(os.path.join(d, "done.json"), encoding="utf-8-sig") as f:
                s["done"] = json.load(f)
        except Exception:
            pass
    s["winpe_log"] = read_win_text(os.path.join(d, "winpe.log"))[-4000:]
    return d, s


def read_win_text(path):
    """Text written by Windows: UTF-8 (PowerShell scripts) or code page 949 (cmd.exe in Windows PE)."""
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        return ""
    for enc in ("utf-8-sig", "cp949"):
        try:
            return raw.decode(enc).replace("\r\n", "\n")
        except UnicodeDecodeError:
            pass
    return raw.decode("utf-8", "replace").replace("\r\n", "\n")


def close_gpt_gap(disk, win_pu):
    """Move the Windows GPT entry down into the lowest empty entry below it, if there is one.
    Windows stops with INACCESSIBLE_BOOT_DEVICE (0x7B) on every start when a GPT entry below its own
    is empty (VM test: entries 1, 2, 4 = stop; 1, 2, 3 = starts). Only the entry number changes;
    the partition, its GUID and its name stay as they are."""
    if not win_pu or not have("sgdisk"):
        return False
    try:
        dev = verify_part(win_pu, WIN_NAME, disk)
        used = set(partnum(p["node"]) for p in sfdisk_table(disk)["partitions"])
    except Fail as e:
        log("gap check skipped: %s %s" % (e.code, e.detail))
        return False
    n = partnum(dev)
    low = next((i for i in range(1, n) if i not in used), None)
    if low is None:
        return False
    if run(["findmnt", "-rno", "TARGET", "-S", dev], quiet=True)[1].strip():
        log("gap: %s is mounted, GPT entry %d not moved to %d" % (dev, n, low))
        return False
    log("gap: GPT entry %d is empty below the Windows entry %d: moving the Windows entry down" % (low, n))
    rc, _ = run(["sgdisk", "-r", "%d:%d" % (low, n), disk], mutate=True)
    if rc != 0:
        return False
    run(["partx", "-d", "--nr", str(n), disk], mutate=True)
    run(["partx", "-a", "--nr", str(low), disk], mutate=True)
    settle()
    return True


def keep_delayos_first():
    """DelayOS must stay first in the firmware boot order (a Windows update can move Windows there);
    "Windows 전환" reaches Windows with a one-time BootNext."""
    order, _n, entries = efi_entries()
    me = delayos_entry(entries)
    if me and order and order[0] != me["num"]:
        log("boot order: DelayOS (Boot%s) was not first (%s), putting it first again" % (me["num"], ",".join(order)))
        set_order_first([me["num"]])
        return True
    return False


def maintain(conf):
    """Every start of a finished installation: cheap checks that keep the hidden Windows usable."""
    try:
        keep_delayos_first()
        st = state_from_conf(conf)
        if st["disk"] and conf.get("WIN_PARTUUID"):
            close_gpt_gap(st["disk"], conf["WIN_PARTUUID"])
    except Exception as e:  # noqa
        log("maintain: %s: %s" % (type(e).__name__, e))
    return 0


def grow_root(conf, st):
    """Give the space of the removed partition(s) back to the DelayOS root (online, grow only)."""
    disk, n = st["disk"], st["root_n"]
    rootp = by_partuuid(conf.get("ROOT_PARTUUID", ""))
    rc, out = run(["findmnt", "-no", "SOURCE,FSTYPE", "/"], quiet=True)
    f = out.split()
    if not rootp or not n or len(f) < 2 or os.path.realpath(re.sub(r"\[.*\]$", "", f[0])) != rootp:
        log("grow: root is not the plain partition from the installation, leaving the space unallocated")
        return False
    rc, _ = run(["sfdisk", "--no-reread", "--force", "-N", str(n), disk], mutate=True, stdin=", +\n")
    if rc != 0:
        return False
    run(["partx", "-u", "--nr", str(n), disk], mutate=True)
    settle()
    cmd = {"btrfs": ["btrfs", "filesystem", "resize", "max", "/"], "ext4": ["resize2fs", rootp], "xfs": ["xfs_growfs", "/"]}.get(f[1])
    if cmd:
        run(cmd, mutate=True)
    return True


def delete_part(disk, pu, name):
    dev = verify_part(pu, name, disk)
    n = partnum(dev)
    rc, out = run(["findmnt", "-rno", "TARGET", "-S", dev], quiet=True)
    for mp in out.split():
        run(["umount", mp], mutate=True)
    run(["wipefs", "-a", dev], mutate=True)
    run(["sgdisk", "-d", str(n), disk], mutate=True, check=True)
    run(["partx", "-d", "--nr", str(n), disk], mutate=True)
    settle()


def hide_from_loaders():
    for lc in ("/boot/efi/loader/loader.conf", "/efi/loader/loader.conf", "/boot/loader/loader.conf"):
        t = read_text(lc)
        if t and not re.search(r"^auto-entries", t, re.M):
            write_file(lc, t.rstrip("\n") + "\nauto-entries no\n")
    g = read_text("/etc/default/grub")
    if g and not re.search(r"^GRUB_DISABLE_OS_PROBER=true", g, re.M):
        g = re.sub(r"^#?GRUB_DISABLE_OS_PROBER=.*\n", "", g, flags=re.M).rstrip("\n") + "\nGRUB_DISABLE_OS_PROBER=true\n"
        write_file("/etc/default/grub", g)
    # grub's 31_efi_bootnext lists every firmware entry ("Windows Boot Manager (EFI BootNext)") in
    # the menu: switch it off (a grub package update turns it on again; finalize/remove re-check)
    bn = "/etc/grub.d/31_efi_bootnext"
    if os.path.isfile(bn) and os.access(bn, os.X_OK):
        run(["chmod", "-x", bn], mutate=True)
    # Windows adds its own firmware entry on first start: drop the plain one DelayOS made
    conf = load_conf()
    esp_pu = conf.get("ESP_PARTUUID", "")
    wins = [e for e in efi_entries()[2] if "bootmgfw" in e["path"].lower() and esp_pu and esp_pu in e["path"].lower()]
    if len(wins) > 1:
        for e in wins:
            if e["path"].lower().endswith("bootmgfw.efi") and len(wins) > 1:
                run(["efibootmgr", "-q", "-b", e["num"], "-B"], mutate=True)
                wins = [w for w in wins if w is not e]


def cmd_finalize(a):
    conf = load_conf()
    if conf.get("ENABLED") == "1" and conf.get("STATE") == "done":
        return maintain(conf)
    if conf.get("ENABLED") != "1" or conf.get("STATE") not in ("pending", "preparing"):
        return 0
    if conf.get("STATE") == "preparing":
        conf.update(STATE="failed", REASON="download")
        save_conf(conf)
        return 0
    d, s = esp_state()
    if d is None:
        log("finalize: ESP state not readable")
        return 0
    st = state_from_conf(conf)
    order, nxt, entries = efi_entries()
    me = delayos_entry(entries)
    if s["done.json"] and not s["pending"]:
        log("finalize: Windows reports success: %s" % json.dumps(s["done"], ensure_ascii=False))
        for f in ("finish.log", "winpe.log"):
            src = os.path.join(d, f)
            if os.path.exists(src) and not DRY:
                with open(LOG, "a", encoding="utf-8") as out:
                    out.write("---- %s (from Windows) ----\n%s\n" % (f, read_win_text(src)[-20000:]))
        remove_setup_entries()
        windows_entry(conf, create=True)       # "Windows 전환" (delay-winboot) starts Windows through it
        if me:
            set_order_first([me["num"]])
        try:
            delete_part(st["disk"], conf.get("STAGE_PARTUUID", ""), STG_NAME)
            conf["STAGE_PARTUUID"] = ""
            close_gpt_gap(st["disk"], conf.get("WIN_PARTUUID", ""))
            if conf.get("RECLAIM", "grow-root") == "grow-root":
                grow_root(conf, st)
        except Fail as e:
            log("finalize: staging partition not removed: %s %s" % (e.code, e.detail))
        # Secure Boot: ask for the MOK enrollment now that the unattended part is over. The blue
        # MokManager screen appears at the NEXT start and waits 10 seconds; the login notification
        # (session-notify) tells the user what to do there.
        if conf.get("SB") == "1" and conf.get("SB_MOK", "wanted") in ("wanted", "failed"):
            try:
                conf["SB_MOK"] = sb_enroll("/")
            except Exception as e:  # noqa
                log("sb: MOK request failed: %s" % e)
                conf["SB_MOK"] = "failed"
        for f in ("pe-done", "esp.tag", "pe-pending", "failed"):
            remove_file(os.path.join(d, f))
        hide_from_loaders()
        conf.update(STATE="done", REASON="", ACTIVATED="1" if s["done"].get("activated") else "0",
                    HVCI="1" if s["done"].get("hvci") else "0", FINISHED=str(int(time.time())),
                    CLEANUP_DONE="1" if s["done"].get("cleanup") else "0",
                    WIN_SKIPPED=",".join(str(x) for x in (s["done"].get("skipped") or []))[:200])
        save_conf(conf)
        grub_mkconfig("/")
        copy_log(d)
        return 0
    # Not finished. DelayOS stays first in the firmware boot order, so every restart during the
    # Windows setup lands here first: pass the PC on to the next step with a one-time BootNext
    # (the same mechanism "Windows 전환" uses), at most MAX_HOPS times, then give up for good.
    hops = int(conf.get("HOPS") or 0)
    failed = "FAIL" in s["winpe_log"] or s["failed"]
    target = None
    if s["pending"] and not failed and hops < MAX_HOPS:
        if s["pe-pending"]:
            target = next((e for e in entries if e["label"] == SETUP_LABEL), None)
        elif s["pe-done"]:
            target = windows_entry(conf, create=True)
    if target:
        conf["HOPS"] = str(hops + 1)
        save_conf(conf)
        log("finalize: Windows setup in progress (step %d of at most %d): restarting into '%s' (Boot%s)"
            % (hops + 1, MAX_HOPS, target["label"], target["num"]))
        rc, _ = run(["efibootmgr", "-q", "-n", target["num"]], mutate=True)
        if rc == 0 and not DRY:
            run(["plymouth", "display-message", "--text=Windows 게임 지원을 준비하는 중… 컴퓨터를 끄지 마세요"], quiet=True)
            run(["systemctl", "--no-block", "reboot"], mutate=True)
            time.sleep(120)         # keep the login screen from appearing while the restart starts
            return 0
        if DRY:
            return 0
    reason = "winpe" if failed else ("windows" if s["pe-done"] else "not-started")
    log("finalize: Windows setup did not finish (reason %s, %d restarts used)\n%s" % (reason, hops, s["winpe_log"][-1500:]))
    remove_file(os.path.join(d, "pending"))
    if me:
        set_order_first([me["num"]])
    conf.update(STATE="failed", REASON=reason)
    save_conf(conf)
    copy_log(d)
    return 0


def drop_unfinished_windows_boot(conf):
    """retry: an earlier attempt that got through Windows PE left its Windows boot files on the EFI
    partition (bcdboot) and a firmware entry. They belong to the hidden Windows that is about to be
    installed again; without removing them the "there is already a Windows here" check would refuse
    every retry (seen in the VM test). Only done when this installation's own Windows PE marker
    says it wrote them; a Windows that was there before is never touched (the first stage refuses)."""
    d, s = esp_state()
    try:
        esp, _dev = find_esp("/")
    except Fail:
        return
    ms = find_ci(esp, "EFI/Microsoft")
    if not ms or not d:
        return
    if not (s.get("pe-done") or "image applied" in s.get("winpe_log", "")):
        return
    log("retry: removing the boot files of the unfinished hidden Windows (%s)" % ms)
    we = windows_entry(conf)
    while we:
        run(["efibootmgr", "-q", "-b", we["num"], "-B"], mutate=True)
        we = None if DRY else windows_entry(conf)
    if not DRY:
        shutil.rmtree(ms, ignore_errors=True)
    order, _n, entries = efi_entries()
    me = delayos_entry(entries)
    if me:
        set_order_first([me["num"]])


def cmd_retry(a):
    conf = load_conf()
    if conf.get("ENABLED") != "1" or conf.get("STATE") not in ("failed", "pending", "preparing"):
        raise Fail("not_pending")
    drop_unfinished_windows_boot(conf)
    st = state_from_conf(conf)
    key = ""
    if a.key_file:
        key = read_text(a.key_file).strip().upper()
    os.makedirs(RUN, 0o755, exist_ok=True)
    try:
        conf = do_stage("/", st, a.edition or conf.get("EDITION", "home"), key if KEY_RE.match(key) else "", a.iso or "", st["win_gb"], image_opts(a))
    except Exception as e:  # noqa
        mark_failed("/", e)
        raise
    print("설치할 Windows: %s (%s), 게이밍 정리: %s" % (conf.get("IMAGE_NAME") or conf.get("EDITION", ""),
          {"download": "Microsoft에서 받음", "local-official": "직접 지정한 ISO, Microsoft 공식 파일로 확인됨",
           "local-unverified": "직접 지정한 ISO, 확인하지 않음"}.get(conf.get("ISO_SOURCE"), ""), "적용" if conf.get("CLEANUP") == "1" else "건너뜀"))
    print("준비가 끝났습니다. 컴퓨터를 다시 시작하면 Windows 게임 지원 설치가 자동으로 진행됩니다 (약 20~40분).")
    return 0


def cmd_remove(a):
    conf = load_conf()
    if conf.get("ENABLED") != "1":
        raise Fail("not_pending")
    st = state_from_conf(conf)
    d, s = esp_state()
    remove_setup_entries()
    esp, _dev = find_esp("/")
    ms = find_ci(esp, "EFI/Microsoft")
    we = windows_entry(conf)
    while we:
        run(["efibootmgr", "-q", "-b", we["num"], "-B"], mutate=True)
        we = None if DRY else windows_entry(conf)
    if ms and not DRY:
        shutil.rmtree(ms, ignore_errors=True)       # only ever created by this Windows installation
    elif ms:
        log("would remove " + ms)
    for pu, name, k in ((conf.get("STAGE_PARTUUID"), STG_NAME, "STAGE_PARTUUID"), (conf.get("WIN_PARTUUID"), WIN_NAME, "WIN_PARTUUID")):
        if pu:
            try:
                delete_part(st["disk"], pu, name)
                conf[k] = ""
            except Fail as e:
                log("remove: %s: %s %s" % (name, e.code, e.detail))
    if conf.get("RECLAIM", "grow-root") == "grow-root":
        grow_root(conf, st)
    if d and not DRY:
        shutil.rmtree(d, ignore_errors=True)
    remove_file(UDEV_RULE)
    conf.update(STATE="removed", ENABLED="0")
    save_conf(conf)
    grub_mkconfig("/")
    print("Windows 게임 지원을 제거했습니다. 사용하던 공간은 DelayOS로 돌아갑니다.")
    return 0


def status():
    conf = load_conf()
    st = {"enabled": conf.get("ENABLED") == "1", "state": conf.get("STATE", "none"), "reason": conf.get("REASON", ""),
          "edition": conf.get("EDITION", ""), "win_gb": conf.get("WIN_GB", ""), "secure_boot": secure_boot(),
          "sb_chain": conf.get("SB") == "1", "sb_build": sb_available(), "activated": conf.get("ACTIVATED", ""),
          "hvci": conf.get("HVCI", ""), "tpm": tpm_facts(), "log": LOG,
          "iso_source": conf.get("ISO_SOURCE", ""), "image": conf.get("IMAGE_NAME", ""),
          "cleanup": conf.get("CLEANUP_DONE", conf.get("CLEANUP", "")), "skipped": conf.get("WIN_SKIPPED", "")}
    text = {"none": "설치되지 않음", "preparing": "준비 중 중단됨", "pending": "다시 시작하면 Windows 설치가 진행됩니다",
            "done": "사용 가능", "failed": "설치 실패 (다시 시도하거나 제거할 수 있습니다)", "removed": "제거됨"}
    st["summary"] = text.get(st["state"], st["state"])
    return st


def cmd_status(a):
    st = status()
    if a.json:
        print(json.dumps(st, ensure_ascii=False, indent=1))
    else:
        print("Windows 게임 지원: %s" % st["summary"])
        if st["state"] == "done":
            print("  Windows 정품 인증: %s" % ("완료" if st["activated"] == "1" else "안 됨 (인터넷 연결 후 자동 인증되거나, Windows 설정에서 제품 키를 입력하세요)"))
            print("  게이밍 정리: %s" % ("적용됨 (되돌리기: Windows의 C:\\ProgramData\\DelayOS\\winsetup\\cleanup-undo.cmd)" if st["cleanup"] == "1" else "적용 안 함"))
        if st["iso_source"] == "local-unverified":
            print("  직접 지정한 Windows ISO를 확인 없이 사용했습니다%s." % (" (%s)" % st["image"] if st["image"] else ""))
        if st["skipped"]:
            print("  Windows 이미지에 없어서 건너뛴 단계: %s" % st["skipped"])
        if st["secure_boot"] is False:
            print("  Secure Boot가 꺼져 있습니다. 발로란트(Vanguard)는 Windows 11에서 Secure Boot가 켜져 있어야 실행됩니다.")
    return 0


def cmd_session_notify(a):
    """Login hook (user): one notification per failed attempt; after a finished installation, one
    explanation of the Secure Boot (MOK) screen that the next restart shows."""
    st = status()
    conf = load_conf()
    if st["state"] == "done" and conf.get("SB") == "1" and conf.get("SB_MOK") == "queued":
        mark = os.path.expanduser("~/.cache/delayos-winsetup-mok-notified")
        stamp = conf.get("FINISHED", "") or conf.get("CREATED", "")
        if read_text(mark).strip() == stamp or sb_enrolled():
            return 0
        try:
            os.makedirs(os.path.dirname(mark), exist_ok=True)
            with open(mark, "w") as f:
                f.write(stamp)
        except OSError:
            pass
        body = ("Windows 게임 지원 준비가 끝났습니다. 시작 메뉴의 Windows 게임과 DelayOS Store에서 사용할 수 있습니다.\n\n"
                "발로란트처럼 Secure Boot가 필요한 게임을 하려면 한 번만 다음을 해 주세요.\n"
                "1. PC를 다시 시작하면 파란 화면(Shim UEFI key management)이 나옵니다. 10초 안에 아무 키나 누르세요.\n"
                "2. Enroll MOK → Continue → Yes → 암호 %s 입력 → Reboot\n"
                "3. 그다음 BIOS(UEFI) 설정에서 Secure Boot를 켜세요.\n\n"
                "파란 화면을 놓쳤으면 터미널에서 sudo delay-winsetup sb-setup 을 실행하고 다시 시작하세요.\n"
                "이 단계를 마치기 전에 Secure Boot를 켜면 DelayOS가 시작되지 않습니다." % MOK_PASSWORD)
        if have("kdialog"):
            subprocess.Popen(["kdialog", "--title", "Windows 게임 지원", "--msgbox", body])
        elif have("notify-send"):
            subprocess.Popen(["notify-send", "-a", "DelayOS", "Windows 게임 지원", body])
        return 0
    if st["state"] != "failed":
        return 0
    mark = os.path.expanduser("~/.cache/delayos-winsetup-notified")
    stamp = conf.get("CREATED", "")
    if read_text(mark).strip() == stamp:
        return 0
    try:
        os.makedirs(os.path.dirname(mark), exist_ok=True)
        with open(mark, "w") as f:
            f.write(stamp)
    except OSError:
        pass
    body = ("Windows 게임 지원 설치가 끝나지 않았습니다. DelayOS는 정상입니다.\n"
            "다시 시도: 터미널에서 sudo delay-winsetup retry\n제거(공간 되돌리기): sudo delay-winsetup remove\n"
            "기록: /var/log/delayos-winsetup.log")
    if have("kdialog"):
        subprocess.Popen(["kdialog", "--title", "Windows 게임 지원", "--sorry", body])
    elif have("notify-send"):
        subprocess.Popen(["notify-send", "-a", "DelayOS", "-u", "critical", "Windows 게임 지원", body])
    return 0


def main(argv):
    global DRY
    ap = argparse.ArgumentParser(prog="delay-winsetup")
    ap.add_argument("--dry-run", action="store_true", help="log what would be done, change nothing")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("probe"); p.add_argument("--write", action="store_true"); p.set_defaults(fn=cmd_probe, need_root=False)
    p = sub.add_parser("parts"); p.add_argument("--root-dev", required=True); p.add_argument("--win-gb", type=int, default=100); p.set_defaults(fn=cmd_parts, need_root=True)
    def image_args(p):
        p.add_argument("--iso", help="Windows ISO file, optical drive (/dev/sr1) or folder with the medium; without it: download from Microsoft")
        p.add_argument("--index", type=int, default=0, help="image number inside install.wim/esd (custom ISO)")
        p.add_argument("--image-name", default="", help="image name inside install.wim/esd (custom ISO)")
        p.add_argument("--cleanup", choices=("auto", "on", "off"), default="auto",
                       help="gaming cleanup: auto = only for an unmodified Microsoft image")
        p.add_argument("--key-file")
    p = sub.add_parser("stage"); p.add_argument("--root", required=True); p.add_argument("--edition", default="home"); image_args(p); p.set_defaults(fn=cmd_stage, need_root=True)
    p = sub.add_parser("finalize"); p.set_defaults(fn=cmd_finalize, need_root=True)
    p = sub.add_parser("retry"); p.add_argument("--edition"); image_args(p); p.set_defaults(fn=cmd_retry, need_root=True)
    p = sub.add_parser("remove"); p.set_defaults(fn=cmd_remove, need_root=True)
    p = sub.add_parser("status"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_status, need_root=False)
    p = sub.add_parser("session-notify"); p.set_defaults(fn=cmd_session_notify, need_root=False)
    p = sub.add_parser("sb-setup"); p.set_defaults(fn=cmd_sb_setup, need_root=True)
    p = sub.add_parser("sb-kernel"); p.set_defaults(fn=cmd_sb_kernel, need_root=True)
    p = sub.add_parser("sb-install"); p.add_argument("--root", required=True); p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_sb_install, need_root=True)
    p = sub.add_parser("iso-url"); p.add_argument("--language", default="Korean"); p.set_defaults(fn=cmd_iso_url, need_root=False)
    a = ap.parse_args(argv)
    DRY = a.dry_run
    if a.need_root and os.geteuid() != 0:
        print(json.dumps({"ok": False, "code": "root", "error": "root 권한이 필요합니다 (sudo delay-winsetup …)."}, ensure_ascii=False))
        return 1
    if not a.need_root:
        LOGS.clear()
    try:
        if a.need_root:
            log("---- %s %s" % (a.cmd, " ".join(x for x in argv if x != a.cmd)))
        return a.fn(a)
    except Fail as e:
        log("FAILED %s: %s %s" % (a.cmd, e.code, e.detail))
        print(json.dumps({"ok": False, "code": e.code, "error": e.message, "detail": e.detail}, ensure_ascii=False))
        return 1
    except Exception as e:  # noqa
        log("FAILED %s: %s: %s" % (a.cmd, type(e).__name__, e))
        print(json.dumps({"ok": False, "code": "internal", "error": MSG["internal"], "detail": "%s: %s" % (type(e).__name__, e)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
