KEY_RE = re.compile(r"^[A-Z0-9]{5}(-[A-Z0-9]{5}){4}$")
SB_DIR = "/usr/share/delayos/secureboot/general"
SHIM_DIR = "/usr/share/shim-signed"
MOK_PASSWORD = "delayos"
