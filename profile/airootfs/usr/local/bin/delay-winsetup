UDEV_RULE = "/etc/udev/rules.d/61-delayos-winsetup-local.rules"
STAGE_GB = 10
MIN_WIN_GB = 64
MIN_ROOT_GB = 20
GIB = 1024 ** 3
MIB = 1024 ** 2
TRIES = "xxxxxx"
GENERIC_KEYS = {"home": "YTMG3-N6DKC-DKB77-7M9GH-8HVX7", "pro": "VK7JG-NPHTM-C97JM-9MPGT-3V66T"}
EDITION_IDS = {"home": "Core", "pro": "Professional"}
KEY_RE = re.compile(r"^[A-Z0-9]{5}(-[A-Z0-9]{5}){4}$")
SB_DIR = "/usr/share/delayos/secureboot/general"
SHIM_DIR = "/usr/share/shim-signed"
MOK_PASSWORD = "delayos"
UA = "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"

