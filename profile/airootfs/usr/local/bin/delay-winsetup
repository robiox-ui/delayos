#!/usr/bin/python3
# DelayOS "Windows 게임 지원": installs a real Windows 11 next to DelayOS on a partition that
# DelayOS never shows, so kernel anti-cheat games run there through "Windows 전환" (delay-winboot).
# Documentation: docs/windows-switch.md. Python 3 stdlib only. Everything that changes the disk
# goes through run(), which only logs when --dry-run is given.
#
#   probe [--write]                 facts for the installer page (JSON; --write also writes
#                                   /run/delayos-winsetup/WinFacts.qml for the Calamares page)
#   parts --root-dev DEV --win-gb N stage 1 (Calamares, after "partition", before "mount"):
#                                   shrink the new, empty DelayOS root from its end and create
#                                   "DelayOS-WinSetup" (FAT32 staging) + "DelayOS-Windows" (NTFS)
#   stage --root DIR [--iso FILE] [--edition home|pro] [--key-file F]
#                                   stage 2 (Calamares, before "umount"; also used by retry):
#                                   get the Windows ISO from Microsoft, fill the staging
#                                   partition, write the unattended files, boot entry + BootNext
#   finalize                        boot service on the installed system: clean up when Windows
#                                   is ready, or mark the attempt as failed
#   retry | remove                  after a failed attempt (root)
#   status [--json]                 state for Settings / the login notification
#   session-notify                  login hook: tell the user about a failed attempt
#   sb-setup | sb-kernel            Secure Boot chain (shim + DelayOS general key), see the doc
#   iso-url                         only resolve the Microsoft download link (test)
#
# Safety rules: only the disk that holds the DelayOS root is touched; only space taken from the
# end of the freshly created (verified empty) root partition is used; later steps find "their"
# partitions by GPT partition GUID + partition name and refuse anything else.
import argparse
import hashlib
import http.cookiejar
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

