os.environ["LC_ALL"] = "C"

CONF = "/etc/delayos/winsetup.conf"
LOG = "/var/log/delayos-winsetup.log"
RUN = "/run/delayos-winsetup"
STATE = RUN + "/state.json"
SHARE = "/usr/share/delayos/winsetup"
