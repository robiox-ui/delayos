#!/usr/bin/env bash
# DelayOS: make the installed graphics drivers match the GPUs in this PC.
# The ISO carries the drivers of every vendor (so the live session works everywhere); an installed
# system only needs its own. Run by delay-postinstall (--install-time), by delay-cpu-opt after the
# CachyOS repos are enabled, and from the Drivers app (delay-sys-helper gpu-setup).
#
#   delay-gpu-setup [--install-time] [--quiet] [--dry-run]
#
#   NVIDIA Turing and newer (GTX 16xx / RTX)   nvidia-open-dkms + nvidia-utils + lib32-nvidia-utils
#   NVIDIA Maxwell / Pascal / Volta            nvidia-580xx-dkms + utils (CachyOS repo or AUR); until that
#                                              is possible: nouveau (the NVIDIA packages are removed,
#                                              because nvidia-utils blacklists nouveau)
#   NVIDIA Kepler and older                    nouveau (the 470xx/390xx drivers cannot do Wayland)
#   no NVIDIA GPU                              the NVIDIA packages are removed (no DKMS build on every
#                                              kernel update, nouveau blacklist gone)
#   AMD                                        mesa + vulkan-radeon (+ lib32)
#   Intel                                      mesa + vulkan-intel (+ lib32) + intel-media-driver
# With the CachyOS repositories enabled, mesa and the NVIDIA packages come from there automatically
# (they are ordered above the Arch repositories).
# Packages are only installed when the sync databases exist and the mirror answers; removing works
# offline. Nothing here fails the installation: the exit code is always 0 with --install-time.
set -u
export LC_ALL=C
INSTALL=0; QUIET=0; DRY=0
for a in "$@"; do case "$a" in --install-time) INSTALL=1 ;; --quiet) QUIET=1 ;; --dry-run) DRY=1 ;; *) echo "usage: delay-gpu-setup [--install-time] [--quiet] [--dry-run]" >&2; exit 2 ;; esac; done
[[ $EUID -eq 0 || $DRY -eq 1 ]] || { echo "root 권한이 필요합니다" >&2; exit 1; }
say() { (( QUIET )) || printf ':: %s\n' "$*"; }
PACMAN=(pacman --noconfirm --noprogressbar --color never)
NV_OPEN_MIN=$((0x1E00))   # Turing: TU1xx device ids start at 0x1e00
NV_580_MIN=$((0x1300))    # Maxwell (GM10x) and newer up to Volta

has_amd=0; has_intel=0; nv_open=0; nv_580=0; nv_old=0
while read -r line; do
  [[ $line =~ \[03[0-9a-f]{2}\]:.*\[([0-9a-f]{4}):([0-9a-f]{4})\] ]] || continue
  ven=${BASH_REMATCH[1]}; dev=$((16#${BASH_REMATCH[2]}))
  case "$ven" in
    1002) has_amd=1 ;;
    8086) has_intel=1 ;;
    10de) if (( dev >= NV_OPEN_MIN )); then nv_open=1; elif (( dev >= NV_580_MIN )); then nv_580=1; else nv_old=1; fi ;;
  esac
done < <(lspci -nn 2>/dev/null)

# exact name only: pacman -Q also answers for a "provides" (nvidia-open-dkms provides nvidia-open)
installed() { pacman -Qq "$1" 2>/dev/null | grep -qxF "$1"; }
can_install() { # sync databases present, package known, mirror reachable
  [[ -n $(ls -A /var/lib/pacman/sync 2>/dev/null) ]] || return 1
  pacman -Si "$1" >/dev/null 2>&1 || return 1
  curl -fsI --connect-timeout 5 --max-time 10 -o /dev/null https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db 2>/dev/null
}
run() { if (( DRY )); then echo "would run: $*"; else "$@"; fi; }
want() { # install the missing ones of "$@" when that is possible right now
  local miss=() p
  for p in "$@"; do installed "$p" || miss+=("$p"); done
  (( ${#miss[@]} )) || return 0
  if can_install "${miss[0]}"; then say "설치: ${miss[*]}"; run "${PACMAN[@]}" -S --needed "${miss[@]}"
  else say "나중에 설치 필요 (드라이버 앱): ${miss[*]}"; fi
}
drop_nvidia() {
  local rm=() p
  for p in nvidia-settings nvidia-prime lib32-nvidia-utils nvidia-open-dkms nvidia-open nvidia-utils; do installed "$p" && rm+=("$p"); done
  (( ${#rm[@]} )) || return 0
  say "$1: ${rm[*]} 제거"
  run "${PACMAN[@]}" -Rns "${rm[@]}" || run "${PACMAN[@]}" -Rdd "${rm[@]}"
}

(( has_amd ))   && want mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
(( has_intel )) && want mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver

if (( nv_open )); then
  say "NVIDIA (Turing 이상): 오픈 커널 모듈 드라이버"
  want nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings
  (( DRY )) || systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service >/dev/null 2>&1
elif (( nv_580 )); then
  if installed nvidia-580xx-dkms; then
    say "NVIDIA 580xx 레거시 드라이버 사용 중"
  elif can_install nvidia-580xx-dkms; then
    say "NVIDIA (Maxwell/Pascal/Volta): 580xx 레거시 드라이버로 교체"
    drop_nvidia "최신 드라이버는 이 GPU를 지원하지 않음"
    run "${PACMAN[@]}" -S --needed nvidia-580xx-dkms nvidia-580xx-utils lib32-nvidia-580xx-utils ||
      say "580xx 드라이버 설치 실패: 오픈소스 nouveau 드라이버로 동작합니다"
  else
    drop_nvidia "이 GPU는 580xx 레거시 드라이버가 필요함 (CPU 최적화 저장소를 켜면 드라이버 앱에서 설치 가능). 그때까지 nouveau 사용"
  fi
elif (( nv_old )); then
  drop_nvidia "오래된 NVIDIA GPU: 오픈소스 nouveau 드라이버 사용"
  want vulkan-nouveau
else
  drop_nvidia "NVIDIA GPU 없음"
fi
exit 0
