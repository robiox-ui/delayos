---
# TEMUOS installer branding (ui-spec §11). Card 1035×714, stepper on top, buttons bottom-right.
componentName: temuos

welcomeStyleCalamares: false
welcomeExpandingLogo: false

windowExpanding: noexpand
windowSize: 1035px,714px
windowPlacement: center

# Stepper on top (calamares-sidebar.qml), button row at the bottom (calamares-navigation.qml)
sidebar: qml,top
navigation: qml,bottom

strings:
    productName:         TEMUOS
    shortProductName:    TEMUOS
    version:             rolling
    shortVersion:        rolling
    versionedName:       TEMUOS
    shortVersionedName:  TEMUOS
    bootloaderEntryName: TEMUOS
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""
    donateUrl:           ""

images:
    productLogo:         "/usr/share/temuos/logo/temuos.svg"
    productIcon:         "/usr/share/temuos/logo/temuos.svg"
    productWelcome:      "/usr/share/temuos/logo/temuos.svg"

style:
    SidebarBackground:        "#0E0F13"
    SidebarText:              "#9AA0AA"
    SidebarTextCurrent:       "#FFFFFF"
    SidebarBackgroundCurrent: "#D4194F"

slideshow: "show.qml"
slideshowAPI: 2

uploadServer:
    type: "none"
    url: ""
    sizeLimit: -1
