[Unit]
Description=TEMUOS anti-cheat mode: cache root-only boot facts (TPM event log, ESP) for temu-eac status
ConditionPathExists=/sys/firmware/efi
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/temu-eac facts
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
