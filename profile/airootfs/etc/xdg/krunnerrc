[General]
FreeFloating=true
ActivityAware=true
historyBehavior=CompletionSuggestion

[Plugins]
# Quick answers: maths, units, currency, web; ">cmd" runs in a terminal
calculatorEnabled=true
unitconverterEnabled=true
webshortcutsEnabled=true
shellEnabled=true
# file-content indexing is off (baloofilerc), so this runner only failed a D-Bus call on every keystroke
baloosearchEnabled=false
# Kate/Konsole sessions and KDE help: hidden behind the DelayOS apps, never useful in Start / the command bar
krunner_katesessionsEnabled=false
krunner_konsoleprofilesEnabled=false
helprunnerEnabled=false
krunner_appstreamEnabled=false
krunner_spellcheckEnabled=false
browserhistoryEnabled=false
browsertabsEnabled=false

[Runners][webshortcuts]
DefaultWebShortcut=duckduckgo
