[Compositing]
Backend=OpenGL
GLCore=true
LatencyPolicy=Low
# Let fullscreen games bypass the compositor (= no extra input lag, more FPS)
AllowTearing=true
WindowsBlockCompositing=true

[Plugins]
# "Glass" look
blurEnabled=true
contrastEnabled=true
backgroundcontrastEnabled=true
# Genie minimise into the dock
magiclampEnabled=true
squashEnabled=false
# Smooth desktop switching + Task View
slideEnabled=true
overviewEnabled=true
# snapping / maximising / dock<->taskbar switch are instant (ui-spec 0.4)
maximizeEnabled=false
# Rounded window corners (from kwin-effect-rounded-corners, optional AUR)
kwin4_effect_shapecornersEnabled=true
wobblywindowsEnabled=false
# Light/dark that follows the time of day
nightlightEnabled=false

[Effect-blur]
# glass: ~30-40 px blur behind the top bar, dock and popups, no grain
BlurStrength=10
NoiseStrength=0

[Effect-magiclamp]
# genie minimise into the dock icon, 400-450 ms
AnimationDuration=420

[Effect-slide]
# desktop switch: horizontal slide, 300 ms; top bar and dock stay put
Duration=300
HorizontalGap=0
VerticalGap=0
SlideBackground=false

[Effect-overview]
BorderActivate=9
TouchBorderActivate=9

[Round-Corners]
# 12 px window corners (kwin-effect-rounded-corners); shadows come from the DelayOS decoration
Size=12
InactiveCornerRadius=12
UseNativeDecorationShadows=true
ActiveOutlineAlpha=0
InactiveOutlineAlpha=0
OutlineThickness=0
InactiveOutlineThickness=0
DisableRoundMaximize=true
DisableRoundFullScreen=true
DisableRoundTile=false
UseSquircleShape=false

[Desktops]
# 4 desktops (Control Center 데스크톱 tiles 1-4, Task View)
Number=4
Rows=1
Name_1=데스크톱 1
Name_2=데스크톱 2
Name_3=데스크톱 3
Name_4=데스크톱 4

[Windows]
# Windows-style behaviour
FocusPolicy=ClickToFocus
ElectricBorderMaximize=true
ElectricBorderTiling=true
BorderlessMaximizedWindows=false
Placement=Centered

[org.kde.kdecoration2]
# DelayOS Aurorae frame (ui-spec 9.1): 28 px title bar in the body colour, grouped - [] x pill
library=org.kde.kwin.aurorae
theme=__aurorae__svg__DelayOS
# Windows-style buttons on the right
ButtonsOnLeft=M
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[TabBox]
LayoutName=thumbnail_grid
HighlightWindows=false

[Xwayland]
Scale=1

[Wayland]
InputMethod[$e]=/usr/share/applications/org.fcitx.Fcitx5.desktop
