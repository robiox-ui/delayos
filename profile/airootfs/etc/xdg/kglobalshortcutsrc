# Windows-style keyboard shortcuts (as shown in the videos)

[org.kde.krunner.desktop]
# Meta+Space belongs to the TEMUOS command bar (org.temuos.commandbar)
_launch=Alt+F2,Alt+Space\tAlt+F2\tSearch,KRunner

[plasmashell]
# Win+V = clipboard history
clipboard_action=none,Meta+Ctrl+X,Automatic Action Popup Menu
show-on-mouse-pos=none,Meta+V,Show Clipboard Items at Mouse Position
# Win+1..9 = dock apps by position: handled by /usr/share/applications/temu-dock-entry-N.desktop
activate task manager entry 1=none,Meta+1,Activate Task Manager Entry 1
activate task manager entry 2=none,Meta+2,Activate Task Manager Entry 2
activate task manager entry 3=none,Meta+3,Activate Task Manager Entry 3
activate task manager entry 4=none,Meta+4,Activate Task Manager Entry 4
activate task manager entry 5=none,Meta+5,Activate Task Manager Entry 5
activate task manager entry 6=none,Meta+6,Activate Task Manager Entry 6
activate task manager entry 7=none,Meta+7,Activate Task Manager Entry 7
activate task manager entry 8=none,Meta+8,Activate Task Manager Entry 8
activate task manager entry 9=none,Meta+9,Activate Task Manager Entry 9
# Meta+A belongs to the TEMUOS Control Center (org.temuos.controlcenter)
show system tray=none,none,Show System Tray

[org.kde.spectacle.desktop]
# Win+Shift+S = Snip
RectangularRegionScreenShot=Meta+Shift+S\tMeta+Shift+Print,Meta+Shift+Print,Capture Rectangular Region
_launch=Print,Print,Spectacle

[org.kde.plasma.emojier.desktop]
# Win+. = emoji
_launch=Meta+Ctrl+Alt+Shift+Space,Meta+.\tMeta+Ctrl+Alt+Shift+Space,Emoji Selector

[org.kde.plasma-systemmonitor.desktop]
# Ctrl+Shift+Esc = Task Manager
_launch=Ctrl+Shift+Esc,Ctrl+Esc,System Monitor

[org.kde.dolphin.desktop]
# Win+E = Files
_launch=Meta+E,Meta+E,Dolphin

[systemsettings.desktop]
# Win+I = Settings
_launch=Meta+I,Tools,System Settings

[temu-winx.desktop]
# Meta+X belongs to org.temuos.winx
_launch=none,none,Quick tools

[temu-gamemode-toggle.desktop]
# Win+G = Gaming mode on/off
_launch=Meta+G,none,Gaming mode

[kwin]
# Win+Tab = Task View
Overview=Meta+Tab\tMeta+W,Meta+W,Toggle Overview
Window Close=Alt+F4,Alt+F4,Close Window
Window Maximize=Meta+Up,Meta+PgUp,Maximize Window
Window Minimize=Meta+Down,Meta+PgDown,Minimize Window
Window Quick Tile Left=Meta+Left,Meta+Left,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Right,Meta+Right,Quick Tile Window to the Right
Window Fullscreen=F11,none,Make Window Fullscreen
Window Above Other Windows=Meta+Ctrl+T,none,Keep Window Above Others
Show Desktop=Meta+D,Meta+D,Peek at Desktop
Switch to Next Desktop=Meta+Ctrl+Right,none,Switch to Next Desktop
Switch to Previous Desktop=Meta+Ctrl+Left,none,Switch to Previous Desktop

[ksmserver]
Lock Session=Meta+L\tScreensaver,Meta+L\tScreensaver,Lock Session

[temu-dock-entry-1.desktop]
_launch=Meta+1,none,Dock app 1

[temu-dock-entry-2.desktop]
_launch=Meta+2,none,Dock app 2

[temu-dock-entry-3.desktop]
_launch=Meta+3,none,Dock app 3

[temu-dock-entry-4.desktop]
_launch=Meta+4,none,Dock app 4

[temu-dock-entry-5.desktop]
_launch=Meta+5,none,Dock app 5

[temu-dock-entry-6.desktop]
_launch=Meta+6,none,Dock app 6

[temu-dock-entry-7.desktop]
_launch=Meta+7,none,Dock app 7

[temu-dock-entry-8.desktop]
_launch=Meta+8,none,Dock app 8

[temu-dock-entry-9.desktop]
_launch=Meta+9,none,Dock app 9
