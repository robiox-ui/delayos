[Desktop Entry]
Type=Application
Name=Steam compatibility tool default
Name[ko]=Steam 호환 도구 기본값
Comment[ko]=설치된 Proton(CachyOS/GE)을 Steam Play 기본 도구로 지정합니다
# nothing to choose from while no Proton build is installed (system-wide or by ProtonUp-Qt): skip the
# Python start (15 ms at every login) until a compatibilitytools.d folder exists
Exec=sh -c '[ -d /usr/share/steam/compatibilitytools.d ] || [ -d ~/.local/share/Steam/compatibilitytools.d ] || exit 0; exec /usr/bin/delay-steam-compat'
NoDisplay=true
X-KDE-autostart-phase=2
X-KDE-StartupNotify=false
