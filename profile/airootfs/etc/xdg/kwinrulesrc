# KWin window rules shipped by TEMUOS (users' own rules in ~/.config/kwinrulesrc are merged on top)
[General]
count=1
rules=temuos-installer

# Calamares installer (ui-spec 11.1): a centred card without a title bar; never minimised behind the wallpaper
[temuos-installer]
Description=TEMUOS 설치 프로그램
wmclass=calamares
wmclasscomplete=false
wmclassmatch=2
noborder=true
noborderrule=2
placement=5
placementrule=2
minimize=false
minimizerule=2
maximizehoriz=false
maximizehorizrule=3
maximizevert=false
maximizevertrule=3
