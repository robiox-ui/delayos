[Unit]
Description=DelayOS 복구 (recovery menu on tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-vconsole-setup.service
Conflicts=getty@tty1.service
Before=getty.target

[Service]
ExecStart=/usr/local/bin/delay-recovery-session
Restart=always
RestartSec=1
# the menu owns the first console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
KillMode=control-group
IgnoreSIGPIPE=no

[Install]
WantedBy=multi-user.target
